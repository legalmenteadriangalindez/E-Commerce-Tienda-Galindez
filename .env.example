# Entorno local. No subas el archivo .env real a GitHub.
NODE_ENV=development
PORT=3000
BASE_URL=http://localhost:3000

# MongoDB Atlas de desarrollo. Reemplaza usuario, clave y cluster; usa una
# base separada de producción. En Atlas, permite la IP desde la que desarrollas.
MONGO_URI=mongodb+srv://USUARIO:CLAVE@TU-CLUSTER.mongodb.net/tienda_galindez_dev?retryWrites=true&w=majority

# Cambia este valor en tu .env local. En Render utiliza un secreto distinto.
SESSION_SECRET=local-only-change-this-session-secret-before-deploying-123456789

# Diagnóstico temporal de CSRF. Solo registra metadatos (nunca tokens ni cookies).
# Déjalo en false cuando termines de investigar un incidente.
CSRF_DEBUG_LOGS=false

# Wompi sandbox: completa estas claves solo si vas a probar pagos.
PAYMENTS_ENABLED=false
WOMPI_ENV=sandbox
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_INTEGRITY_KEY=
WOMPI_EVENTS_KEY=

# Correo opcional en local. Sin estas claves, el código de verificación
# y las notificaciones de pedidos se imprimen en la terminal de desarrollo.
BREVO_API_KEY=
EMAIL_USER=
EMAIL_SUBJECT=Código de verificación - Tienda Galindez

# Opcional: npm run seed:local crea un administrador local si completas ambos.
LOCAL_ADMIN_EMAIL=
LOCAL_ADMIN_PASSWORD=

# Importes de envío en COP. Los precios del catálogo incluyen impuestos.
SHIPPING_PRICE=5000
FREE_SHIPPING_FROM=30000

# Máximo de filas del CSV de ventas por descarga. Aumenta solo si el servicio
# tiene memoria suficiente y prefieres exportar periodos muy grandes.
CSV_EXPORT_MAX_ROWS=100000

# Datos que aparecen en las páginas públicas de privacidad, compra, envíos y atención.
# Revísalos con los datos reales del negocio antes de publicar.
LEGAL_BUSINESS_NAME=Tienda Galindez
LEGAL_CONTACT_EMAIL=tiendagalindez@gmail.com
LEGAL_CONTACT_PHONE=+57 301 208 4769
LEGAL_CITY=Timbío, Cauca, Colombia
LEGAL_LAST_UPDATED=27 de octubre de 2026
