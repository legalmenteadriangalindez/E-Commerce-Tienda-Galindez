{
    "name": "tienda-galindez",
    "version": "1.0.0",
    "description": "crud application with express and mongodb",
    "main": "server.js",
    "scripts": {
        "start": "node server.js",
        "dev": "nodemon server.js",
        "check": "node scripts/check-routes.js",
        "lint": "eslint server.js eslint.config.js api server scripts tests migrations assets/js public/js",
        "format": "node scripts/format-files.js",
        "format:check": "node scripts/format-files.js --check",
        "test": "npm run check && node --test tests/*.test.js",
        "test:integration": "node scripts/run-integration-tests.js",
        "check:production": "node scripts/check-production.js",
        "migrate": "node scripts/run-migrations.js",
        "migrate:status": "node scripts/run-migrations.js --status",
        "migrate:dry-run": "node scripts/run-migrations.js --dry-run",
        "maintenance": "node scripts/run-maintenance.js",
        "brevo:smoke": "node scripts/brevo-smoke-test.js",
        "payments:reconcile": "node scripts/reconcile-payments.js",
        "audit:data": "node scripts/audit-data.js",
        "explain:queries": "node scripts/explain-queries.js",
        "migrate:money": "node scripts/migrate-money-to-cents.js",
        "seed:admin": "node scripts/seed-admin.js",
        "promote:superadmin": "node scripts/promote-superadmin.js",
        "seed:local": "node scripts/seed-local.js"
    },
    "keywords": [
        "crud",
        "mongodb"
    ],
    "author": "akshay kashyap",
    "license": "ISC",
    "engines": {
        "node": "22.x || 24.x"
    },
    "dependencies": {
        "@getbrevo/brevo": "^6.2.0",
        "axios": "^1.20.0",
        "bcrypt": "^6.0.0",
        "connect-mongo": "^5.1.0",
        "dotenv": "^8.6.0",
        "ejs": "^3.1.9",
        "express": "^4.22.3",
        "express-session": "^1.19.0",
        "form-data": "^4.0.5",
        "helmet": "^8.1.0",
        "method-override": "^3.0.0",
        "mongoose": "^9.11.4",
        "morgan": "^1.12.1",
        "multer": "^2.5.0",
        "pdfkit": "^0.20.2",
        "sharp": "^0.35.5",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "eslint": "^10.13.0",
        "globals": "^16.5.0",
        "nodemon": "^3.1.14",
        "prettier": "^3.9.10"
    }
}
