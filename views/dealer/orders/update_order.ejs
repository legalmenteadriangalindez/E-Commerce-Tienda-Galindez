<%- include('../../include/_headerDealer') %>

<link rel="stylesheet" href="/css/dealer_update_orders.css">

<div class="page-wrapper">

    <div class="page-header">
        <h1>Actualizar Orden</h1>
        <p>Visualiza la información de la orden y actualiza su estado</p>
    </div>

    <div class="form-card">

        <form action="/dealer/orders/update/<%= order._id %>" method="POST">

            <!-- INFORMACIÓN GENERAL -->
            <div class="form-section">

                <h3>Información General</h3>

                <div class="form-group">
                    <label>Número de Orden</label>
                    <input 
                        type="text" 
                        value="<%= order.numeroOrden %>" 
                        disabled
                    >
                </div>

                <div class="form-group">
                    <label>Fecha</label>
                    <input 
                        type="text" 
                        value="<%= new Date(order.createdAt).toLocaleString() %>" 
                        disabled
                    >
                </div>

            </div>

            <!-- DATOS DEL CLIENTE -->
            <div class="form-section">

                <h3>Datos del Cliente</h3>

                <div class="form-group">
                    <label>Nombre</label>
                    <input 
                        type="text" 
                        value="<%= order.cliente.nombre %>" 
                        disabled
                    >
                </div>

                <div class="form-group">
                    <label>Email</label>
                    <input 
                        type="email" 
                        value="<%= order.cliente.email %>" 
                        disabled
                    >
                </div>

                <div class="form-group">
                    <label>Teléfono</label>
                    <input 
                        type="text" 
                        value="<%= order.cliente.telefono %>" 
                        disabled
                    >
                </div>

            </div>

            <!-- DIRECCIÓN -->
            <div class="form-section">

                <h3>Dirección de Envío</h3>

                <div class="form-group">
                    <label>Departamento</label>
                    <input 
                        type="text" 
                        value="<%= order.direccionEnvio.departamento %>" 
                        disabled
                    >
                </div>

                <div class="form-group">
                    <label>Ciudad</label>
                    <input 
                        type="text" 
                        value="<%= order.direccionEnvio.ciudad %>" 
                        disabled
                    >
                </div>

                <div class="form-group">
                    <label>Dirección</label>
                    <input 
                        type="text" 
                        value="<%= order.direccionEnvio.direccion %>" 
                        disabled
                    >
                </div>

                <div class="form-group">
                    <label>Referencia</label>
                    <input 
                        type="text" 
                        value="<%= order.direccionEnvio.referencia %>" 
                        disabled
                    >
                </div>

            </div>

<!-- PRODUCTOS -->
<div class="form-section">

    <h3>Productos</h3>

    <div class="table-responsive">

        <table class="table-orders">

            <thead>

                <tr>
                    <th>Producto</th>
                    <th>Cantidad</th>
                    <th>Precio</th>
                    <th>Subtotal</th>
                </tr>

            </thead>

            <tbody>

                <% order.productos.forEach(producto => { %>

                    <tr>

                        <td data-label="Producto">
                            <%= producto.nombre %>
                        </td>

                        <td data-label="Cantidad">
                            <%= producto.cantidad %>
                        </td>

                        <td data-label="Precio">
                            $ <%= producto.precioUnitario %>
                        </td>

                        <td data-label="Subtotal">
                            $ <%= producto.subtotal %>
                        </td>

                    </tr>

                <% }) %>

            </tbody>

        </table>

    </div>

</div>

            <!-- TOTALES -->
            <div class="form-section">

                <h3>Totales</h3>

                <div class="form-group">
                    <label>Subtotal</label>
                    <input 
                        type="text" 
                        value="$ <%= order.subtotal %>" 
                        disabled
                    >
                </div>

                <div class="form-group">
                    <label>Impuestos</label>
                    <input 
                        type="text" 
                        value="$ <%= order.impuestos %>" 
                        disabled
                    >
                </div>

                <div class="form-group">
                    <label>Costo Envío</label>
                    <input 
                        type="text" 
                        value="$ <%= order.costoEnvio %>" 
                        disabled
                    >
                </div>

                <div class="form-group">
                    <label>Total</label>
                    <input 
                        type="text" 
                        value="$ <%= order.total %>" 
                        disabled
                    >
                </div>

            </div>

            <!-- ESTADO -->
            <div class="form-section">

                <h3>Estado de la Orden</h3>

                <div class="form-group">

                    <label>Estado</label>

                    <select name="estado" required>

                        <option 
                            value="PENDIENTE"
                            <%= order.estado === 'PENDIENTE' ? 'selected' : '' %>>
                            PENDIENTE
                        </option>

                        <option 
                            value="PAGADA"
                            <%= order.estado === 'PAGADA' ? 'selected' : '' %>>
                            PAGADA
                        </option>

                        <option 
                            value="PREPARANDO"
                            <%= order.estado === 'PREPARANDO' ? 'selected' : '' %>>
                            PREPARANDO
                        </option>

                        <option 
                            value="ENVIADA"
                            <%= order.estado === 'ENVIADA' ? 'selected' : '' %>>
                            ENVIADA
                        </option>

                        <option 
                            value="ENTREGADA"
                            <%= order.estado === 'ENTREGADA' ? 'selected' : '' %>>
                            ENTREGADA
                        </option>

                        <option 
                            value="CANCELADA"
                            <%= order.estado === 'CANCELADA' ? 'selected' : '' %>>
                            CANCELADA
                        </option>

                    </select>

                </div>

            </div>

            <!-- BOTÓN -->
            <div class="form-actions">
                <button type="submit">
                    Actualizar Estado
                </button>
            </div>

        </form>

    </div>

</div>

<%- include('../../include/_footerAdmin') %>
