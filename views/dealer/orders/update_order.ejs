<%- include('../../include/_headerDealer') %>


<div class="page-wrapper">

    <div class="page-header">
        <h1>Actualizar Orden</h1>
        <p>Visualiza la información de la orden y actualiza su estado</p>
    </div>

    <div class="form-card ui-card">

        <form action="/dealer/orders/update/<%= order._id %>" method="POST">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">

            <!-- INFORMACIÓN GENERAL -->
            <div class="form-section">

                <h3>Información General</h3>

                <div class="form-group">
                    <label>Número de Orden</label>
                    <input
                        type="text"
                        value="<%= order.numeroOrden %>"
                        disabled
                    >
                </div>

                <div class="form-group">
                    <label>Fecha</label>
                    <input
                        type="text"
                        value="<%= new Date(order.createdAt).toLocaleString() %>"
                        disabled
                    >
                </div>

            </div>

            <div class="form-section delivery-assigned-summary">
                <h3>Asignación</h3>
                <p>Este pedido está asignado a tu cuenta como repartidor.</p>
                <p>
                    <strong>Medio de pago:</strong>
                    <% if (order.metodoPago === 'CASH_ON_DELIVERY') { %>
                        Efectivo contra entrega · cobra al entregar y confirma el pago.
                    <% } else if (order.metodoPago === 'WOMPI_NEQUI') { %>
                        Nequi con Wompi · pago confirmado antes del despacho.
                    <% } else { %>
                        Tarjeta con Wompi · pago confirmado antes del despacho.
                    <% } %>
                </p>
                <% if (order.asignacionReparto?.asignadoEn) { %>
                    <small>Asignado el <%= new Date(order.asignacionReparto.asignadoEn).toLocaleString('es-CO') %></small>
                <% } %>
            </div>

            <!-- DATOS DEL CLIENTE -->
            <div class="form-section">

                <h3>Datos del Cliente</h3>

                <div class="form-group">
                    <label>Nombre</label>
                    <input
                        type="text"
                        value="<%= order.cliente.nombre %>"
                        disabled
                    >
                </div>

                <div class="form-group">
                    <label>Email</label>
                    <input
                        type="email"
                        value="<%= order.cliente.email %>"
                        disabled
                    >
                </div>

                <div class="form-group">
                    <label>Teléfono</label>
                    <input
                        type="text"
                        value="<%= order.cliente.telefono %>"
                        disabled
                    >
                </div>

            </div>

            <!-- DIRECCIÓN -->
            <div class="form-section">

                <h3>Dirección de Envío</h3>

                <div class="form-group">
                    <label>Departamento</label>
                    <input
                        type="text"
                        value="<%= order.direccionEnvio.departamento %>"
                        disabled
                    >
                </div>

                <div class="form-group">
                    <label>Ciudad</label>
                    <input
                        type="text"
                        value="<%= order.direccionEnvio.ciudad %>"
                        disabled
                    >
                </div>

                <div class="form-group">
                    <label>Dirección</label>
                    <input
                        type="text"
                        value="<%= order.direccionEnvio.direccion %>"
                        disabled
                    >
                </div>

                <div class="form-group">
                    <label>Referencia</label>
                    <input
                        type="text"
                        value="<%= order.direccionEnvio.referencia %>"
                        disabled
                    >
                </div>

            </div>

<!-- PRODUCTOS -->
<div class="form-section">

    <h3>Productos</h3>

    <div class="table-responsive">

        <table class="table-orders">

            <thead>

                <tr>
                    <th>Producto</th>
                    <th>Cantidad</th>
                    <th>Precio</th>
                    <th>Subtotal</th>
                </tr>

            </thead>

            <tbody>

                <% order.productos.forEach(producto => { %>

                    <tr>

                        <td data-label="Producto">
                            <%= producto.nombre %>
                        </td>

                        <td data-label="Cantidad">
                            <%= producto.cantidad %>
                        </td>

                        <td data-label="Precio">
                            $ <%= producto.precioUnitario %>
                        </td>

                        <td data-label="Subtotal">
                            $ <%= producto.subtotal %>
                        </td>

                    </tr>

                <% }) %>

            </tbody>

        </table>

    </div>

</div>

            <!-- TOTALES -->
            <div class="form-section">

                <h3>Totales</h3>

                <div class="form-group">
                    <label>Subtotal</label>
                    <input
                        type="text"
                        value="$ <%= order.subtotal %>"
                        disabled
                    >
                </div>

                <div class="form-group">
                    <label>Impuestos</label>
                    <input
                        type="text"
                        value="$ <%= order.impuestos %>"
                        disabled
                    >
                </div>

                <div class="form-group">
                    <label>Costo Envío</label>
                    <input
                        type="text"
                        value="$ <%= order.costoEnvio %>"
                        disabled
                    >
                </div>

                <div class="form-group">
                    <label>Total</label>
                    <input
                        type="text"
                        value="$ <%= order.total %>"
                        disabled
                    >
                </div>

            </div>

            <!-- ESTADO -->
            <div class="form-section">

                <h3>Estado de la Orden</h3>

                <div class="form-group">

                    <label>Estado</label>

                    <select name="estado" required>
                        <option value="<%= order.estado %>" selected>Estado actual: <%= statusLabels[order.estado] || order.estado %></option>
                        <% if (order.metodoPago === 'CASH_ON_DELIVERY' && order.estado === 'PENDIENTE') { %>
                            <option value="PREPARANDO">Marcar como en preparación</option>
                        <% } %>
                        <% if (order.estado === 'PAGADA') { %>
                            <option value="PREPARANDO">Marcar como en preparación</option>
                        <% } %>
                        <% if (order.estado === 'PREPARANDO') { %>
                            <option value="ENVIADA">Marcar como enviado</option>
                        <% } %>
                        <% if (order.estado === 'ENVIADA') { %>
                            <option value="ENTREGADA">Confirmar entrega</option>
                        <% } %>
                    </select>

                    <% if (order.metodoPago === 'CASH_ON_DELIVERY' && order.estado === 'ENVIADA') { %>
                        <label class="delivery-cash-confirmation">
                            <input type="checkbox" name="confirmarPago" value="si" required>
                            Confirmo que recibí el efectivo completo antes de marcar el pedido como entregado.
                        </label>
                    <% } %>

                    <label for="delivery-note">Nota de seguimiento (visible para el cliente, opcional)</label>
                    <textarea id="delivery-note" name="nota" maxlength="300" rows="3" placeholder="Ejemplo: se dejó en portería o se coordinó la entrega."></textarea>

                </div>

            </div>

            <!-- BOTÓN -->
            <div class="form-actions">
                <button type="submit">
                    Actualizar Estado
                </button>
            </div>

        </form>

    </div>

</div>

<%- include('../../include/_deliveryTimeline', { order, visibleOnly: true, showActor: false }) %>

<%- include('../../include/_footerAdmin') %>
