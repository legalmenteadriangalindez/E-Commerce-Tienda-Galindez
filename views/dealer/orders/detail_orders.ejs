<%- include('../../include/_headerDealer') %>

<%
    const dealerBackUrl = typeof backUrl === 'string' ? backUrl : '/dealer/orders/read';
%>

<main class="detail-order-container">
    <div class="title-container dealer-detail-heading">
        <div>
            <p class="dealer-eyebrow">Operación de entregas</p>
            <h1>Detalle de Orden</h1>
        </div>
        <a class="btn btn-outline-secondary" href="<%= dealerBackUrl %>">
            <i class="bi bi-arrow-left" aria-hidden="true"></i> Volver a la lista
        </a>
    </div>

    <%- include('../../include/orders/delivery-status', { order, isDealer: true }) %>
    <%- include('../../include/orders/order-summary', { order }) %>
    <%- include('../../include/orders/payment-status', { order, isDealer: true }) %>
    <%- include('../../include/orders/customer-info', { order }) %>

    <%- include('../../include/orders/order-products', { order, isDealer: true }) %>
    <%- include('../../include/orders/financial-summary', { order }) %>
</main>

<%- include('../../include/_deliveryTimeline', { order, visibleOnly: true, showActor: false }) %>

<%- include('../../include/_footerDealer') %>
