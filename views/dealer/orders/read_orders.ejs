<%- include('../../include/_headerDealer') %>

<link rel="stylesheet" href="/assets/css/dealer_read_orders.css">

<main class="container-fluid py-3 dealer-orders-page">
    <header class="dealer-orders-heading">
        <div>
            <p class="dealer-eyebrow">Distribución</p>
            <h1 class="title-orders">Mis entregas</h1>
            <p class="dealer-description">Solo aparecen los pedidos que la tienda te asignó.</p>
        </div>
        <span class="dealer-orders-count"><%= pagination.totalItems %> pedido(s)</span>
    </header>

    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle orders-table">
            <thead class="table-dark">
                <tr>
                    <th>Orden</th>
                    <th>Cliente</th>
                    <th>Destino</th>
                    <th>Total</th>
                    <th>Pago</th>
                    <th>Estado</th>
                    <th>Fecha</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                <% orders.forEach(order => { %>
                    <tr>
                        <td data-label="Orden"><strong><%= order.numeroOrden %></strong></td>
                        <td data-label="Cliente">
                            <%= order.cliente?.nombre || order.usuario?.nombre || 'Sin usuario' %><br>
                            <small><%= order.cliente?.telefono || order.usuario?.telefono || '' %></small>
                        </td>
                        <td data-label="Destino">
                            <%= order.direccionEnvio?.direccion || 'Sin dirección' %><br>
                            <small><%= order.direccionEnvio?.ciudad || '' %></small>
                        </td>
                        <td data-label="Total">$ <%= Number(order.total || 0).toLocaleString('es-CO') %></td>
                        <td data-label="Pago">
                            <%= order.metodoPago === 'CASH_ON_DELIVERY'
                                ? 'Contra entrega'
                                : order.metodoPago === 'WOMPI_NEQUI'
                                    ? 'Nequi · Wompi'
                                    : 'Tarjeta · Wompi' %>
                        </td>
                        <td data-label="Estado">
                            <span class="dealer-status dealer-status--<%= order.estado.toLowerCase() %>">
                                <%= statusLabels[order.estado] || order.estado %>
                            </span>
                        </td>
                        <td data-label="Fecha"><%= new Date(order.createdAt).toLocaleDateString('es-CO') %></td>
                        <td data-label="Acciones" class="dealer-actions">
                            <a href="/dealer/orders/update/<%= order._id %>" class="btn btn-success btn-sm">Actualizar</a>
                            <a href="/dealer/orders/detail/<%= order._id %>" class="btn btn-info btn-sm">Seguimiento</a>
                        </td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    </div>

    <% if (!orders.length) { %>
        <p class="admin-list-empty">Todavía no tienes pedidos asignados.</p>
    <% } %>
    <%- include('../../include/_adminPagination', { pagination, label: 'entregas' }) %>
</main>

<%- include('../../include/_footerAdmin') %>
