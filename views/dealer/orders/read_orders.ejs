<!-- include header -->
<%- include('../../include/_headerDealer') %>
<!-- /include header -->

<link rel="stylesheet" href="/css/dealer_read_orders.css">

<main class="container-fluid py-3">

    <div class="mb-3">
        <h1 class="title-orders">Gestionar Órdenes</h1>
    </div>

    <div class="table-responsive">

        <table class="table table-striped table-hover align-middle orders-table">

            <thead class="table-dark">

                <tr>

                    <th hidden>#</th>
                    <th>Orden</th>
                    <th>Usuario</th>
                    <th>Total</th>
                    <th>Estado</th>
                    <th>Fecha</th>
                    <th>Editar</th>
                    <th hidden>Eliminar</th>
                    <th>Detalle</th>

                </tr>

            </thead>

            <tbody>

                <% orders.forEach(function(order) { %>

                <tr>

                    <th hidden>
                        <%= order._id %>
                    </th>

                    <td data-label="Orden">
                        <%= order.numeroOrden %>
                    </td>

                    <td data-label="Usuario">
                        <%= order.usuario?.nombre || 'Sin usuario' %>
                    </td>

                    <td data-label="Total">
                        $ <%= order.total?.toLocaleString() %>
                    </td>

                    <td data-label="Estado">

                        <% if(order.estado === 'PENDIENTE') { %>
                            <span class="badge bg-warning text-dark">
                                <%= order.estado %>
                            </span>
                        <% } %>

                        <% if(order.estado === 'PAGADA') { %>
                            <span class="badge bg-success">
                                <%= order.estado %>
                            </span>
                        <% } %>

                        <% if(order.estado === 'ENVIADA') { %>
                            <span class="badge bg-info">
                                <%= order.estado %>
                            </span>
                        <% } %>

                        <% if(order.estado === 'ENTREGADA') { %>
                            <span class="badge bg-primary">
                                <%= order.estado %>
                            </span>
                        <% } %>

                        <% if(order.estado === 'CANCELADA') { %>
                            <span class="badge bg-danger">
                                <%= order.estado %>
                            </span>
                        <% } %>

                    </td>

                    <td data-label="Fecha">
                        <%= new Date(order.createdAt).toLocaleDateString() %>
                    </td>

                    <td data-label="Editar">

                        <a 
                            href="/dealer/orders/update/<%= order._id %>"
                            class="btn btn-success btn-sm w-100"
                        >
                            Editar
                        </a>

                    </td>

                    <td hidden>

                        <a 
                            href="/delete-order/<%= order._id %>"
                            class="btn btn-danger delete"
                        >
                            Eliminar
                        </a>

                    </td>

                    <td data-label="Detalle">

                        <a 
                            href="/dealer/orders/detail/<%= order._id %>"
                            class="btn btn-info btn-sm w-100"
                        >
                            Detalle
                        </a>

                    </td>

                </tr>

                <% }); %>

            </tbody>

        </table>

    </div>

    <div class="mt-3" hidden>

        <a 
            href="/dealer/orders/create"
            class="btn btn-primary w-100 w-md-auto"
        >
            Crear Nueva Orden
        </a>

    </div>

</main>


<!-- include footer -->
<%- include('../../include/_footerAdmin') %>
<!-- /include footer -->
