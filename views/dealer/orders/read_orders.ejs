<%- include('../../include/_headerDealer') %>

<% const isHistory = typeof history !== 'undefined' && history === true; %>
<%
    const formatDealerCurrency = (value) =>
        `$ ${Number(value || 0).toLocaleString('es-CO', { maximumFractionDigits: 0 })}`;
%>

<main class="container-fluid py-4 dealer-orders-page">
    <header class="dealer-orders-heading">
        <div class="dealer-orders-heading__identity">
            <span class="dealer-orders-heading__icon" aria-hidden="true"><i class="bi bi-bicycle"></i></span>
            <div>
                <p class="dealer-eyebrow">Operación de entregas</p>
                <h1 id="dealer-orders-title" class="title-orders"><%= isHistory ? 'Historial de entregas' : 'Mis entregas' %></h1>
                <p class="dealer-description">
                    <%= isHistory
                        ? 'Consulta los pedidos que ya fueron entregados.'
                        : 'Pedidos asignados para entregar y actualizar.' %>
                </p>
            </div>
        </div>
        <div class="dealer-orders-count" aria-label="<%= isHistory ? 'Total de entregas finalizadas' : 'Total de pedidos asignados' %>">
            <strong><%= pagination.totalItems %></strong>
            <span><%= isHistory ? 'entrega(s) finalizada(s)' : 'pedido(s) asignado(s)' %></span>
        </div>
    </header>

    <% if (!isHistory && dashboard) { %>
    <section class="dealer-dashboard-summary" aria-labelledby="dealer-dashboard-title">
        <div class="dealer-dashboard-summary__header">
            <div>
                <p class="dealer-eyebrow">Resumen operativo</p>
                <h2 id="dealer-dashboard-title">Panel de reparto</h2>
                <p>Consulta rápidamente el estado de tus entregas y el recaudo contra entrega.</p>
            </div>
            <a href="/dealer/orders/history" class="btn btn-outline-secondary dealer-dashboard-summary__link">
                <i class="bi bi-clock-history" aria-hidden="true"></i> Ver historial
            </a>
        </div>

        <div class="dealer-kpi-grid">
            <article class="dealer-kpi-card dealer-kpi-card--pending">
                <span class="dealer-kpi-card__icon" aria-hidden="true"><i class="bi bi-hourglass-split"></i></span>
                <div>
                    <p>Entregas pendientes</p>
                    <strong><%= dashboard.pending %></strong>
                    <span>Asignadas y aún no entregadas</span>
                </div>
            </article>

            <article class="dealer-kpi-card dealer-kpi-card--route">
                <span class="dealer-kpi-card__icon" aria-hidden="true"><i class="bi bi-bicycle"></i></span>
                <div>
                    <p>Entregas en ruta</p>
                    <strong><%= dashboard.inRoute %></strong>
                    <span>Pedidos con estado en camino</span>
                </div>
            </article>

            <article class="dealer-kpi-card dealer-kpi-card--completed">
                <span class="dealer-kpi-card__icon" aria-hidden="true"><i class="bi bi-check2-circle"></i></span>
                <div>
                    <p>Entregas completadas hoy</p>
                    <strong><%= dashboard.completedToday %></strong>
                    <span>Confirmadas durante el día</span>
                </div>
            </article>

            <article class="dealer-kpi-card dealer-kpi-card--cash">
                <span class="dealer-kpi-card__icon" aria-hidden="true"><i class="bi bi-cash-coin"></i></span>
                <div>
                    <p>Total recaudado contra entrega</p>
                    <strong><%= formatDealerCurrency(dashboard.cashCollected) %></strong>
                    <span>Acumulado de pedidos entregados</span>
                </div>
            </article>

            <article class="dealer-kpi-card dealer-kpi-card--overdue">
                <span class="dealer-kpi-card__icon" aria-hidden="true"><i class="bi bi-exclamation-triangle"></i></span>
                <div>
                    <p>Pedidos atrasados</p>
                    <strong><%= dashboard.overdue %></strong>
                    <span>Asignados antes de hoy</span>
                </div>
            </article>
        </div>

        <p class="dealer-dashboard-summary__note">
            <i class="bi bi-info-circle" aria-hidden="true"></i>
            Se considera atrasado un pedido activo asignado antes del inicio del día actual.
        </p>
    </section>

    <section class="dealer-orders-panel" aria-labelledby="dealer-orders-panel-title">
        <div class="dealer-orders-panel__header">
            <div>
                <p class="dealer-eyebrow">Tu jornada</p>
                <h2 id="dealer-orders-panel-title"><%= isHistory ? 'Entregas finalizadas' : 'Pedidos asignados' %></h2>
            </div>
            <span class="dealer-orders-panel__hint">
                <i class="bi bi-info-circle" aria-hidden="true"></i>
                <%= isHistory ? 'Consulta el detalle y seguimiento de cada entrega.' : 'Mantén el estado actualizado' %>
            </span>
        </div>

        <div class="table-responsive dealer-orders-table-wrapper">
            <table class="table table-hover align-middle orders-table dealer-orders-table">
                <caption class="visually-hidden"><%= isHistory ? 'Entregas finalizadas del repartidor' : 'Pedidos asignados al repartidor' %></caption>
                <thead>
                    <tr>
                        <th scope="col">Orden</th>
                        <th scope="col">Cliente</th>
                        <th scope="col">Destino</th>
                        <th scope="col">Total</th>
                        <th scope="col">Pago</th>
                        <th scope="col">Estado</th>
                        <th scope="col">Fecha</th>
                        <th scope="col">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (!orders.length) { %>
                        <tr>
                            <td colspan="8">
                                <div class="dealer-empty-state" role="status">
                                    <span class="dealer-empty-state__icon" aria-hidden="true"><i class="bi bi-inbox"></i></span>
                                    <strong><%= isHistory ? 'Todavía no tienes entregas finalizadas' : 'Todavía no tienes pedidos asignados' %></strong>
                                    <span><%= isHistory ? 'Cuando completes una entrega, aparecerá aquí.' : 'Cuando la tienda te asigne una entrega, aparecerá aquí.' %></span>
                                </div>
                            </td>
                        </tr>
                    <% } else { %>
                        <% orders.forEach(order => { %>
                            <tr>
                                <td data-label="Orden"><strong class="dealer-order-number"><%= order.numeroOrden %></strong></td>
                                <td data-label="Cliente">
                                    <span class="dealer-cell-primary"><%= order.cliente?.nombre || order.usuario?.nombre || 'Sin usuario' %></span>
                                    <small><%= order.cliente?.telefono || order.usuario?.telefono || '' %></small>
                                </td>
                                <td data-label="Destino">
                                    <span class="dealer-cell-primary"><%= order.direccionEnvio?.direccion || 'Sin dirección' %></span>
                                    <small><%= order.direccionEnvio?.ciudad || '' %></small>
                                </td>
                                <td data-label="Total"><strong>$ <%= Number(order.total || 0).toLocaleString('es-CO') %></strong></td>
                                <td data-label="Pago">
                                    <span class="dealer-payment-method">
                                        <i class="bi bi-wallet2" aria-hidden="true"></i>
                                        <%= order.metodoPago === 'CASH_ON_DELIVERY'
                                            ? 'Contra entrega'
                                            : order.metodoPago === 'WOMPI_NEQUI'
                                                ? 'Nequi · Wompi'
                                                : 'Tarjeta · Wompi' %>
                                    </span>
                                </td>
                                <td data-label="Estado">
                                    <span class="dealer-status dealer-status--<%= order.estado.toLowerCase() %>">
                                        <%= statusLabels[order.estado] || order.estado %>
                                    </span>
                                </td>
                                <td data-label="Fecha"><%= new Date(order.createdAt).toLocaleDateString('es-CO') %></td>
                                <td data-label="Acciones" class="dealer-actions">
                                    <% if (!isHistory) { %>
                                        <a href="/dealer/orders/update/<%= order._id %>" class="btn btn-success btn-sm dealer-action-btn dealer-action-btn--primary" aria-label="Actualizar estado del pedido <%= order.numeroOrden %>"><i class="bi bi-pencil-square" aria-hidden="true"></i> Actualizar</a>
                                    <% } %>
                                    <a href="/dealer/orders/detail/<%= order._id %><%= isHistory ? '?history=1' : '' %>" class="btn btn-outline-secondary btn-sm dealer-action-btn" aria-label="<%= isHistory ? 'Ver detalle de la entrega ' : 'Ver seguimiento del pedido ' %><%= order.numeroOrden %>"><i class="bi bi-geo-alt" aria-hidden="true"></i> <%= isHistory ? 'Ver detalle' : 'Seguimiento' %></a>
                                </td>
                            </tr>
                        <% }) %>
                    <% } %>
                </tbody>
            </table>
        </div>
    </section>

    <%- include('../../include/_adminPagination', { pagination, label: isHistory ? 'historial de entregas' : 'entregas' }) %>
</main>

<%- include('../../include/_footerDealer') %>
