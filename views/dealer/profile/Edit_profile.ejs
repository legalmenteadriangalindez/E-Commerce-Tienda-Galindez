<%- include('../../include/_headerDealer') %>


<div class="edit-profile-container">

    <div class="edit-profile-card">

        <!-- HEADER -->
        <div class="edit-profile-header">

            <div class="avatar-wrapper">
                <i class="bi bi-person-circle"></i>
            </div>

            <h2>Editar Perfil</h2>

            <p>
                Actualiza tu información personal
            </p>

        </div>

        <!-- FORM -->
        <form
            action="/perfil/editar/<%= user._id %>?_method=POST"
            method="POST"
            class="edit-profile-form"
        >
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">

            <!-- NOMBRE -->
            <div class="form-group">

                <label>Nombre completo</label>

                <input
                    type="text"
                    name="nombre"
                    value="<%= user.nombre %>"
                    required
                >

            </div>

            <!-- EMAIL -->
            <div class="form-group">

                <label>Correo electrónico</label>

                <input
                    type="email"
                    value="<%= user.email %>"
                    disabled
                >

            </div>

            <!-- TELÉFONO -->
            <div class="form-group">

                <label>Teléfono</label>

                <input
                    type="text"
                    name="telefono"
                    value="<%= user.telefono %>"
                >

            </div>

            <!-- IDENTIFICACIÓN OPCIONAL -->
            <div class="form-group">
                <label for="profile-cedula">Cédula (opcional)</label>
                <input
                    id="profile-cedula"
                    type="text"
                    name="cedula"
                    inputmode="numeric"
                    pattern="[0-9]{5,15}"
                    maxlength="15"
                    autocomplete="off"
                    value="<%= user.cedula || '' %>"
                >
            </div>

            <!-- DIRECCIÓN -->
            <div class="form-group">

                <label>Dirección</label>

                <input
                    type="text"
                    name="direccion"
                    value="<%= user.direccion %>"
                >

            </div>

            <!-- CIUDAD -->
            <div class="form-group">

                <label>Ciudad</label>

                <input
                    type="text"
                    name="ciudad"
                    value="<%= user.ciudad %>"
                >

            </div>

            <!-- BARRIO -->
            <div class="form-group">

                <label>Barrio</label>

                <input
                    type="text"
                    name="barrio"
                    value="<%= user.barrio %>"
                >

            </div>

            <!-- BOTONES -->
            <div class="form-actions">

                <a
                    href="/dealer/orders/read"
                    class="btn-cancel"
                >
                    Cancelar
                </a>

                <button
                    type="submit"
                    class="btn-save"
                >
                    <i class="bi bi-check-circle"></i>
                    Guardar cambios
                </button>

            </div>

        </form>

    </div>

</div>

<%- include('../../include/_footerDealer') %>
