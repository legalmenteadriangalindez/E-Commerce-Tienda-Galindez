
<%- include('../../include/_headerAdmin') %>

<link rel="stylesheet" href="/assets/css/read_products.css">


<main class="admin-list-page">
  <header class="admin-list-heading">
    <div>
      <p class="admin-list-eyebrow">Catálogo</p>
      <h1>Gestionar productos</h1>
      <p class="admin-list-description">Administra precios, inventario y relaciones del catálogo.</p>
    </div>
    <a href="/create-producto" class="admin-list-primary">Crear producto</a>
  </header>

  <div class="admin-table-wrap">
  <table class="table">
    <thead>
      <tr>
        <th scope="col" hidden>#</th>
        <th scope="col">Nombre</th>
        <th scope="col">Descripción</th>
        <th scope="col">Foto</th>
        <th scope="col">Marca</th>
        <th scope="col">Categoría</th>
        <th scope="col">Proveedor</th>
        <th scope="col">Inversión</th>
        <th scope="col">Venta</th>
        <th scope="col">Stock</th>
        <th scope="col">Fecha Ingreso</th>
        <th scope="col">Editar</th>
        <th scope="col">Eliminar</th>
      </tr>
    </thead>

    <tbody>
      <% productos.forEach(function(product) { %>
        <tr>
          <th scope="row" hidden>
            <%= product._id %>
          </th>

          <td>
            <%= product.nombre %>
          </td>

          <td class="descripcion-corta">
            <%= product.descripcion
              ? product.descripcion.substring(0, 50) + '...'
              : 'Sin descripción' %>
          </td>

          <td>
            <% if (product.fotos && product.fotos.length > 0) { %>
              <img
                src="<%= product.fotos[0] %>"
                alt="<%= product.nombre %>"
                width="50"
              >
            <% } else { %>
              Sin imagen
            <% } %>
          </td>

          <td>
            <%= product.marca ? product.marca.nombre : 'N/A' %>
          </td>

          <td>
            <%= product.categoria ? product.categoria.nombre : 'N/A' %>
          </td>

          <td>
            <%= product.proveedor ? product.proveedor.nombre : 'N/A' %>
          </td>

          <td>
            $ <%= (product.precioCosto || 0).toLocaleString('es-CO') %>
          </td>

          <td>
            $ <%= (product.precioVenta || 0).toLocaleString('es-CO') %>
          </td>

          <td>
            <% if (product.stock <= 5) { %>
              <span style="color: red; font-weight: bold;">
                <%= product.stock %>
              </span>
            <% } else { %>
              <%= product.stock %>
            <% } %>
          </td>

          <td>
            <%= product.fechaIngreso
              ? new Date(product.fechaIngreso).toLocaleDateString('es-CO')
              : 'N/A' %>
          </td>

          <td>
            <a
              href="/update-producto/<%= product._id %>"
              class="btn btn-success"
            >
              Editar
            </a>
          </td>

          <td>
            <form action="/delete-producto/<%= product._id %>" method="POST" class="d-inline">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button type="submit" class="btn btn-danger">Eliminar</button>
            </form>
          </td>
        </tr>
      <% }); %>

    </tbody>
  </table>
  </div>
  <% if (!productos.length) { %>
    <p class="admin-list-empty">No hay productos registrados.</p>
  <% } %>
  <%- include('../../include/_adminPagination', { pagination, label: 'productos' }) %>
</main>

<%- include('../../include/_footerAdmin') %>

