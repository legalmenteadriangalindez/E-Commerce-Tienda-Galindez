
<%- include('../../include/_headerAdmin') %>



<main class="admin-shell admin-list-page">
  <%- include('../../include/_adminPageHeader', {
    eyebrow: 'Catálogo',
    title: 'Gestionar productos',
    description: 'Administra precios, inventario y relaciones del catálogo.',
    actionHref: '/create-producto',
    actionLabel: 'Crear producto'
  }) %>

  <div class="admin-card admin-table-wrap ui-table-wrap admin-mobile-card-wrap">
  <table
    class="table ui-table admin-table admin-mobile-card-table admin-products-card-table"
    aria-label="Productos del catálogo"
  >
    <thead>
      <tr>
        <th scope="col" hidden>#</th>
        <th scope="col">Nombre</th>
        <th scope="col" class="admin-mobile-secondary">Descripción</th>
        <th scope="col">Foto</th>
        <th scope="col" class="admin-mobile-secondary">Marca</th>
        <th scope="col" class="admin-mobile-secondary">Categoría</th>
        <th scope="col" class="admin-mobile-secondary">Proveedor</th>
        <th scope="col" class="admin-mobile-secondary">Inversión</th>
        <th scope="col">Venta</th>
        <th scope="col">Stock</th>
        <th scope="col">Mínimo</th>
        <th scope="col">Promoción</th>
        <th scope="col" class="admin-mobile-secondary">Fecha Ingreso</th>
        <th scope="col">Editar</th>
        <th scope="col">Eliminar</th>
      </tr>
    </thead>

    <tbody>
      <% productos.forEach(function(product) { %>
        <tr>
          <th scope="row" hidden>
            <%= product._id %>
          </th>

          <td data-label="Nombre">
            <%= product.nombre %>
          </td>

          <td class="product-description-truncated admin-mobile-secondary" data-label="Descripción">
            <%= product.descripcion
              ? product.descripcion.substring(0, 50) + '...'
              : 'Sin descripción' %>
          </td>

          <td data-label="Foto">
            <% if (product.fotos && product.fotos.length > 0) { %>
              <img
                src="<%= product.fotos[0] %>"
                alt="<%= product.nombre %>"
                width="50"
              >
            <% } else { %>
              Sin imagen
            <% } %>
          </td>

          <td class="admin-mobile-secondary" data-label="Marca">
            <%= product.marca ? product.marca.nombre : 'N/A' %>
          </td>

          <td class="admin-mobile-secondary" data-label="Categoría">
            <%= product.categoria ? product.categoria.nombre : 'N/A' %>
          </td>

          <td class="admin-mobile-secondary" data-label="Proveedor">
            <%= product.proveedor ? product.proveedor.nombre : 'N/A' %>
          </td>

          <td class="admin-mobile-secondary" data-label="Inversión">
            $ <%= (product.precioCosto || 0).toLocaleString('es-CO') %>
          </td>

          <td data-label="Precio de venta">
            $ <%= (product.precioVenta || 0).toLocaleString('es-CO') %>
          </td>

          <td data-label="Stock">
            <% if (product.stock <= Number(product.stockMinimo || 0)) { %>
              <span class="stock-warning">
                <%= product.stock %>
              </span>
            <% } else { %>
              <%= product.stock %>
            <% } %>
          </td>

          <td data-label="Stock mínimo"><%= Number(product.stockMinimo || 0) %></td>

          <td data-label="Promoción"><%= product.enPromocion ? 'Activa' : 'No' %></td>

          <td class="admin-mobile-secondary" data-label="Fecha de ingreso">
            <%= product.fechaIngreso
              ? new Date(product.fechaIngreso).toLocaleDateString('es-CO')
              : 'N/A' %>
          </td>

          <td data-label="Editar">
            <a
              href="/update-producto/<%= product._id %>"
              class="btn btn-success admin-button admin-button--primary"
            >
              Editar
            </a>
          </td>

          <td data-label="Eliminar">
            <form action="/delete-producto/<%= product._id %>" method="POST">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button type="submit" class="btn btn-danger admin-button admin-button--danger">Eliminar</button>
            </form>
          </td>
        </tr>
      <% }); %>

    </tbody>
  </table>
  </div>
  <%- include('../../include/_adminEmptyState', {
    show: !productos.length,
    message: 'No hay productos registrados.'
  }) %>
  <%- include('../../include/_adminPagination', { pagination, label: 'productos' }) %>
</main>

<%- include('../../include/_footerAdmin') %>
