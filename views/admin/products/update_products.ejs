
<%- include('../../include/_headerAdmin') %>

<div class="page-wrapper">

  <div class="page-header">
    <h1>Editar Producto</h1>
    <p>Actualiza la información del producto y gestiona sus imágenes</p>
  </div>

  <div class="form-card">

    <form action="/api/productos/<%= producto._id %>?_method=PUT"
          method="POST"
          enctype="multipart/form-data"
          class="product-form">

      <div class="form-grid">

        <div class="form-group full">
          <label>Nombre</label>
          <input
            type="text"
            name="nombre"
            value="<%= producto.nombre %>"
            required
          >
        </div>

        <div class="form-group full">
          <label>Descripción</label>
          <textarea
            name="descripcion"
            rows="4"
          ><%= producto.descripcion || '' %></textarea>
        </div>

        <div class="form-group">
          <label>Precio de costo</label>
          <input
            type="number"
            name="precioCosto"
            value="<%= producto.precioCosto || 0 %>"
            min="0"
            step="0.01"
            required
          >
        </div>

        <div class="form-group">
          <label>Precio de venta</label>
          <input
            type="number"
            name="precioVenta"
            value="<%= producto.precioVenta || 0 %>"
            min="0"
            step="0.01"
            required
          >
        </div>

        <div class="form-group">
          <label>Stock</label>
          <input
            type="number"
            name="stock"
            value="<%= producto.stock || 0 %>"
            min="0"
            required
          >
        </div>

        <div class="form-group">
          <label>Categoría</label>
          <select name="categoria" required>
            <option value="">Seleccione una categoría</option>

            <% categorias.forEach(c => { %>
              <option
                value="<%= c._id %>"
                <%= producto.categoria && producto.categoria._id.toString() === c._id.toString() ? 'selected' : '' %>
              >
                <%= c.nombre %>
              </option>
            <% }) %>

          </select>
        </div>

        <div class="form-group">
          <label>Marca</label>
          <select name="marca" required>
            <option value="">Seleccione una marca</option>

            <% marcas.forEach(m => { %>
              <option
                value="<%= m._id %>"
                <%= producto.marca && producto.marca._id.toString() === m._id.toString() ? 'selected' : '' %>
              >
                <%= m.nombre %>
              </option>
            <% }) %>

          </select>
        </div>

        <div class="form-group">
          <label>Proveedor</label>
          <select name="proveedor">
            <option value="">Sin proveedor</option>

            <% proveedores.forEach(p => { %>
              <option
                value="<%= p._id %>"
                <%= producto.proveedor && producto.proveedor._id.toString() === p._id.toString() ? 'selected' : '' %>
              >
                <%= p.nombre %>
              </option>
            <% }) %>

          </select>
        </div>

      </div>

      <div class="image-section">

        <h2>Imágenes actuales</h2>

        <div class="image-grid">

          <% if (producto.fotos && producto.fotos.length > 0) { %>

            <% producto.fotos.forEach(function(foto, index) { %>

              <div class="image-card">

                <img
                  src="<%= foto %>"
                  alt="<%= producto.nombre %>"
                >

                <div class="image-actions">

                  <input
                    type="file"
                    name="foto_<%= index %>"
                    accept="image/*"
                  >

                  <label class="delete-check">
                    <input
                      type="checkbox"
                      name="eliminarFotos"
                      value="<%= foto %>"
                    >
                    Eliminar
                  </label>

                </div>

              </div>

            <% }) %>

          <% } else { %>

            <p class="empty">
              Sin imágenes registradas
            </p>

          <% } %>

        </div>

        <div class="upload-new">

          <h3>Agregar nuevas imágenes</h3>

          <input
            type="file"
            name="nuevasFotos"
            multiple
            accept="image/*"
          >

        </div>

      </div>

      <div class="form-actions">

        <button type="submit">
          Actualizar Producto
        </button>

      </div>

    </form>

  </div>

</div>

<%- include('../../include/_footerAdmin') %>

