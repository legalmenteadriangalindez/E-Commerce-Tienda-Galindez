<%- include('../../include/_headerAdmin') %>


<div class="page-wrapper">

  <div class="page-header">
    <h1>Editar Producto</h1>
    <p>Actualiza la información del producto y gestiona sus imágenes</p>
  </div>

  <div class="form-card ui-card ui-card--form">

    <form action="/api/productos/<%= producto._id %>?_method=PUT"
          method="POST"
          enctype="multipart/form-data"
          class="product-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <div class="form-grid ui-form-grid">

        <div class="form-group full">
          <label>Nombre</label>
          <input
            type="text"
            name="nombre"
            value="<%= producto.nombre %>"
            required
          >
        </div>

        <div class="form-group full">
          <label>Descripción</label>
          <textarea
            name="descripcion"
            rows="4"
          ><%= producto.descripcion || '' %></textarea>
        </div>

        <div class="form-group">
          <label>Precio de costo</label>
          <input
            type="number"
            name="precioCosto"
            value="<%= formatCOPInput(producto.precioCostoCents, producto.precioCosto) %>"
            min="0"
            step="0.01"
            aria-describedby="update-cost-price-cop-help"
            required
          >
          <small id="update-cost-price-cop-help">En pesos colombianos, 50000 significa cincuenta mil. Evita puntos de miles.</small>
        </div>

        <div class="form-group">
          <label>Precio de venta</label>
          <input
            type="number"
            name="precioVenta"
            value="<%= formatCOPInput(producto.precioVentaCents, producto.precioVenta) %>"
            min="0"
            step="0.01"
            aria-describedby="update-sale-price-cop-help"
            required
          >
          <small id="update-sale-price-cop-help">Ingresa 80000, no 80.000. Punto solo para centavos.</small>
        </div>

        <div class="form-group">
          <label>Stock actual</label>
          <input type="number" value="<%= producto.stock || 0 %>" readonly aria-describedby="stock-movement-link">
          <input type="hidden" name="stockOriginal" value="<%= producto.stock %>">
          <small id="stock-movement-link"><a href="/inventory/movements?producto=<%= producto._id %>">Consultar o ajustar en el historial</a></small>
        </div>

        <div class="form-group">
          <label for="product-min-stock">Stock mínimo</label>
          <input id="product-min-stock" type="number" min="0" max="100000000" step="1" name="stockMinimo" value="<%= producto.stockMinimo ?? 0 %>" required>
          <small>Se usa junto con las ventas recientes y los días de entrega del proveedor.</small>
        </div>

        <div class="form-group full">
          <input type="hidden" name="enPromocion" value="false">
          <label for="product-promotion" class="promotion-toggle">
            <input id="product-promotion" class="promotion-toggle__checkbox" type="checkbox" name="enPromocion" value="true" aria-describedby="promotion-help" <%= producto.enPromocion ? 'checked' : '' %>>
            <span class="promotion-toggle__content">
              <span class="promotion-toggle__title">Mostrar este producto en Promociones</span>
              <small id="promotion-help" class="promotion-toggle__help">Aparecerá en la tienda mientras tenga existencias disponibles.</small>
            </span>
          </label>
        </div>

        <div class="form-group">
          <label>Categoría</label>
          <select name="categoria" required>
            <option value="">Seleccione una categoría</option>

            <% categorias.forEach(c => { %>
              <option
                value="<%= c._id %>"
                <%= producto.categoria && producto.categoria._id.toString() === c._id.toString() ? 'selected' : '' %>
              >
                <%= c.nombre %>
              </option>
            <% }) %>

          </select>
        </div>

        <div class="form-group">
          <label>Marca</label>
          <select name="marca" required>
            <option value="">Seleccione una marca</option>

            <% marcas.forEach(m => { %>
              <option
                value="<%= m._id %>"
                <%= producto.marca && producto.marca._id.toString() === m._id.toString() ? 'selected' : '' %>
              >
                <%= m.nombre %>
              </option>
            <% }) %>

          </select>
        </div>

        <div class="form-group">
          <label>Proveedor</label>
          <select name="proveedor">
            <option value="">Sin proveedor</option>

            <% proveedores.forEach(p => { %>
              <option
                value="<%= p._id %>"
                <%= producto.proveedor && producto.proveedor._id.toString() === p._id.toString() ? 'selected' : '' %>
              >
                <%= p.nombre %>
              </option>
            <% }) %>

          </select>
          <small>El plazo de entrega se configura en los datos del proveedor.</small>
        </div>

      </div>

      <div class="image-section" aria-labelledby="current-images-heading">

        <div class="image-section__header">
          <div>
            <p class="section-eyebrow">Galería del producto</p>
            <h2 id="current-images-heading">Imágenes actuales</h2>
          </div>
          <span class="image-count"><%= producto.fotos ? producto.fotos.length : 0 %> <%= producto.fotos && producto.fotos.length === 1 ? 'imagen' : 'imágenes' %></span>
        </div>

        <div class="image-grid" role="list" aria-label="Imágenes actuales del producto">

          <% if (producto.fotos && producto.fotos.length > 0) { %>

            <% producto.fotos.forEach(function(foto, index) { %>

              <article class="image-card" role="listitem">

                <div class="image-card__preview">
                  <img
                    class="image-card__image"
                    src="<%= foto %>"
                    alt="<%= producto.nombre %> - Foto <%= index + 1 %>"
                    loading="lazy"
                    decoding="async"
                  >
                  <span class="image-card__badge">Foto <%= index + 1 %></span>
                </div>

                <div class="image-card__body">

                  <div class="image-actions">

                    <div class="image-action">
                      <label class="image-action__label" for="replace-photo-<%= index %>">
                        <span>Reemplazar fotografía</span>
                        <small>Selecciona una nueva imagen</small>
                      </label>
                      <input
                        class="image-upload-input"
                        id="replace-photo-<%= index %>"
                        type="file"
                        name="foto_<%= index %>"
                        accept="image/jpeg,image/png,image/webp"
                        aria-describedby="replace-photo-help-<%= index %>"
                      >
                      <small id="replace-photo-help-<%= index %>" class="image-input-help">JPG, PNG o WEBP · máximo 2 MB</small>
                    </div>

                    <label class="delete-check" for="delete-photo-<%= index %>">
                      <input
                        id="delete-photo-<%= index %>"
                        type="checkbox"
                        name="eliminarFotos"
                        value="<%= foto %>"
                      >
                      <span>Eliminar esta fotografía</span>
                    </label>

                  </div>

                </div>

              </article>

            <% }) %>

          <% } else { %>

            <p class="empty" role="status">
              Sin imágenes registradas
            </p>

          <% } %>

        </div>

        <div class="upload-new">

          <div class="upload-new__header">
            <div>
              <p class="section-eyebrow">Más imágenes</p>
              <h3>Agregar nuevas imágenes</h3>
            </div>
          </div>

          <p class="upload-new__help">JPG, PNG o WEBP; máximo 2 MB por imagen y 4 imágenes por solicitud.</p>

          <label class="upload-new__control" for="new-product-images">
            <span class="upload-new__control-title">Seleccionar archivos</span>
            <span class="upload-new__control-hint">Puedes seleccionar varias imágenes a la vez.</span>
            <input
              id="new-product-images"
              class="upload-new__input"
              type="file"
              name="nuevasFotos"
              multiple
              accept="image/jpeg,image/png,image/webp"
            >
          </label>

        </div>

      </div>

      <div class="form-actions">

        <button type="submit">
          Actualizar Producto
        </button>

      </div>

    </form>

  </div>

</div>

<%- include('../../include/_footerAdmin') %>
