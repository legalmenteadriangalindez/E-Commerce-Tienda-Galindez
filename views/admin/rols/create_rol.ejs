<%- include('../../include/_headerAdmin') %>

<link rel="stylesheet" href="/assets/css/create_roles.css">


<div class="page-wrapper">

  <div class="page-header">
    <h1>Roles</h1>
    <p>Define los roles de acceso del sistema</p>
  </div>

  <div class="form-card small-card">

    <form action="/create-rol" method="POST" class="role-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

  <div class="form-group">
    <label>Nombre del rol</label>
    <input type="text" name="nombre" placeholder="Ej: Administrador" required>
    <small>Define permisos según este rol</small>
  </div>

  <div class="form-group">
    <label>Descripción</label>
    <textarea 
        name="descripcion" 
        placeholder="Ej: Tiene acceso total al sistema"
        rows="3"
        required>
    </textarea>
    <small>Explica qué hace este rol</small>
  </div>

  <div class="form-group">
    <label>Permisos</label>
    <small>El acceso al panel se añade automáticamente cuando seleccionas cualquier permiso administrativo.</small>
    <div class="permission-grid" role="group" aria-label="Permisos del rol">
      <% (permissionKeys || []).forEach(function(permission) { %>
        <label class="permission-option">
          <input type="checkbox" name="permisos" value="<%= permission %>" <%= (selectedPermissions || []).includes(permission) ? 'checked' : '' %>>
          <span><%= permissionLabels[permission] %></span>
        </label>
      <% }); %>
    </div>
  </div>

  <div class="form-actions">
    <button type="submit">Guardar rol</button>
  </div>

</form>

  </div>
</div>

<%- include('../../include/_footerAdmin') %>
