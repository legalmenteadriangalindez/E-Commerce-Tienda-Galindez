<%- include('../../include/_headerAdmin') %>

<div class="page-wrapper">
  <div class="page-header">
    <h1>Roles</h1>
    <p>Define los roles de acceso del sistema</p>
  </div>

  <div class="form-card ui-card ui-card--form small-card">
    <form action="/create-rol" method="POST" class="role-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <div class="form-group">
        <label for="role-name">Nombre del rol</label>
        <input
          id="role-name"
          type="text"
          name="nombre"
          placeholder="Ej: Administrador"
          required
          autofocus
        >
        <small>Define permisos según este rol</small>
      </div>

      <div class="form-group">
        <label for="role-description">Descripción</label>
        <textarea
          id="role-description"
          name="descripcion"
          placeholder="Ej: Tiene acceso total al sistema"
          rows="3"
          required
        ></textarea>
        <small>Explica qué hace este rol</small>
      </div>

      <div class="form-group permission-field">
        <label for="role-permissions">Permisos</label>
        <small id="role-permissions-help">
          El acceso al panel se añade automáticamente cuando seleccionas cualquier permiso administrativo.
        </small>
        <div
          id="role-permissions"
          class="permission-grid"
          role="group"
          aria-label="Permisos del rol"
          aria-describedby="role-permissions-help"
        >
          <% (permissionKeys || []).forEach(function(permission) { %>
            <label class="permission-option">
              <input type="checkbox" name="permisos" value="<%= permission %>" <%= (selectedPermissions || []).includes(permission) ? 'checked' : '' %>>
              <span><%= permissionLabels[permission] %></span>
            </label>
          <% }); %>
        </div>
      </div>

      <div class="form-actions">
        <button type="submit">Guardar rol</button>
      </div>
    </form>
  </div>
</div>

<%- include('../../include/_footerAdmin') %>
