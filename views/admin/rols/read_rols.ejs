<!-- include header -->
<%- include('../../include/_headerAdmin') %>
<!-- /include header -->

<link rel="stylesheet" href="/css/read_rols.css">

<main class="admin-list-page">
  <header class="admin-list-heading">
    <div>
      <p class="admin-list-eyebrow">Accesos</p>
      <h1>Gestionar roles</h1>
      <p class="admin-list-description">Revisa los roles disponibles para las cuentas administrativas.</p>
    </div>
    <a href="/create-rol" class="admin-list-primary">Crear rol</a>
  </header>
  <div class="admin-table-wrap">
  <table class="table">
    <thead>
      <tr>
        <th scope="col" hidden>#</th>
        <th scope="col">Nombre</th>
        <th scope="col">Descripción</th>
        <th scope="col">Editar</th>
        <th scope="col">Eliminar</th>
      </tr>
    </thead>
    <tbody>
      <% roles.forEach(function(rol) { %>
      <tr>
        <th scope="row" hidden><%= rol._id %></th>
        <td><%= rol.nombre %></td>
        <td><%= rol.descripcion %></td>

        <td>
          <a href="/update-rol?id=<%= rol._id %>" class="btn btn-success">Editar</a>
        </td>

        <td>
          <form action="/delete-rol/<%= rol._id %>" method="POST" class="d-inline">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button type="submit" class="btn btn-danger">Eliminar</button>
          </form>
        </td>
      </tr>
      <% }); %>
    </tbody>
  </table>
  </div>
  <% if (!roles.length) { %>
    <p class="admin-list-empty">No hay roles registrados.</p>
  <% } %>
  <%- include('../../include/_adminPagination', { pagination, label: 'roles' }) %>

</main>

<!-- include footer -->
<%- include('../../include/_footerAdmin') %>
<!-- /include footer -->


