<!-- include header -->
<%- include('../../include/_headerAdmin') %>
<!-- /include header -->


<main class="admin-shell admin-list-page">
  <%- include('../../include/_adminPageHeader', {
    eyebrow: 'Accesos',
    title: 'Gestionar roles',
    description: 'Revisa los roles disponibles para las cuentas administrativas.',
    actionHref: '/create-rol',
    actionLabel: 'Crear rol'
  }) %>
  <div class="admin-card admin-table-wrap ui-table-wrap">
  <table class="table ui-table admin-table">
    <thead>
      <tr>
        <th scope="col" hidden>#</th>
        <th scope="col">Nombre</th>
        <th scope="col">Descripción</th>
        <th scope="col">Permisos</th>
        <th scope="col">Editar</th>
        <th scope="col">Eliminar</th>
      </tr>
    </thead>
    <tbody>
      <% roles.forEach(function(rol) { %>
      <tr>
        <th scope="row" hidden><%= rol._id %></th>
        <td><%= rol.nombre %></td>
        <td><%= rol.descripcion %></td>
        <td>
          <span class="badge bg-primary"><%= (rol.permisos || []).length %></span>
          <div class="small text-muted mt-1">
            <% (rol.permisos || []).slice(0, 3).forEach(function(permission, index, visiblePermissions) { %>
              <span><%= permissionLabels?.[permission] || permission %></span><%= index < visiblePermissions.length - 1 ? ', ' : '' %>
            <% }); %>
            <% if ((rol.permisos || []).length > 3) { %>…<% } %>
          </div>
        </td>

        <td>
          <% if (['Admin', 'Cliente', 'dealer'].includes(rol.nombre)) { %>
            <span class="text-muted">Protegido</span>
          <% } else { %>
            <a href="/update-rol?id=<%= rol._id %>" class="btn btn-success admin-button admin-button--primary">Editar</a>
          <% } %>
        </td>

        <td>
          <% if (['Admin', 'Cliente', 'dealer'].includes(rol.nombre)) { %>
            <span class="text-muted">Protegido</span>
          <% } else { %>
            <form action="/delete-rol/<%= rol._id %>" method="POST" class="d-inline">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button type="submit" class="btn btn-danger admin-button admin-button--danger">Eliminar</button>
            </form>
          <% } %>
        </td>
      </tr>
      <% }); %>
    </tbody>
  </table>
  </div>
  <%- include('../../include/_adminEmptyState', {
    show: !roles.length,
    message: 'No hay roles registrados.'
  }) %>
  <%- include('../../include/_adminPagination', { pagination, label: 'roles' }) %>

</main>

<!-- include footer -->
<%- include('../../include/_footerAdmin') %>
<!-- /include footer -->
