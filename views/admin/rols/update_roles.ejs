<%- include('../../include/_headerAdmin') %>



<div class="page-wrapper">

  <div class="page-header">
    <h1>Editar Rol</h1>
    <p>Actualiza el nombre, descripción y permisos del rol</p>
  </div>

  <div class="form-card ui-card ui-card--form small-card">

    <form action="/update-rol" method="POST" class="role-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="id" value="<%= rol._id %>">

      <div class="form-group">
        <label>Nombre del rol</label>

        <input
          type="text"
          name="nombre"
          value="<%= rol.nombre %>"
          required
          autofocus
        >

        <small>Este nombre define el nivel de acceso</small>
      </div>

      <div class="form-group">
        <label>Descripción</label>
        <textarea name="descripcion" rows="3" maxlength="500"><%= rol.descripcion || '' %></textarea>
      </div>

      <% const systemRole = ['SuperAdmin', 'Admin', 'Cliente', 'dealer'].includes(rol.nombre); %>
      <div class="form-group">
        <label>Permisos</label>
        <% if (systemRole) { %>
          <small>Este rol del sistema está protegido y no puede renombrarse ni modificar sus permisos desde el panel.</small>
        <% } else { %>
          <small>El acceso al panel se añade automáticamente cuando seleccionas cualquier permiso administrativo.</small>
        <% } %>
        <div class="permission-grid" role="group" aria-label="Permisos del rol">
          <% (permissionKeys || []).forEach(function(permission) { %>
            <label class="permission-option <%= systemRole ? 'is-disabled' : '' %>">
              <input type="checkbox" name="permisos" value="<%= permission %>"
                <%= (selectedPermissions || []).includes(permission) ? 'checked' : '' %>
                <%= systemRole ? 'disabled' : '' %>>
              <span><%= permissionLabels[permission] %></span>
            </label>
          <% }); %>
        </div>
      </div>

      <div class="form-actions">
        <% if (systemRole) { %>
          <a href="/read-rol" class="btn btn-secondary">Volver a roles</a>
        <% } else { %>
          <button type="submit">Actualizar rol</button>
        <% } %>
      </div>

    </form>

  </div>
</div>

<%- include('../../include/_footerAdmin') %>
