      <article class="ap-order-card admin-card">
        <header class="ap-order-card__heading">
          <div>
            <span class="ap-overline">Pedido</span>
            <h3><a href="/order/<%= order._id %>"><%= order.numeroOrden %></a></h3>
          </div>
          <div class="ap-total">
            <span>Total</span>
            <strong><%= formatCOP(order.totalCents, order.total) %> <small>COP</small></strong>
          </div>
        </header>

        <div class="ap-order-facts">
          <div><span>Cliente</span><strong><%= order.cliente.nombre %></strong></div>
          <div><span>Medio de pago</span><strong><%= order.paymentMethodLabel %></strong></div>
          <div><span>Canal</span><strong><%= order.canal || 'Anterior a esta versión' %></strong></div>
          <div><span>Inventario</span><strong><%= order.inventario || 'Revisar historial' %></strong></div>
          <div><span>Repartidor</span><strong><%= order.repartidor?.nombre || 'Sin asignar' %></strong></div>
          <% if (order.metodoPagoConfirmado) { %>
            <div><span>Método reportado por Wompi</span><strong><%= order.metodoPagoConfirmado %></strong></div>
          <% } %>
        </div>

        <div class="ap-order-states" aria-label="Estados del pedido">
          <span class="ap-state ap-state--<%= paymentStateClass[order.estadoPago] || 'neutral' %>">Pago: <%= order.estadoPago %></span>
          <span class="ap-state ap-state--<%= orderStateClass[order.estado] || 'neutral' %>">Pedido: <%= order.estado %></span>
          <span class="ap-state ap-state--<%= inventoryStateClass[order.inventario] || 'neutral' %>">Inventario: <%= order.inventario || 'Sin dato' %></span>
        </div>

        <% if (order.incidenciaPago) { %>
          <p class="ap-order-alert"><i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i><%= order.incidenciaPago %></p>
        <% } %>

        <% if (order.canConfirmCash || order.canCancelOrder || order.canResolvePayment) { %>
          <div class="ap-order-actions">
            <% if (order.canConfirmCash) { %>
              <form action="/admin/payments/<%= order._id %>/confirm-cash" method="post" class="ap-action-form">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <label class="ap-check">
                  <input type="checkbox" name="confirmar" value="si" required>
                  <span>Confirmé el efectivo correspondiente a este pedido.</span>
                </label>
                <button class="ap-button ap-button--primary admin-button admin-button--primary" type="submit"><%= order.confirmCashLabel %></button>
              </form>
            <% } %>

            <% if (order.canCancelOrder) { %>
              <form action="/admin/payments/<%= order._id %>/cancel" method="post" class="ap-action-form ap-action-form--compact">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button class="ap-button ap-button--danger admin-button admin-button--danger" type="submit"><%= order.cancelOrderLabel %></button>
              </form>
            <% } %>

            <% if (order.canResolvePayment) { %>
              <details class="ap-details ap-details--wide">
                <summary>Disponibilidad o devolución ya realizada</summary>
                <p>Registrar una devolución no mueve dinero. Primero debes efectuarla y comprobarla en Wompi o en caja. Solo admite devolución total.</p>
                <form action="/admin/payments/<%= order._id %>/resolve" method="post" class="ap-form ap-form--stack">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <label class="ap-field" for="order-resolution-action-<%= order._id %>">
                    <span>Acción</span>
                    <select id="order-resolution-action-<%= order._id %>" name="accion" required>
                      <option value="">Selecciona una acción</option>
                      <% if (order.canReserveAgain) { %><option value="RESERVAR">Confirmar existencias y reservar de nuevo</option><% } %>
                      <option value="DEVOLUCION">Registrar devolución total ya realizada</option>
                    </select>
                  </label>
                  <label class="ap-field" for="order-resolution-reason-<%= order._id %>">
                    <span>Motivo</span>
                    <input id="order-resolution-reason-<%= order._id %>" name="motivo" required minlength="10" maxlength="500">
                  </label>
                  <label class="ap-field" for="order-resolution-proof-<%= order._id %>">
                    <span>Referencia del comprobante</span>
                    <input id="order-resolution-proof-<%= order._id %>" name="comprobante" required maxlength="150">
                  </label>
                  <label class="ap-check">
                    <input type="checkbox" name="reponer" value="si">
                    <span>Al registrar la devolución, reponer las unidades: están en tienda y aptas para vender.</span>
                  </label>
                  <label class="ap-check">
                    <input type="checkbox" name="confirmar" value="si" required>
                    <span>Comprobé el pago, la acción y el inventario.</span>
                  </label>
                  <button class="ap-button ap-button--primary admin-button admin-button--primary" type="submit">Registrar revisión</button>
                </form>
              </details>
            <% } %>
          </div>
        <% } %>

        <footer class="ap-order-links">
          <a href="/update-order?id=<%= order._id %>"><i class="bi bi-truck" aria-hidden="true"></i>Gestionar entrega</a>
          <% if (order.canManageDelivery) { %>
            <a href="/admin/delivery"><i class="bi bi-geo-alt" aria-hidden="true"></i>Asignar o revisar reparto</a>
          <% } %>
        </footer>

        <% if (order.revisionPago?.fecha) { %>
          <div class="ap-review-history">
            <strong>Última revisión</strong>
            <span><%= order.revisionPago.accion %></span>
            <span><%= order.revisionPago.motivo %></span>
            <span>Comprobante: <%= order.revisionPago.comprobante %></span>
          </div>
        <% } %>
      </article>
