<!-- include header -->
<%- include('../../include/_headerAdmin') %>
<!-- /include header -->


<div class="checkout-wrapper">
    <div class="checkout-header">
        <h1><i class="fas fa-store"></i> Punto de Pago Seguro</h1>
        <div class="badge-secure"><i class="fas fa-lock"></i> Registro de venta en caja</div>
    </div>

    <form action="/carrito/checkout_admin" method="POST">
        <input type="hidden" name="totalCotizado" value="<%= total %>">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="claveIdempotenciaCaja" value="<%= claveIdempotenciaCaja %>">

        <div class="checkout-grid">
            <div class="form-card">
                <div class="section-title"><i class="fas fa-user-pen"></i><span>Información de facturación</span></div>

                <div class="input-group">
                    <label>Nombre completo</label>
                    <input type="text" id="fullName" name="fullName" placeholder="Nombre del cliente" required>
                </div>

                <fieldset class="payment-options">
                    <legend>Método de pago</legend>
                    <% paymentMethods.forEach((method, index) => { %>
                        <label class="payment-option">
                            <input type="radio" name="metodoPago" value="<%= method.value %>" <%= index === 0 ? 'checked' : '' %> required>
                            <span><strong><%= method.label %></strong><small><%= method.description %></small></span>
                        </label>
                    <% }) %>
                </fieldset>

                <div class="input-row">
                    <div class="input-group">
                        <label>Correo electrónico</label>
                        <input type="email" id="email" name="email" placeholder="correo@cliente.com" required>
                    </div>
                    <div class="input-group">
                        <label>Teléfono</label>
                        <input type="tel" id="phone" name="phone" placeholder="Teléfono del cliente" required>
                    </div>
                </div>

                <div class="input-group">
                    <label>Dirección</label>
                    <input type="text" id="address" name="address" placeholder="Dirección del cliente" required>
                </div>

                <div class="input-row">
                    <div class="input-group">
                        <label>Departamento</label>
                        <input type="text" id="department" name="department" placeholder="Departamento">
                    </div>
                    <div class="input-group">
                        <label>Ciudad</label>
                        <input type="text" id="city" name="city" placeholder="Ciudad" required>
                    </div>
                </div>

                <div class="input-row">
                    <div class="input-group">
                        <label>Referencia</label>
                        <input type="text" id="reference" name="reference" placeholder="Apartamento, torre, referencia...">
                    </div>
                </div>

                <div class="input-group">
                    <label>Notas del cliente</label>
                    <textarea id="notes" name="notes" rows="4" placeholder="Notas adicionales para la entrega..."></textarea>
                </div>

                <div class="trust-badge">
                    <span><i class="fas fa-shield-alt"></i> Datos seguros</span>
                    <span><i class="fas fa-clock"></i> Atención de la tienda</span>
                </div>
            </div>

            <%- include('./partials/order-summary', {
                productosCarrito,
                subtotal,
                costoEnvio,
                total,
                subtotalCents,
                shippingPriceCents,
                freeShippingFromCents
            }) %>
        </div>
    </form>
</div>

<!-- include footer -->
<%- include('../../include/_footerAdmin') %>
<!-- /include footer -->
