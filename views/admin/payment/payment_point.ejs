<!-- include header -->
<%- include('../../include/_headerAdmin') %>
<!-- /include header -->

<div class="checkout-wrapper">

    <div class="checkout-header">

        <h1>
            <i class="fas fa-store"></i>
            Punto de Pago Seguro
        </h1>

        <div class="badge-secure">
            <i class="fas fa-lock"></i>
            Transacción 100% encriptada · Pago protegido
        </div>

    </div>

    <!-- FORMULARIO PRINCIPAL -->
    <form action="/carrito/checkout_admin" method="POST">

        <div class="checkout-grid">

            <!-- COLUMNA IZQUIERDA -->
            <div class="form-card">

                <div class="section-title">
                    <i class="fas fa-user-pen"></i>
                    <span>Información de facturación</span>
                </div>

                <!-- NOMBRE -->
                <div class="input-group">

                    <label>Nombre completo</label>

                    <input
                        type="text"
                        id="fullName"
                        name="fullName"
                        placeholder="Nombre del cliente"
                        required
                    >

                </div>

                <div class="input-row">

                    <!-- EMAIL -->
                    <div class="input-group">

                        <label>Correo electrónico</label>

                        <input
                            type="email"
                            id="email"
                            name="email"
                            placeholder="correo@cliente.com"
                            required
                        >

                    </div>

                    <!-- TELÉFONO -->
                    <div class="input-group">

                        <label>Teléfono</label>

                        <input
                            type="tel"
                            id="phone"
                            name="phone"
                            placeholder="Teléfono del cliente"
                            required
                        >

                    </div>

                </div>

                <!-- DIRECCIÓN -->
                <div class="input-group">

                    <label>Dirección</label>

                    <input
                        type="text"
                        id="address"
                        name="address"
                        placeholder="Dirección del cliente"
                        required
                    >

                </div>

                <!-- DEPARTAMENTO Y CIUDAD -->
                <div class="input-row">

                    <div class="input-group">

                        <label>Departamento</label>

                        <input
                            type="text"
                            id="department"
                            name="department"
                            placeholder="Departamento"
                        >

                    </div>

                    <div class="input-group">

                        <label>Ciudad</label>

                        <input
                            type="text"
                            id="city"
                            name="city"
                            placeholder="Ciudad"
                            required
                        >

                    </div>

                </div>

                <!-- ZIP Y REFERENCIA -->
                <div class="input-row">

                    <div class="input-group">

                        <label>Referencia</label>

                        <input
                            type="text"
                            id="reference"
                            name="reference"
                            placeholder="Apartamento, torre, referencia..."
                        >

                    </div>

                </div>

                <!-- NOTAS -->
                <div class="input-group">

                    <label>Notas del cliente</label>

                    <textarea
                        id="notes"
                        name="notes"
                        rows="4"
                        placeholder="Notas adicionales para la entrega..."
                    ></textarea>

                </div>


                <div class="trust-badge">

                    <span>
                        <i class="fas fa-shield-alt"></i>
                        Datos seguros
                    </span>

                    <span>
                        <i class="fas fa-clock"></i>
                        Soporte 24/7
                    </span>

                </div>

            </div>

            <!-- COLUMNA DERECHA -->
            <div class="summary-card">

                <div class="section-title">

                    <i class="fas fa-bag-shopping"></i>

                    <span>Tu pedido</span>

                </div>

                <div class="order-items-list text-sumary">

                    <% productosCarrito.forEach(item => { %>

                        <div class="order-item">

                            <div class="item-icon">
                                <i class="fas fa-box"></i>
                            </div>

                            <div class="item-details">

                                <div class="item-title">
                                    <%= item.nombre %>
                                </div>

                                <div class="item-price">
                                    <%= item.precio %> $
                                </div>

                                <div class="item-quantity">
                                    Cantidad: <%= item.cantidad %>
                                </div>

                            </div>

                            <div class="item-line-price">
                                <%= item.precio * item.cantidad %> $
                            </div>

                        </div>

                    <% }) %>

                </div>

                <div class="divider"></div>

                <div class="summary-line text-sumary">
                    <span>Subtotal</span>
                    <span><%= subtotal.toFixed(2) %> $</span>
                </div>

                <div class="summary-line text-sumary">
                    <span>Envío</span>
                    <span>$5000</span>
                </div>

                <div class="summary-line text-sumary">
                    <span>Impuestos (estimado)</span>
                    <span>$0</span>
                </div>

                <% let envio = 5000; %>
                <% let impuestos = 0; %>
                <% let totalFinal = subtotal + envio + impuestos; %>

                <div class="promo-code">



                </div>

                <div class="summary-line total text-sumary">

                    <span>Total a pagar</span>

                    <span>$<%= totalFinal.toFixed(2) %></span>

                </div>

                <!-- BOTÓN -->
                <button type="submit" class="pay-btn">

                    <i class="fas fa-lock"></i>

                    Confirmar pago · $<%= totalFinal.toFixed(2) %>

                </button>

                <div
                    class="trust-badge"
                    style="justify-content: space-between; margin-top: 18px;"
                >



                </div>

            </div>

        </div>

    </form>

</div>

<!-- include footer -->
<%- include('../../include/_footerAdmin') %>
<!-- /include footer -->