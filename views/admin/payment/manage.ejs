<%- include('../../include/_headerAdmin') %>
<%
  const paymentStateClass = {
    PENDIENTE: 'pending',
    PAGADO: 'success',
    RECHAZADO: 'danger',
    REEMBOLSADO: 'muted',
  };
  const orderStateClass = {
    PENDIENTE: 'pending',
    PAGADA: 'success',
    PREPARANDO: 'info',
    ENVIADA: 'info',
    ENTREGADA: 'success',
    CANCELADA: 'muted',
    REQUIERE_REVISION: 'danger',
  };
  const inventoryStateClass = {
    RESERVADO: 'info',
    CONFIRMADO: 'success',
    LIBERADO: 'muted',
    REVISION: 'warning',
  };
%>

<main class="admin-shell admin-list-page admin-payments">
  <%- include('../../include/_adminPageHeader', {
    eyebrow: 'Operación financiera',
    title: 'Pagos y conciliación',
    description: 'Confirma los pagos recibidos en caja y revisa las respuestas de Wompi.',
    additionalClass: 'ap-heading',
    showAction: can('payments:manage'),
    actionHref: '/billing-point',
    actionLabel: 'Abrir punto de pago',
    actionIcon: 'bi bi-cash-coin',
    actionVariant: 'secondary',
    actionClass: 'ap-button ap-button--secondary'
  }) %>

  <% if (notice) { %>
    <p class="admin-alert admin-alert--success ap-notice" role="status"><i class="bi bi-check-circle-fill" aria-hidden="true"></i><span class="admin-alert__message"><%= notice %></span></p>
  <% } %>

  <%- include('./partials/reconcile-panel', { csrfToken }) %>
  <%- include('./partials/payment-incidents', { events, csrfToken }) %>
  <%- include('./partials/orders-list', { orders, pagination, csrfToken, paymentStateClass, orderStateClass, inventoryStateClass }) %>

</main>

<%- include('../../include/_footerAdmin') %>
