<%- include('../../include/_headerAdmin') %>

<div class="page-wrapper">

  <div class="page-header">
    <h1>Métodos de Pago</h1>
    <p>Configura los métodos de pago disponibles en tu tienda</p>
  </div>

  <div class="form-card">

    <% if (locals.error) { %>
      <div class="alert error"><%= error %></div>
    <% } %>

    <% if (locals.success) { %>
      <div class="alert success"><%= success %></div>
    <% } %>

    <form action="/create-payment" method="POST" class="category-form">

      <!-- NOMBRE -->
      <div class="form-group">
        <label>Nombre</label>
        <input 
          type="text" 
          name="nombre" 
          placeholder="Ej: Nequi"
          required
          autofocus
        >
      </div>

      <!-- CODIGO -->
      <div class="form-group">
        <label>Código</label>
        <input 
          type="text" 
          name="codigo" 
          placeholder="Ej: NEQUI"
          required
        >
        <small>Debe ser único</small>
      </div>

      <!-- TIPO -->
      <div class="form-group">
        <label>Tipo</label>

        <select name="tipo" required>

          <option value="">
            Selecciona un tipo
          </option>

          <option value="efectivo">
            Efectivo
          </option>

          <option value="transferencia">
            Transferencia
          </option>

          <option value="tarjeta">
            Tarjeta
          </option>

          <option value="billetera_digital">
            Billetera digital
          </option>

          <option value="pasarela">
            Pasarela
          </option>

        </select>
      </div>

      <!-- DESCRIPCION -->
      <div class="form-group">
        <label>Descripción</label>

        <textarea 
          name="descripcion"
          rows="4"
          placeholder="Descripción del método de pago"
        ></textarea>
      </div>

      <!-- LOGO -->
      <div class="form-group">
        <label>Logo URL</label>

        <input 
          type="text"
          name="logo"
          placeholder="/img/nequi.png"
        >
      </div>

      <!-- COMISION -->
      <div class="form-group">
        <label>Comisión (%)</label>

        <input 
          type="number"
          name="comision"
          step="0.01"
          min="0"
          value="0"
        >
      </div>

      <!-- NUMERO CUENTA -->
      <div class="form-group">
        <label>Número de cuenta</label>

        <input 
          type="text"
          name="configuracion[numero_cuenta]"
          placeholder="3001234567"
        >
      </div>

      <!-- TITULAR -->
      <div class="form-group">
        <label>Titular</label>

        <input 
          type="text"
          name="configuracion[titular]"
          placeholder="Nombre del titular"
        >
      </div>

      <!-- MONEDA -->
      <div class="form-group">
        <label>Moneda</label>

        <select name="monedas">

          <option value="COP">
            COP
          </option>

          <option value="USD">
            USD
          </option>

          <option value="EUR">
            EUR
          </option>

        </select>
      </div>

      <!-- ACTIVO -->
      <div class="form-group checkbox-group">

        <label>
          <input 
            type="checkbox"
            name="activo"
            value="true"
            checked
          >

          Método activo
        </label>

      </div>

      <!-- REEMBOLSO -->
      <div class="form-group checkbox-group">

        <label>
          <input 
            type="checkbox"
            name="permite_reembolso"
            value="true"
          >

          Permite reembolsos
        </label>

      </div>

      <!-- VERIFICACION -->
      <div class="form-group checkbox-group">

        <label>
          <input 
            type="checkbox"
            name="requiere_verificacion"
            value="true"
          >

          Requiere verificación
        </label>

      </div>

      <div class="form-actions">
        <button type="submit">
          Guardar método de pago
        </button>
      </div>

    </form>

  </div>

</div>

<%- include('../../include/_footerAdmin') %>