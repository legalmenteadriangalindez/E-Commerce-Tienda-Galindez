<%- include('../../include/_headerAdmin') %>

<div class="page-wrapper">

  <div class="page-header">
    <h1>Actualizar Pago</h1>
    <p>Edita la información del pago seleccionado</p>
  </div>

  <div class="form-card small-card">

    <% if (locals.error) { %>
      <div class="alert error"><%= error %></div>
    <% } %>

    <% if (locals.success) { %>
      <div class="alert success"><%= success %></div>
    <% } %>

    <form action="/update-payment/<%= payment._id %>" method="POST" class="category-form">

      <!-- ORDEN -->
      <div class="form-group">
        <label>Orden</label>
        <input 
          type="text" 
          name="orden"
          value="<%= payment.orden || '' %>"
          placeholder="ID de orden"
        >
      </div>

      <!-- USUARIO -->
      <div class="form-group">
        <label>Usuario</label>
        <input 
          type="text" 
          name="usuario"
          value="<%= payment.usuario || '' %>"
          placeholder="ID usuario"
        >
      </div>

      <!-- MÉTODO DE PAGO -->
      <div class="form-group">
        <label>Método de Pago</label>

        <select name="metodo" required>

          <% paymentMethods.forEach(function(method) { %>

            <option 
              value="<%= method.nombre %>"
              <%= payment.metodo == method.nombre ? 'selected' : '' %>
            >
              <%= method.nombre %>
            </option>

          <% }) %>

        </select>
      </div>

      <!-- MONTO -->
      <div class="form-group">
        <label>Monto</label>
        <input 
          type="number" 
          name="monto"
          value="<%= payment.monto %>"
          required
        >
      </div>

      <!-- MONEDA -->
      <div class="form-group">
        <label>Moneda</label>
        <input 
          type="text" 
          name="moneda"
          value="<%= payment.moneda || 'COP' %>"
        >
      </div>

      <!-- ESTADO -->
      <div class="form-group">
        <label>Estado</label>

        <select name="estado" required>

          <option value="PENDIENTE" <%= payment.estado == 'PENDIENTE' ? 'selected' : '' %>>
            PENDIENTE
          </option>

          <option value="APROBADO" <%= payment.estado == 'APROBADO' ? 'selected' : '' %>>
            APROBADO
          </option>

          <option value="RECHAZADO" <%= payment.estado == 'RECHAZADO' ? 'selected' : '' %>>
            RECHAZADO
          </option>

          <option value="EXPIRADO" <%= payment.estado == 'EXPIRADO' ? 'selected' : '' %>>
            EXPIRADO
          </option>

          <option value="REEMBOLSADO" <%= payment.estado == 'REEMBOLSADO' ? 'selected' : '' %>>
            REEMBOLSADO
          </option>

        </select>
      </div>

      <!-- PROVEEDOR -->
      <div class="form-group">
        <label>Proveedor de Pago</label>
        <input 
          type="text" 
          name="proveedorPago"
          value="<%= payment.proveedorPago || '' %>"
          placeholder="Ej: Nequi, PayPal, Stripe"
        >
      </div>

      <div class="form-actions">
        <button type="submit">
          Actualizar Pago
        </button>
      </div>

    </form>

  </div>
</div>

<%- include('../../include/_footerAdmin') %>