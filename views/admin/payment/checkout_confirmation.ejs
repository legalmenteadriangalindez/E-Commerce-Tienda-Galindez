<%- include('../../include/_headerAdmin') %>

<div class="checkout-wrapper">

    <div class="checkout-header">

        <h1>
            <i class="fas fa-store"></i>
            Confirmación de Compra
        </h1>

        <div class="badge-secure">
            <i class="fas fa-lock"></i>
            Pago seguro y encriptado
        </div>

    </div>

    <div class="checkout-grid">

        <!-- DATOS CLIENTE -->
        <div class="form-card">

            <div class="section-title">
                <i class="fas fa-user-pen"></i>
                <span>Datos del cliente</span>
            </div>

            <!-- NOMBRE -->
            <div class="input-group">

                <label>Nombre</label>

                <input
                    type="text"
                    value="<%= orden?.cliente?.nombre || '' %>"
                    readonly
                >

            </div>

            <div class="input-row">

                <!-- EMAIL -->
                <div class="input-group">

                    <label>Email</label>

                    <input
                        type="email"
                        value="<%= orden?.cliente?.email || '' %>"
                        readonly
                    >

                </div>

                <!-- TELÉFONO -->
                <div class="input-group">

                    <label>Teléfono</label>

                    <input
                        type="text"
                        value="<%= orden?.cliente?.telefono || '' %>"
                        readonly
                    >

                </div>

            </div>

            <!-- DIRECCIÓN -->
            <div class="input-group">

                <label>Dirección</label>

                <input
                    type="text"
                    value="<%= orden?.direccionEnvio?.direccion || '' %>"
                    readonly
                >

            </div>

            <div class="input-row">

                <!-- CIUDAD -->
                <div class="input-group">

                    <label>Ciudad</label>

                    <input
                        type="text"
                        value="<%= orden?.direccionEnvio?.ciudad || '' %>"
                        readonly
                    >

                </div>

                <!-- ZIP -->
                <div class="input-group">

                    <label>Código postal</label>

                    <input
                        type="text"
                        value="<%= orden?.direccionEnvio?.codigoPostal || '' %>"
                        readonly
                    >

                </div>

            </div>

        </div>

        <!-- RESUMEN -->
        <div class="summary-card">

            <div class="section-title">
                <i class="fas fa-bag-shopping"></i>
                <span>Resumen del pedido</span>
            </div>

            <div class="order-items-list orderItemsList" >

                <% let subtotal = orden?.subtotal || 0; %>
                <% let envio = orden?.costoEnvio || 0; %>
                <% let impuestos = orden?.impuestos || 0; %>
                <% let totalFinal = orden?.total || 0; %>

                <% orden?.productos?.forEach(item => { %>
                    <div class="order-item">

                        <div class="item-icon">
                            <i class="fas fa-box"></i>
                        </div>

                        <div class="item-details">

                            <div class="item-title">
                                <%= item.nombre %>
                            </div>

                            <div class="item-price">
                                $<%= item.precioUnitario %>
                            </div>

                            <div class="item-quantity">
                                Cantidad: <%= item.cantidad %>
                            </div>

                        </div>

                        <div class="item-line-price">
                            $<%= item.subtotal %>
                        </div>
                    </div>
                    

                <% }) %>

            </div>

            <div class="divider"></div>

            <div class="summary-line">
                <span>Subtotal</span>
                <span>$<%= subtotal %></span>
            </div>

            <div class="summary-line">
                <span>Envío</span>
                <span>$<%= envio %></span>
            </div>

            <div class="summary-line">
                <span>Impuestos</span>
                <span>$<%= impuestos %></span>
            </div>

            <div class="summary-line total">
                <span>Total</span>
                <span>$<%= totalFinal %></span>
            </div>

            <!-- BOTÓN -->
            <a href="/billing-point" class="pay-link">

                <div
                    class="pay-btn"
                    style="text-align:center;"
                >
                    <i class="fas fa-check-circle"></i>
                    Aceptar
                </div>

            </a>

        </div>


    </div>

</div>

<%- include('../../include/_footerAdmin') %>