<!-- include header -->
<%- include('../../include/_headerAdmin') %>
<!-- /include header -->


<main>

<div>
    <h1>Gestionar Pagos</h1>
</div>

<table class="table">

    <thead>

        <tr>

            <th scope="col" hidden>#</th>

            <th scope="col">Orden</th>

            <th scope="col">Usuario</th>

            <th scope="col">Método</th>

            <th scope="col">Monto</th>

            <th scope="col">Estado</th>

            <th scope="col">Proveedor</th>

            <th scope="col">Fecha</th>

            <th scope="col">Editar</th>

            <th scope="col">Eliminar</th>

        </tr>

    </thead>

    <tbody>

        <% payments.forEach(function(payment) { %>

        <tr>

            <th scope="row" hidden>
                <%= payment._id %>
            </th>

            <td>
                <%= payment.orden?.numeroOrden || 'Sin orden' %>
            </td>

            <td>
                <%= payment.usuario?.nombre || 'Sin usuario' %>
            </td>

            <td>
                <%= payment.metodo %>
            </td>

            <td>
                $ <%= payment.monto?.toLocaleString() %>
                <%= payment.moneda %>
            </td>

            <td>

                <% if(payment.estado === 'PENDIENTE') { %>

                    <span class="badge bg-warning text-dark">
                        <%= payment.estado %>
                    </span>

                <% } %>

                <% if(payment.estado === 'APROBADO') { %>

                    <span class="badge bg-success">
                        <%= payment.estado %>
                    </span>

                <% } %>

                <% if(payment.estado === 'RECHAZADO') { %>

                    <span class="badge bg-danger">
                        <%= payment.estado %>
                    </span>

                <% } %>

                <% if(payment.estado === 'EXPIRADO') { %>

                    <span class="badge bg-secondary">
                        <%= payment.estado %>
                    </span>

                <% } %>

                <% if(payment.estado === 'REEMBOLSADO') { %>

                    <span class="badge bg-info">
                        <%= payment.estado %>
                    </span>

                <% } %>

            </td>

            <td>
                <%= payment.proveedorPago %>
            </td>

            <td>
                <%= new Date(payment.createdAt).toLocaleDateString() %>
            </td>

            <td>

                <a 
                    href="/update-payment?id=<%= payment._id %>"
                    class="btn btn-success"
                >
                    Editar
                </a>

            </td>

            <td>

                <a 
                    href="/delete-payment/<%= payment._id %>"
                    class="btn btn-danger delete"
                >
                    Eliminar
                </a>

            </td>

        </tr>

        <% }); %>

        <tr>

            <td colspan="10">

                <a 
                    href="/create-payment"
                    class="btn btn-primary"
                >
                    Crear Nuevo Pago
                </a>

            </td>

        </tr>

    </tbody>

</table>

</main>


<!-- include footer -->
<%- include('../../include/_footerAdmin') %>
<!-- /include footer -->