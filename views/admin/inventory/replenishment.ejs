<%- include('../../include/_headerAdmin') %>

<main class="admin-shell admin-list-page ir-page">
    <header class="admin-list-heading admin-page-header ir-heading">
        <div>
            <p class="admin-list-eyebrow">Inventario y compras</p>
            <h1><span class="ir-heading__icon" aria-hidden="true"><i class="bi bi-basket2"></i></span>Reposición guiada</h1>
            <p class="admin-list-description">
                Revisa qué productos conviene reponer según sus ventas de los últimos
                <strong><%= resumen.diasVentas %> días</strong>, el stock mínimo y el plazo del proveedor.
            </p>
        </div>

        <nav class="ir-actions" aria-label="Acciones de inventario">
            <% if (can('inventory:read')) { %>
                <a class="ir-action ir-action--secondary admin-button admin-button--secondary" href="/read-Stock">
                    <i class="bi bi-box-seam" aria-hidden="true"></i>
                    Control de stock
                </a>
            <% } %>
            <a class="ir-action ir-action--primary admin-button admin-button--primary" href="/inventory/movements">
                <i class="bi bi-clock-history" aria-hidden="true"></i>
                Historial de movimientos
            </a>
        </nav>
    </header>

    <section class="admin-stat-grid ir-stats" aria-label="Resumen de reposición">
        <article class="admin-stat ir-stat">
            <span class="ir-stat__icon" aria-hidden="true"><i class="bi bi-boxes"></i></span>
            <span class="admin-stat__label">Productos evaluados</span>
            <strong class="admin-stat__value"><%= resumen.productos %></strong>
            <p>Productos incluidos en el análisis de inventario.</p>
        </article>

        <article class="admin-stat ir-stat ir-stat--attention">
            <span class="ir-stat__icon" aria-hidden="true"><i class="bi bi-cart-plus"></i></span>
            <span class="admin-stat__label">Con compra sugerida</span>
            <strong class="admin-stat__value"><%= resumen.sugerencias %></strong>
            <p>Requieren cubrir el mínimo y la demanda durante la entrega.</p>
        </article>

        <article class="admin-stat ir-stat ir-stat--pending">
            <span class="ir-stat__icon" aria-hidden="true"><i class="bi bi-truck"></i></span>
            <span class="admin-stat__label">Pendientes de configurar</span>
            <strong class="admin-stat__value"><%= resumen.pendientesConfiguracion %></strong>
            <p>Sin proveedor asignado o sin plazo de entrega definido.</p>
        </article>
    </section>

    <aside class="ir-method" aria-labelledby="ir-method-title">
        <span class="ir-method__icon" aria-hidden="true"><i class="bi bi-calculator"></i></span>
        <div>
            <h2 id="ir-method-title">Cómo se calcula la sugerencia</h2>
            <p class="ir-method__formula">
                Compra sugerida = máximo entre 0 y (mínimo + demanda durante la entrega − stock actual)
            </p>
            <p class="ir-method__note">
                La demanda usa el promedio diario de ventas pagadas y se redondea hacia arriba.
                Esta pantalla orienta la compra; no genera órdenes automáticamente.
            </p>
        </div>
    </aside>

    <section class="ir-results" aria-labelledby="ir-results-title">
        <header class="ir-results__heading">
            <div>
                <p class="admin-list-eyebrow">Detalle del inventario</p>
                <h2 id="ir-results-title">Recomendaciones de compra</h2>
            </div>
            <% if (pagination.totalItems > 0) { %>
                <span class="ir-results__count">
                    <strong><%= pagination.totalItems %></strong>
                    <%= pagination.totalItems === 1 ? 'producto' : 'productos' %>
                </span>
            <% } %>
        </header>

        <% if (items.length) { %>
            <div class="ir-table-scroll" role="region" aria-label="Tabla de recomendaciones de reposición" tabindex="0">
                <table class="table ir-table admin-table">
                    <thead>
                        <tr>
                            <th scope="col">Producto</th>
                            <th scope="col">Stock actual</th>
                            <th scope="col">Mínimo</th>
                            <th scope="col">Ventas</th>
                            <th scope="col">Promedio diario</th>
                            <th scope="col">Proveedor y entrega</th>
                            <th scope="col">Nivel sugerido</th>
                            <th scope="col">Compra recomendada</th>
                            <th scope="col"><span class="visually-hidden">Acción</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        <% items.forEach(item => { %>
                            <tr>
                                <td data-label="Producto">
                                    <div class="ir-product">
                                        <span class="ir-product__icon" aria-hidden="true"><i class="bi bi-box"></i></span>
                                        <div class="ir-product__details">
                                            <strong><%= item.producto.nombre %></strong>
                                            <% if (can('catalog:write')) { %>
                                                <a href="/update-producto/<%= item.producto._id %>">Configurar mínimo o proveedor</a>
                                            <% } %>
                                        </div>
                                    </div>
                                </td>
                                <td data-label="Stock actual">
                                    <strong class="ir-number <%= item.stock <= item.stockMinimo ? 'ir-number--low' : '' %>"><%= item.stock %></strong>
                                    <span class="ir-unit">unidades</span>
                                </td>
                                <td data-label="Mínimo"><%= item.stockMinimo %> <span class="ir-unit">unidades</span></td>
                                <td data-label="Ventas">
                                    <strong><%= item.unidadesVendidas %></strong>
                                    <span class="ir-unit">unidades / <%= resumen.diasVentas %> días</span>
                                </td>
                                <td data-label="Promedio diario">
                                    <strong><%= item.promedioDiario.toFixed(2) %></strong>
                                    <span class="ir-unit">unidades / día</span>
                                </td>
                                <td data-label="Proveedor y entrega">
                                    <% if (item.producto.proveedor) { %>
                                        <strong class="ir-supplier-name"><%= item.producto.proveedor.nombre %></strong>
                                        <% if (item.diasEntrega === null) { %>
                                            <span class="ir-status ir-status--pending">Plazo sin configurar</span>
                                            <% if (can('providers:manage')) { %>
                                                <a class="ir-cell-link" href="/update-proveedor?id=<%= item.producto.proveedor._id %>">Configurar proveedor</a>
                                            <% } %>
                                        <% } else { %>
                                            <span class="ir-unit">Entrega: <%= item.diasEntrega %> días</span>
                                        <% } %>
                                    <% } else { %>
                                        <span class="ir-status ir-status--pending">Sin proveedor asignado</span>
                                        <% if (can('catalog:write')) { %>
                                            <a class="ir-cell-link" href="/update-producto/<%= item.producto._id %>">Asignar proveedor</a>
                                        <% } %>
                                    <% } %>
                                </td>
                                <td data-label="Nivel sugerido">
                                    <% if (item.nivelReposicion === null) { %>
                                        <span class="ir-unit">Pendiente</span>
                                    <% } else { %>
                                        <strong><%= item.nivelReposicion %></strong>
                                        <span class="ir-unit">unidades</span>
                                    <% } %>
                                </td>
                                <td data-label="Compra recomendada">
                                    <% if (item.cantidadSugerida === null) { %>
                                        <span class="ir-status ir-status--pending">Configura el plazo</span>
                                    <% } else if (item.cantidadSugerida > 0) { %>
                                        <span class="ir-status ir-status--buy">Comprar <%= item.cantidadSugerida %> unidades</span>
                                    <% } else { %>
                                        <span class="ir-status ir-status--ok"><i class="bi bi-check-circle" aria-hidden="true"></i> Sin compra</span>
                                    <% } %>
                                </td>
                                <td class="ir-action-cell" data-label="Acción">
                                    <a class="ir-row-action" href="/inventory/movements?producto=<%= item.producto._id %>">
                                        <%= can('catalog:write') ? 'Registrar entrada' : 'Ver movimientos' %>
                                        <i class="bi bi-arrow-right" aria-hidden="true"></i>
                                    </a>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        <% } else { %>
            <div class="admin-list-empty admin-empty-state ir-empty">
                <span class="admin-empty-state__icon ir-empty__icon" aria-hidden="true"><i class="bi bi-inbox"></i></span>
                <h3 class="admin-empty-state__message">No hay productos para evaluar</h3>
                <p class="admin-empty-state__description">Cuando registres productos, aquí verás su stock, ventas recientes y la cantidad recomendada para reponer.</p>
            </div>
        <% } %>
    </section>

    <%- include('../../include/_adminPagination', { pagination, label: 'productos evaluados' }) %>
</main>

<%- include('../../include/_footerAdmin') %>
