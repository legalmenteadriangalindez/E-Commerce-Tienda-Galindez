<%- include('../../include/_headerAdmin') %>



<div class="page-wrapper">

  <div class="page-header">
    <h1>Usuarios</h1>
    <p>Crea una cuenta, asigna su contraseña inicial y envía la verificación al correo.</p>
  </div>

  <div class="form-card ui-card ui-card--form">
    <% if (error) { %>
      <p role="alert"><%= error %> Los demás datos se conservaron; vuelve a escribir la contraseña.</p>
    <% } %>

    <form action="/add-user" method="POST" class="user-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <div class="form-grid ui-form-grid">

        <!-- Nombre -->
        <div class="form-group full">
          <label for="new-user-name">Nombre completo</label>
          <input id="new-user-name" type="text" name="nombre" value="<%= values.nombre %>" maxlength="200" autocomplete="name" required>
        </div>

        <!-- Email -->
        <div class="form-group full">
          <label for="new-user-email">Correo electrónico</label>
          <input id="new-user-email" type="email" name="email" value="<%= values.email %>" maxlength="254" autocomplete="email" required>
        </div>
        <!-- Contraseña -->
        <div class="form-group full">
          <label for="admin-new-password">Contraseña inicial</label>
          <div class="password-field">
            <input
              id="admin-new-password"
              type="password"
              name="password"
              required
              minlength="12"
              maxlength="72"
              autocomplete="new-password"
              data-password-input
            >
            <button class="password-toggle" type="button" data-password-toggle aria-controls="admin-new-password" aria-label="Visibilidad de la contraseña" aria-pressed="false" hidden>
              <span data-password-toggle-label aria-hidden="true">Mostrar</span>
            </button>
          </div>
          <small>
            Usa al menos 12 caracteres. La persona verificará su correo con el código recibido y podrá cambiar esta contraseña desde el menú de su cuenta.
          </small>
        </div>
        <!-- Rol -->
        <% if (canManageRoles || canAssignDealer) { %>
          <div class="form-group">
            <label for="new-user-role">Rol</label>

            <select id="new-user-role" name="rol">
              <option value="" <%= !values.rol ? 'selected' : '' %>>Cliente (predeterminado)</option>

              <% roles.forEach(rol => { %>
                <option value="<%= rol._id %>" <%= String(rol._id) === values.rol ? 'selected' : '' %>>
                  <%= rol.nombre %>
                </option>
              <% }) %>
            </select>
            <% if (canManageRoles) { %>
              <small>La cuenta conservará este rol después de verificar el correo. Solo SuperAdmin puede crear otro SuperAdmin.</small>
            <% } else { %>
              <small>Puedes crear clientes y distribuidores. Los demás roles requieren el permiso de gestionar roles.</small>
            <% } %>
          </div>
        <% } else { %>
          <div class="form-group">
            <label for="new-user-role">Rol</label>
            <select id="new-user-role" disabled><option>Cliente</option></select>
            <small>Tu cuenta puede crear clientes. Para elegir otro rol necesitas el permiso de gestionar roles.</small>
          </div>
        <% } %>
        <!-- Teléfono -->
        <div class="form-group">
          <label for="new-user-phone">Teléfono</label>
          <input id="new-user-phone" type="tel" name="telefono" value="<%= values.telefono %>" inputmode="numeric" pattern="[0-9]{7,15}" minlength="7" maxlength="15" autocomplete="tel" required>
          <small>Entre 7 y 15 dígitos, sin espacios ni símbolos.</small>
        </div>

        <!-- Cédula opcional -->
        <div class="form-group">
          <label for="new-user-cedula">Cédula (opcional)</label>
          <input id="new-user-cedula" type="text" name="cedula" value="<%= values.cedula %>" inputmode="numeric" pattern="[0-9]{5,15}" maxlength="15" autocomplete="off">
          <small>Solo números; se utiliza para localizar ventas y pedidos.</small>
        </div>

        <!-- Género -->
        <div class="form-group">
          <label for="new-user-gender">Género (opcional)</label>
          <select id="new-user-gender" name="genero">
            <option value="">Seleccione...</option>
            <% ['Masculino', 'Femenino', 'Otro'].forEach(genero => { %>
              <option value="<%= genero %>" <%= values.genero === genero ? 'selected' : '' %>><%= genero %></option>
            <% }) %>
          </select>
        </div>

        <!-- Dirección -->
        <div class="form-group full">
          <label for="new-user-address">Dirección</label>
          <input id="new-user-address" type="text" name="direccion" value="<%= values.direccion %>" maxlength="200" required>
        </div>

        <!-- Barrio -->
        <div class="form-group">
          <label for="new-user-neighborhood">Barrio (opcional)</label>
          <input id="new-user-neighborhood" type="text" name="barrio" value="<%= values.barrio %>" maxlength="120">
        </div>

        <!-- Ciudad -->
        <div class="form-group">
          <label for="new-user-city">Ciudad (opcional)</label>
          <input id="new-user-city" type="text" name="ciudad" value="<%= values.ciudad %>" maxlength="120" placeholder="Timbío">
        </div>

        <!-- Punto de referencia -->
        <div class="form-group full">
          <label for="new-user-reference">Punto de referencia (opcional)</label>
          <input id="new-user-reference" type="text" name="puntoReferencia" value="<%= values.puntoReferencia %>" maxlength="200">
        </div>

        <!-- Estado -->
        <div class="form-group full">
          <p>El acceso quedará pendiente hasta que la persona verifique su correo. Entrará con la contraseña inicial que le entregues.</p>
        </div>

      </div>

      <div class="form-actions">
        <button type="submit">Crear usuario</button>
      </div>

    </form>

  </div>
</div>

<%- include('../../include/_footerAdmin') %>
