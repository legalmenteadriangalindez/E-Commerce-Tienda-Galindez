<%- include('../../include/_headerAdmin') %>



<div class="page-wrapper">

  <div class="page-header">
    <h1>Usuarios</h1>
    <p>Crea nuevos usuarios del sistema con sus datos de contacto</p>
  </div>

  <div class="form-card ui-card ui-card--form">

    <form action="/add-user" method="POST" class="user-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <div class="form-grid ui-form-grid">

        <!-- Nombre -->
        <div class="form-group full">
          <label>Nombre completo</label>
          <input type="text" name="nombre" required>
        </div>

        <!-- Email -->
        <div class="form-group full">
          <label>Correo electrónico</label>
          <input type="email" name="email" required>
        </div>
        <!-- Contraseña -->
        <div class="form-group full">
          <label>Contraseña</label>
          <div class="password-field">
            <input
              id="admin-new-password"
              type="password"
              name="password"
              required
              minlength="12"
              maxlength="72"
              autocomplete="new-password"
              data-password-input
            >
            <button class="password-toggle" type="button" data-password-toggle aria-controls="admin-new-password" aria-label="Visibilidad de la contraseña" aria-pressed="false" hidden>
              <span data-password-toggle-label aria-hidden="true">Mostrar</span>
            </button>
          </div>
          <small>
            La cuenta recibirá un código de verificación en este correo antes de poder iniciar sesión.
          </small>
        </div>
        <!-- Rol -->
        <% if (canManageRoles) { %>
          <div class="form-group">
            <label>Rol</label>

            <select name="rol">
              <option value="">Cliente (predeterminado)</option>

              <% roles.forEach(rol => { %>
                <option value="<%= rol._id %>">
                  <%= rol.nombre %>
                </option>
              <% }) %>
            </select>
            <small>Asignar roles requiere el permiso roles:manage. SuperAdmin solo puede asignarlo otro SuperAdmin.</small>
          </div>
        <% } %>
        <!-- Teléfono -->
        <div class="form-group">
          <label>Teléfono</label>
          <input type="text" name="telefono" required>
        </div>

        <!-- Género -->
        <div class="form-group">
          <label>Género</label>
          <select name="genero">
            <option value="">Seleccione...</option>
            <option value="Masculino">Masculino</option>
            <option value="Femenino">Femenino</option>
            <option value="Otro">Otro</option>
          </select>
        </div>

        <!-- Dirección -->
        <div class="form-group full">
          <label>Dirección</label>
          <input type="text" name="direccion" required>
        </div>

        <!-- Barrio -->
        <div class="form-group">
          <label>Barrio</label>
          <input type="text" name="barrio">
        </div>

        <!-- Ciudad -->
        <div class="form-group">
          <label>Ciudad</label>
          <input type="text" name="ciudad" value="Bogotá">
        </div>

        <!-- Punto de referencia -->
        <div class="form-group full">
          <label>Punto de referencia</label>
          <input type="text" name="puntoReferencia">
        </div>

        <!-- Estado -->
        <div class="form-group full">
          <label>Estado</label>
          <input type="text" name="estado" value="Activo" readonly>
        </div>

      </div>

      <div class="form-actions">
        <button type="submit">Crear usuario</button>
      </div>

    </form>

  </div>
</div>

<%- include('../../include/_footerAdmin') %>
