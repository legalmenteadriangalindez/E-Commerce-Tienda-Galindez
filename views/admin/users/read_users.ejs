<!-- include header -->
<%- include('../../include/_headerAdmin') %>
<!-- /include header -->


<main class="admin-shell admin-list-page">
  <header class="admin-list-heading">
    <div>
      <p class="admin-list-eyebrow">Cuentas</p>
      <h1>Gestionar usuarios</h1>
      <p class="admin-list-description">Administra cuentas, roles y estados de acceso de la tienda.</p>
    </div>
    <a href="/add-user-form" class="admin-list-primary">Crear usuario</a>
  </header>
  <% if (verificationNotice === 'sent') { %>
    <p class="admin-list-description" role="status">
      Usuario creado. Enviamos un código de verificación al correo; deberá verificarlo antes de iniciar sesión.
    </p>
  <% } else if (verificationNotice === 'failed') { %>
    <p class="admin-list-description" role="status">
      Usuario creado, pero no se pudo enviar el correo de verificación. La cuenta no podrá iniciar sesión hasta verificar el correo.
      La persona puede iniciar sesión con su contraseña inicial para solicitar otro código. También puedes abrir «Verificar correo» en la fila de su cuenta.
    </p>
  <% } %>
  <div class="admin-table-wrap ui-table-wrap admin-mobile-card-wrap">
  <table
    class="table ui-table admin-mobile-card-table admin-users-card-table"
    aria-label="Usuarios de la tienda"
  >
  <thead>
    <tr>
      <th scope="col" hidden>#</th>
      <th scope="col">nombre</th>
      <th scope="col">email</th>
      <th scope="col">rol</th>
      <th scope="col" class="admin-mobile-secondary">telefono</th>
      <th scope="col" class="admin-mobile-secondary">genero</th>
      <th scope="col" class="admin-mobile-secondary">direccion</th>
      <th scope="col" class="admin-mobile-secondary">barrio</th>
      <th scope="col" class="admin-mobile-secondary">ciudad</th>
      <th scope="col" class="admin-mobile-secondary">punto de Referencia</th>
      <th scope="col" class="admin-mobile-secondary">ubicacion</th>
      <th scope="col">estado</th>
      <th scope="col">Correo verificado</th>
      <th scope="col" class="admin-mobile-secondary">fecha de Registro</th>
      <th scope="col">Editar</th>
      <th scope="col">Eliminar</th>
    </tr>
  </thead>
  <tbody>
    <% users.forEach(function(user) { %>
    <tr>
      <th scope="row" hidden><%= user.id %></th>
      <td data-label="Nombre"><%= user.nombre %></td>
      <td data-label="Correo"><%= user.email %></td>
      <td data-label="Rol"><%= user.rol ? user.rol.nombre : "" %></td>
      <td data-label="Teléfono" class="admin-mobile-secondary"><%= user.telefono %></td>
      <td data-label="Género" class="admin-mobile-secondary"><%= user.genero %></td>
      <td data-label="Dirección" class="admin-mobile-secondary"><%= user.direccion %></td>
      <td data-label="Barrio" class="admin-mobile-secondary"><%= user.barrio %></td>
      <td data-label="Ciudad" class="admin-mobile-secondary"><%= user.ciudad %></td>
      <td data-label="Punto de referencia" class="admin-mobile-secondary"><%= user.puntoReferencia %></td>
      <td data-label="Ubicación" class="admin-mobile-secondary"><%= user.ubicacion ? user.ubicacion.lat + ", " + user.ubicacion.lng : "" %></td>
      <td data-label="Estado"><%= user.estado %></td>
      <td data-label="Correo verificado">
        <% if (user.verified) { %>
          Verificado
        <% } else { %>
          Pendiente de verificación<br>
          <a href="/verify-email?email=<%= encodeURIComponent(user.email) %>">Verificar correo</a>
        <% } %>
      </td>
      <td data-label="Registro" class="admin-mobile-secondary"><%= user.fechaRegistro %></td>
      <td data-label="Editar"><a href="/update-user/<%= user._id %>" class="btn btn-warning">Editar</a></td>
      <td data-label="Eliminar">
        <form action="/delete-user/<%= user._id %>" method="POST">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button type="submit" class="btn btn-danger">Eliminar</button>
        </form>
      </td>
    </tr>
    <% }); %>
  </tbody>
</table>
  </div>
  <% if (!users.length) { %>
    <p class="admin-list-empty">No hay usuarios activos registrados.</p>
  <% } %>
  <%- include('../../include/_adminPagination', { pagination, label: 'usuarios' }) %>

</main>


<!-- include footer -->
<%- include('../../include/_footerAdmin') %>
<!-- /include footer -->
