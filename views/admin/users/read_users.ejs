<!-- include header -->
<%- include('../../include/_headerAdmin') %>
<!-- /include header -->


<main class="admin-list-page">
  <header class="admin-list-heading">
    <div>
      <p class="admin-list-eyebrow">Cuentas</p>
      <h1>Gestionar usuarios</h1>
      <p class="admin-list-description">Administra cuentas, roles y estados de acceso de la tienda.</p>
    </div>
    <a href="/add-user-form" class="admin-list-primary">Crear usuario</a>
  </header>
  <div class="admin-table-wrap ui-table-wrap">
     <table class="table ui-table">
  <thead>
    <tr>
      <th scope="col" hidden>#</th>
      <th scope="col">nombre</th>
      <th scope="col">email</th>
      <th scope="col">rol</th>
      <th scope="col">telefono</th>
      <th scope="col">genero</th>
      <th scope="col">direccion</th>
      <th scope="col">barrio</th>
      <th scope="col">ciudad</th>
      <th scope="col">punto de Referencia</th>
      <th scope="col">ubicacion</th>
      <th scope="col">estado</th>
      <th scope="col">fecha de Registro</th>
      <th scope="col">Editar</th>
      <th scope="col">Eliminar</th>
    </tr>
  </thead>
  <tbody>
    <% users.forEach(function(user) { %>
    <tr>
      <th scope="row" hidden><%= user.id %></th>
      <td><%= user.nombre %></td>
      <td><%= user.email %></td>
      <td><%= user.rol ? user.rol.nombre : "" %></td>
      <td><%= user.telefono %></td>
      <td><%= user.genero %></td>
      <td><%= user.direccion %></td>
      <td><%= user.barrio %></td>
      <td><%= user.ciudad %></td>
      <td><%= user.puntoReferencia %></td>
      <td><%= user.ubicacion ? user.ubicacion.lat + ", " + user.ubicacion.lng : "" %></td>
      <td><%= user.estado %></td>
      <td><%= user.fechaRegistro %></td>
      <td><a href="/update-user/<%= user._id %>" class="btn btn-warning">Editar</a></td>
      <td>
        <form action="/delete-user/<%= user._id %>" method="POST" class="d-inline">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button type="submit" class="btn btn-danger">Eliminar</button>
        </form>
      </td>
    </tr>
    <% }); %>
  </tbody>
</table>
  </div>
  <% if (!users.length) { %>
    <p class="admin-list-empty">No hay usuarios activos registrados.</p>
  <% } %>
  <%- include('../../include/_adminPagination', { pagination, label: 'usuarios' }) %>

</main>


<!-- include footer -->
<%- include('../../include/_footerAdmin') %>
<!-- /include footer -->
