<%- include('../../include/_headerAdmin') %>
<link rel="stylesheet" href="/css/raffle.css">

<main class="raffle-admin-page">
    <section class="raffle-admin-heading">
        <div>
            <p class="raffle-eyebrow">Promociones de la tienda</p>
            <h1>Sorteo de regalos</h1>
            <p>Configura el monto mínimo y administra las participaciones generadas por pedidos pagados.</p>
        </div>
        <a class="raffle-back-link" href="/admin-analytics">Volver al informe</a>
    </section>

    <% if (raffleNotice) { %>
        <p class="commerce-notice" role="status"><%= raffleNotice %></p>
    <% } %>

    <section class="raffle-admin-grid">
        <article class="commerce-card">
            <h2>Configuración</h2>
            <% if (!isCurrentRound || raffle.estadoRonda === 'FINALIZADA') { %>
                <p class="raffle-pagination-help">Esta ronda es histórica o finalizada y está protegida contra cambios.</p>
            <% } else { %>
            <form action="/admin/raffle" method="post" enctype="multipart/form-data">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                <label class="raffle-field raffle-toggle">
                    <input type="checkbox" name="activo" value="si" <%= raffle.activo ? 'checked' : '' %>>
                    <span>Rifa activa</span>
                </label>

                <label class="raffle-field">
                    <span>Monto mínimo de compra (COP)</span>
                    <input type="number" name="montoMinimo" min="0" max="100000000" step="100" required value="<%= raffle.montoMinimo %>">
                    <small>Se calcula con el total pagado del pedido.</small>
                </label>

                <label class="raffle-field">
                    <span>Título del premio</span>
                    <input type="text" name="titulo" maxlength="120" required value="<%= raffle.titulo %>">
                </label>

                <label class="raffle-field">
                    <span>Descripción</span>
                    <textarea name="descripcion" maxlength="500" rows="4" required><%= raffle.descripcion %></textarea>
                </label>

                <label class="raffle-field">
                    <span>Imagen de la promoción</span>
                    <input type="file" name="imagenPremio" accept="image/jpeg,image/png,image/webp">
                    <small>Dimensiones recomendadas: 600 × 900 px, orientación vertical (relación 2:3). JPG, PNG o WEBP, máximo 2 MB.</small>
                </label>

                <% if (raffle.imagenUrl) { %>
                    <div class="raffle-image-preview">
                        <img src="<%= raffle.imagenUrl %>" alt="Imagen actual de la promoción">
                        <label><input type="checkbox" name="quitarImagen" value="si"> Quitar imagen actual</label>
                    </div>
                <% } %>

                <button type="submit">Guardar configuración</button>
            </form>
            <% } %>
        </article>

        <article class="commerce-card">
            <h2>Estado del sorteo</h2>
            <dl class="raffle-summary">
                <div><dt>Ronda</dt><dd>#<%= raffle.numeroRonda %></dd></div>
                <div><dt>Estado</dt><dd><%= raffle.estadoRonda === 'FINALIZADA' ? 'Finalizada' : raffle.activo ? 'Activa' : 'Inactiva' %></dd></div>
                <div><dt>Participaciones</dt><dd><%= pagination.totalItems %></dd></div>
                <div><dt>Próximo número</dt><dd><%= raffle.siguienteNumero %></dd></div>
                <div><dt>Ganador</dt><dd><%= raffle.ganador?.numero ? 'Número ' + raffle.ganador.numero : 'Pendiente' %></dd></div>
            </dl>

            <% if (raffle.ganador?.numero) { %>
                <p class="commerce-notice">La participación ganadora es el número <strong><%= raffle.ganador.numero %></strong>. Revisa al cliente en la tabla.</p>
            <% } else if (isCurrentRound && raffle.estadoRonda === 'ACTIVA' && entries.length) { %>
                <form action="/admin/raffle/draw" method="post">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <label class="raffle-confirm"><input type="checkbox" name="confirmar" value="si" required> Confirmo que voy a seleccionar un ganador al azar.</label>
                    <button type="submit">Seleccionar ganador</button>
                </form>
            <% } else { %>
                <p>Aún no hay compras pagadas que cumplan el monto mínimo.</p>
            <% } %>

            <% if (isCurrentRound && (entries.length || raffle.ganador?.numero)) { %>
                <form action="/admin/raffle/reset" method="post" class="raffle-reset-form">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <label class="raffle-confirm"><input type="checkbox" name="confirmar" value="si" required> Confirmo que iniciaré una nueva ronda. Las participaciones actuales se conservarán en el historial.</label>
                    <button type="submit" class="raffle-danger">Reiniciar rifa</button>
                </form>
            <% } %>
        </article>
    </section>

    <section class="commerce-card">
        <div class="raffle-entries-heading">
            <div>
                <h2>Participaciones</h2>
                <p class="raffle-pagination-help">Ronda #<%= raffle.numeroRonda %>. Las rondas anteriores permanecen disponibles en modo de solo lectura.</p>
            </div>
            <form class="raffle-page-size" method="get" action="/admin/raffle">
                <input type="hidden" name="ronda" value="<%= selectedRoundId %>">
                <label for="raffle-limit">Filas por página</label>
                <select id="raffle-limit" name="limit">
                    <% for (const pageSize of [10, 25, 50]) { %>
                        <option value="<%= pageSize %>" <%= Number(pagination.limit) === pageSize ? 'selected' : '' %>><%= pageSize %></option>
                    <% } %>
                </select>
                <button type="submit">Aplicar</button>
            </form>
        </div>
        <% if (!entries.length) { %>
            <p>No hay participaciones todavía.</p>
        <% } else { %>
            <div class="raffle-table-wrap">
                <table class="raffle-table">
                    <thead><tr><th>Número</th><th>Cliente</th><th>Pedido</th><th>Monto</th><th>Estado</th></tr></thead>
                    <tbody>
                    <% entries.forEach(entry => { %>
                        <tr>
                            <td><strong><%= entry.numero %></strong></td>
                            <td><%= entry.clienteNombre %><br><small><%= entry.clienteEmail %></small></td>
                            <td><%= entry.order?.numeroOrden || 'Pedido histórico' %></td>
                            <td>$ <%= Number(entry.montoCompra).toLocaleString('es-CO') %></td>
                            <td><%= entry.ganador ? 'Ganador' : 'Participante' %></td>
                        </tr>
                    <% }) %>
                    </tbody>
                </table>
            </div>
        <% } %>
        <%- include('../../include/_adminPagination', { pagination, label: 'participaciones' }) %>
    </section>

    <% if (rounds && rounds.length > 1) { %>
        <section class="commerce-card">
            <h2>Historial de rondas</h2>
            <p class="raffle-pagination-help">Las participaciones y resultados de una ronda finalizada no se modifican al iniciar la siguiente.</p>
            <div class="raffle-round-history">
                <% rounds.forEach(round => { %>
                    <a class="raffle-round-history__item <%= String(round._id) === String(selectedRoundId) ? 'is-current' : '' %>" href="/admin/raffle?ronda=<%= round._id %>">
                        <strong>Ronda #<%= round.numeroRonda %></strong>
                        <span><%= round.estadoRonda === 'FINALIZADA' ? 'Finalizada' : round.activo ? 'Activa' : 'Inactiva' %> · <%= round.totalEntries %> participaciones</span>
                        <% if (round.ganador?.numero) { %><span>Ganador #<%= round.ganador.numero %></span><% } %>
                    </a>
                <% }) %>
            </div>
        </section>
    <% } %>
</main>
<%- include('../../include/_footerAdmin') %>
