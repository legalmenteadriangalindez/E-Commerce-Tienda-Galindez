<article class="raffle-panel raffle-panel--status">
    <header class="raffle-panel__heading">
        <span class="raffle-panel__icon" aria-hidden="true"><i class="bi bi-clipboard-data"></i></span>
        <div>
            <p class="admin-list-eyebrow">Seguimiento</p>
            <h2>Estado del sorteo</h2>
        </div>
    </header>
    <dl class="raffle-summary">
        <div><dt>Ronda</dt><dd>#<%= raffle.numeroRonda %></dd></div>
        <div><dt>Estado</dt><dd><span class="raffle-state <%= raffle.estadoRonda === 'FINALIZADA' ? 'raffle-state--finished' : raffle.activo ? 'raffle-state--active' : 'raffle-state--inactive' %>"><%= raffle.estadoRonda === 'FINALIZADA' ? 'Finalizada' : raffle.activo ? 'Activa' : 'Inactiva' %></span></dd></div>
        <div><dt>Participaciones</dt><dd><%= pagination.totalItems %></dd></div>
        <div><dt>Próximo número</dt><dd><%= raffle.siguienteNumero %></dd></div>
        <div><dt>Ganador</dt><dd><%= raffle.ganador?.numero ? 'Número ' + raffle.ganador.numero : 'Pendiente' %></dd></div>
    </dl>
    <% if (raffle.ganador?.numero) { %>
        <p class="raffle-notice raffle-notice--winner" role="status"><i class="bi bi-trophy" aria-hidden="true"></i>La participación ganadora es el número <strong><%= raffle.ganador.numero %></strong>. Revisa al cliente en la tabla.</p>
    <% } else if (isCurrentRound && raffle.estadoRonda === 'ACTIVA' && entries.length) { %>
        <form action="/admin/raffle/draw" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label class="raffle-confirm"><input type="checkbox" name="confirmar" value="si" required> Confirmo que voy a seleccionar un ganador al azar.</label><button class="raffle-button raffle-button--primary" type="submit"><i class="bi bi-shuffle" aria-hidden="true"></i>Seleccionar ganador</button></form>
    <% } else { %><p class="raffle-empty">Aún no hay compras pagadas que cumplan el monto mínimo.</p><% } %>
    <% if (isCurrentRound && (entries.length || raffle.ganador?.numero)) { %>
        <form action="/admin/raffle/reset" method="post" class="raffle-reset-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label class="raffle-confirm"><input type="checkbox" name="confirmar" value="si" required> Confirmo que iniciaré una nueva ronda. Las participaciones actuales se conservarán en el historial.</label><button type="submit" class="raffle-button raffle-button--danger"><i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i>Reiniciar rifa</button></form>
    <% } %>
</article>
