<article class="commerce-card">
    <h2>Estado del sorteo</h2>
    <dl class="raffle-summary">
        <div><dt>Ronda</dt><dd>#<%= raffle.numeroRonda %></dd></div>
        <div><dt>Estado</dt><dd><%= raffle.estadoRonda === 'FINALIZADA' ? 'Finalizada' : raffle.activo ? 'Activa' : 'Inactiva' %></dd></div>
        <div><dt>Participaciones</dt><dd><%= pagination.totalItems %></dd></div>
        <div><dt>Próximo número</dt><dd><%= raffle.siguienteNumero %></dd></div>
        <div><dt>Ganador</dt><dd><%= raffle.ganador?.numero ? 'Número ' + raffle.ganador.numero : 'Pendiente' %></dd></div>
    </dl>
    <% if (raffle.ganador?.numero) { %>
        <p class="commerce-notice">La participación ganadora es el número <strong><%= raffle.ganador.numero %></strong>. Revisa al cliente en la tabla.</p>
    <% } else if (isCurrentRound && raffle.estadoRonda === 'ACTIVA' && entries.length) { %>
        <form action="/admin/raffle/draw" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label class="raffle-confirm"><input type="checkbox" name="confirmar" value="si" required> Confirmo que voy a seleccionar un ganador al azar.</label><button type="submit">Seleccionar ganador</button></form>
    <% } else { %><p>Aún no hay compras pagadas que cumplan el monto mínimo.</p><% } %>
    <% if (isCurrentRound && (entries.length || raffle.ganador?.numero)) { %>
        <form action="/admin/raffle/reset" method="post" class="raffle-reset-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label class="raffle-confirm"><input type="checkbox" name="confirmar" value="si" required> Confirmo que iniciaré una nueva ronda. Las participaciones actuales se conservarán en el historial.</label><button type="submit" class="raffle-danger">Reiniciar rifa</button></form>
    <% } %>
</article>
