<form class="raffle-page-size" method="get" action="/admin/raffle">
    <input type="hidden" name="ronda" value="<%= selectedRoundId %>">
    <label for="raffle-limit">Filas por página</label>
    <select id="raffle-limit" name="limit"><% for (const pageSize of [10, 25, 50]) { %><option value="<%= pageSize %>" <%= Number(pagination.limit) === pageSize ? 'selected' : '' %>><%= pageSize %></option><% } %></select>
    <button type="submit">Aplicar</button>
</form>
