<%- include('../../include/_headerAdmin') %>

<div class="page-wrapper">
  <div class="page-header">
    <h1>Proveedores</h1>
    <p>Registra nuevos proveedores para gestionar tu cadena de suministro</p>
  </div>

  <div class="form-card ui-card ui-card--form">
    <form action="/create-proveedor" method="POST" class="provider-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <div class="form-grid ui-form-grid">
        <div class="form-group full">
          <label for="provider-name">Nombre del proveedor</label>
          <input id="provider-name" type="text" name="nombre" required>
        </div>

        <div class="form-group">
          <label for="provider-contact">Persona de contacto</label>
          <input id="provider-contact" type="text" name="contacto">
        </div>

        <div class="form-group">
          <label for="provider-phone">Teléfono</label>
          <input id="provider-phone" type="text" name="telefono">
        </div>

        <div class="form-group">
          <label for="provider-lead-days">Plazo de entrega (días)</label>
          <input
            id="provider-lead-days"
            type="number"
            name="diasEntrega"
            min="0"
            max="365"
            step="1"
            required
          >
          <small>Días calendario desde que se solicita hasta que se recibe el producto.</small>
        </div>

        <div class="form-group">
          <label for="provider-email">Email</label>
          <input id="provider-email" type="email" name="email">
        </div>

        <div class="form-group full">
          <label for="provider-address">Dirección</label>
          <input id="provider-address" type="text" name="direccion">
        </div>

        <div class="form-group full">
          <label for="provider-description">Descripción</label>
          <textarea id="provider-description" name="descripcion" rows="3" placeholder="Ej: Proveedor de tecnología"></textarea>
        </div>
      </div>

      <div class="form-actions">
        <button type="submit">Guardar proveedor</button>
      </div>
    </form>
  </div>
</div>

<%- include('../../include/_footerAdmin') %>
