<!-- include header -->
<%- include('../../include/_headerAdmin') %>
<!-- /include header -->



<main class="admin-shell admin-list-page">
  <%- include('../../include/_adminPageHeader', {
    eyebrow: 'Operación',
    title: 'Gestionar proveedores',
    description: 'Consulta y actualiza los datos de contacto de tus proveedores.',
    actionHref: '/create-proveedor',
    actionLabel: 'Crear proveedor'
  }) %>
  <div class="admin-card admin-table-wrap ui-table-wrap">
  <table class="table ui-table admin-table">
    <thead>
      <tr>
        <th scope="col" hidden>#</th>
        <th scope="col">Nombre</th>
        <th scope="col">Teléfono</th>
        <th scope="col">Entrega (días)</th>
        <th scope="col">Dirección</th>
        <th scope="col">Descripcion</th>
        <th scope="col">Editar</th>
        <th scope="col">Eliminar</th>
      </tr>
    </thead>
    <tbody>
      <% providers.forEach(function(provider) { %>
      <tr>
        <th scope="row" hidden><%= provider._id %></th>
        <td><%= provider.nombre %></td>
        <td><%= provider.telefono %></td>
        <td><%= Number.isInteger(provider.diasEntrega) ? provider.diasEntrega : 'Sin configurar' %></td>
        <td><%= provider.direccion %></td>
        <td><%= provider.descripcion %></td>
        <td>
          <a href="/update-proveedor?id=<%= provider._id %>" class="btn btn-success admin-button admin-button--primary">Editar</a>
        </td>

        <td>
          <form action="/delete-proveedor/<%= provider._id %>" method="POST" class="d-inline">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button type="submit" class="btn btn-danger admin-button admin-button--danger">Eliminar</button>
          </form>
        </td>
      </tr>
      <% }); %>
    </tbody>
  </table>
  </div>
  <%- include('../../include/_adminEmptyState', {
    show: !providers.length,
    message: 'No hay proveedores registrados.'
  }) %>
  <%- include('../../include/_adminPagination', { pagination, label: 'proveedores' }) %>

</main>

<!-- include footer -->
<%- include('../../include/_footerAdmin') %>
<!-- /include footer -->
