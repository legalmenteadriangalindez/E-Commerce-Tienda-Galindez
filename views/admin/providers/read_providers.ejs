<!-- include header -->
<%- include('../../include/_headerAdmin') %>
<!-- /include header -->



<main class="admin-list-page">
  <header class="admin-list-heading">
    <div>
      <p class="admin-list-eyebrow">Operación</p>
      <h1>Gestionar proveedores</h1>
      <p class="admin-list-description">Consulta y actualiza los datos de contacto de tus proveedores.</p>
    </div>
    <a href="/create-proveedor" class="admin-list-primary">Crear proveedor</a>
  </header>
  <div class="admin-table-wrap ui-table-wrap">
  <table class="table ui-table">
    <thead>
      <tr>
        <th scope="col" hidden>#</th>
        <th scope="col">Nombre</th>
        <th scope="col">Teléfono</th>
        <th scope="col">Dirección</th>
        <th scope="col">Descripcion</th>
        <th scope="col">Editar</th>
        <th scope="col">Eliminar</th>
      </tr>
    </thead>
    <tbody>
      <% providers.forEach(function(provider) { %>
      <tr>
        <th scope="row" hidden><%= provider._id %></th>
        <td><%= provider.nombre %></td>
        <td><%= provider.telefono %></td>
        <td><%= provider.direccion %></td>
        <td><%= provider.descripcion %></td>
        <td>
          <a href="/update-proveedor?id=<%= provider._id %>" class="btn btn-success">Editar</a>
        </td>

        <td>
          <form action="/delete-proveedor/<%= provider._id %>" method="POST" class="d-inline">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button type="submit" class="btn btn-danger">Eliminar</button>
          </form>
        </td>
      </tr>
      <% }); %>
    </tbody>
  </table>
  </div>
  <% if (!providers.length) { %>
    <p class="admin-list-empty">No hay proveedores registrados.</p>
  <% } %>
  <%- include('../../include/_adminPagination', { pagination, label: 'proveedores' }) %>

</main>

<!-- include footer -->
<%- include('../../include/_footerAdmin') %>
<!-- /include footer -->
