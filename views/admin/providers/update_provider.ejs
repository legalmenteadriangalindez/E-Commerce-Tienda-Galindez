<%- include('../../include/_headerAdmin') %>

<div class="page-wrapper">
  <div class="page-header">
    <h1>Editar Proveedor</h1>
    <p>Actualiza la información del proveedor registrado</p>
  </div>

  <div class="form-card ui-card ui-card--form">
    <form action="/update-proveedor/<%= provider._id %>" method="POST" class="provider-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <div class="form-grid ui-form-grid">
        <div class="form-group full">
          <label for="provider-name">Nombre del proveedor</label>
          <input id="provider-name" type="text" name="nombre" value="<%= provider.nombre %>" required>
        </div>

        <div class="form-group">
          <label for="provider-phone">Teléfono</label>
          <input id="provider-phone" type="text" name="telefono" value="<%= provider.telefono %>">
        </div>

        <div class="form-group">
          <label for="provider-address">Dirección</label>
          <input id="provider-address" type="text" name="direccion" value="<%= provider.direccion %>">
        </div>

        <div class="form-group">
          <label for="provider-lead-days">Plazo de entrega (días)</label>
          <input
            id="provider-lead-days"
            type="number"
            name="diasEntrega"
            value="<%= provider.diasEntrega ?? '' %>"
            min="0"
            max="365"
            step="1"
            required
          >
          <small>Días calendario desde que se solicita hasta que se recibe el producto.</small>
        </div>

        <div class="form-group full">
          <label for="provider-description">Descripción</label>
          <textarea
            id="provider-description"
            name="descripcion"
            rows="3"
            placeholder="Ej: Proveedor de tecnología"
          ><%= provider.descripcion || '' %></textarea>
        </div>
      </div>

      <div class="form-actions">
        <button type="submit">Actualizar proveedor</button>
      </div>
    </form>
  </div>
</div>

<%- include('../../include/_footerAdmin') %>
