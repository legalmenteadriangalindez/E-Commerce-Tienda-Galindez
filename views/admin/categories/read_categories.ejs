<!-- include header -->
<%- include('../../include/_headerAdmin') %>
<!-- /include header -->



<main class="admin-shell admin-list-page">
  <%- include('../../include/_adminPageHeader', {
    eyebrow: 'Catálogo',
    title: 'Gestionar categorías',
    description: 'Organiza los productos para que el catálogo sea fácil de explorar.',
    actionHref: '/create-categoria',
    actionLabel: 'Crear categoría'
  }) %>
  <div class="admin-card admin-table-wrap ui-table-wrap">
  <table class="table ui-table admin-table">
    <thead>
      <tr>
        <th scope="col" hidden>#</th>
        <th scope="col">Nombre</th>
        <th scope="col">Editar</th>
        <th scope="col">Eliminar</th>
      </tr>
    </thead>
    <tbody>
      <% categories.forEach(function(category) { %>
      <tr>
        <th scope="row" hidden><%= category._id %></th>
        <td><%= category.nombre %></td>

        <td>
          <a href="/update-categoria?id=<%= category._id %>" class="btn btn-success admin-button admin-button--primary">Editar</a>
        </td>

        <td>
          <form action="/delete-categoria/<%= category._id %>" method="POST" class="d-inline">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button type="submit" class="btn btn-danger admin-button admin-button--danger">Eliminar</button>
          </form>
        </td>
      </tr>
      <% }); %>
    </tbody>
  </table>
  </div>
  <%- include('../../include/_adminEmptyState', {
    show: !categories.length,
    message: 'No hay categorías registradas.'
  }) %>
  <%- include('../../include/_adminPagination', { pagination, label: 'categorías' }) %>

</main>



<!-- include footer -->
<%- include('../../include/_footerAdmin') %>
<!-- /include footer -->
