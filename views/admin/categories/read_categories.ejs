<!-- include header -->
<%- include('../../include/_headerAdmin') %>
<!-- /include header -->

<link rel="stylesheet" href="/assets/css/read_categories.css">


<main class="admin-list-page">
  <header class="admin-list-heading">
    <div>
      <p class="admin-list-eyebrow">Catálogo</p>
      <h1>Gestionar categorías</h1>
      <p class="admin-list-description">Organiza los productos para que el catálogo sea fácil de explorar.</p>
    </div>
    <a href="/create-categoria" class="admin-list-primary">Crear categoría</a>
  </header>
  <div class="admin-table-wrap">
  <table class="table">
    <thead>
      <tr>
        <th scope="col" hidden>#</th>
        <th scope="col">Nombre</th>
        <th scope="col">Editar</th>
        <th scope="col">Eliminar</th>
      </tr>
    </thead>
    <tbody>
      <% categories.forEach(function(category) { %>
      <tr>
        <th scope="row" hidden><%= category._id %></th>
        <td><%= category.nombre %></td>

        <td>
          <a href="/update-categoria?id=<%= category._id %>" class="btn btn-success">Editar</a>
        </td>

        <td>
          <form action="/delete-categoria/<%= category._id %>" method="POST" class="d-inline">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button type="submit" class="btn btn-danger">Eliminar</button>
          </form>
        </td>
      </tr>
      <% }); %>
    </tbody>
  </table>
  </div>
  <% if (!categories.length) { %>
    <p class="admin-list-empty">No hay categorías registradas.</p>
  <% } %>
  <%- include('../../include/_adminPagination', { pagination, label: 'categorías' }) %>

</main>



<!-- include footer -->
<%- include('../../include/_footerAdmin') %>
<!-- /include footer -->
