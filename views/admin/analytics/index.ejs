<%- include('../../include/_headerAdmin') %>
<main class="commerce-panel">
<h1>Resumen de ventas</h1>
<p>Datos de la base de la tienda. Se excluyen los pagos pendientes y las devoluciones totales registradas.</p>
<section class="commerce-card">
  <h2>Pedidos cobrados</h2>
  <p><strong><%= totalSales %></strong> ventas · <strong>$<%= revenue.toLocaleString('es-CO') %> COP</strong></p>
  <p>Importes totales de pedidos, incluidos envíos. No representan ganancia neta ni liquidaciones recibidas del proveedor.</p>
  <p><%= pending %> pedidos pendientes · <%= incidents %> pedidos requieren revisión</p>
  <a href="/admin/payments">Revisar pagos</a>
</section>
<section class="commerce-card">
  <h2>Productos más vendidos</h2>
  <% if (!topProducts.length) { %><p>Aún no hay ventas confirmadas.</p><% } %>
  <% topProducts.forEach(product => { %><p><strong><%= product.nombre %></strong> · <%= product.unidades %> unidades · $<%= product.ingresos.toLocaleString('es-CO') %></p><% }) %>
</section>
<section class="commerce-card">
  <h2>Existencias disponibles bajas</h2>
  <p>Hasta 20 productos con 10 unidades disponibles o menos; las reservas ya están descontadas.</p>
  <% if (!lowStock.length) { %><p>No hay alertas de stock bajo.</p><% } %>
  <% lowStock.forEach(product => { %><p><a href="/update-producto/<%= product._id %>"><%= product.nombre %></a> · <%= product.stock %> disponibles</p><% }) %>
</section>
</main>
<%- include('../../include/_footerAdmin') %>
