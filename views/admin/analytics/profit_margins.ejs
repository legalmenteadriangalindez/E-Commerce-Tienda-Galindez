<%- include('../../include/_headerAdmin') %>

<style>

    :root {
        --primary-dark: #311b14;
        --accent-orange: #d85c32;
        --warm-tan: #d58d51;
        --light: #ffffff;
        --soft-bg: #f6f3f1;
    }

    body{
        background: var(--soft-bg);
    }

    .analytics-container{
        padding: 2rem;
    }

    .page-title{
        color: var(--primary-dark);
        font-weight: 700;
        margin-bottom: 2rem;
    }

    .table-card{
        background: white;

        border-radius: 20px;

        overflow: hidden;

        box-shadow: 0 10px 30px rgba(0,0,0,.08);
    }

    .table-custom{
        margin: 0;
    }

    .table-custom thead{
        background: var(--primary-dark);
        color: white;
    }

    .table-custom th{
        border: none;
        padding: 1rem;
        font-size: .95rem;
    }

    .table-custom td{
        vertical-align: middle;
        padding: 1rem;
    }

    .product-box{
        display: flex;
        align-items: center;
        gap: 1rem;
    }

    .product-icon{
        width: 45px;
        height: 45px;

        border-radius: 12px;

        background: rgba(216,92,50,.12);

        display: flex;
        align-items: center;
        justify-content: center;

        color: var(--accent-orange);
    }

    .product-name{
        font-weight: 600;
        color: var(--primary-dark);
    }

    .profit-badge{
        background: linear-gradient(
            135deg,
            var(--accent-orange),
            var(--warm-tan)
        );

        color: white;

        padding: .5rem 1rem;

        border-radius: 50px;

        font-weight: 600;
    }

    .empty-state{
        padding: 3rem;
        text-align: center;
    }

    .empty-state i{
        font-size: 4rem;
        color: var(--warm-tan);
    }

    @media(max-width:768px){

        .analytics-container{
            padding: 1rem;
        }

        .table-custom th,
        .table-custom td{
            white-space: nowrap;
        }

    }

</style>

<div class="container-fluid analytics-container">

    <h1 class="page-title">
        <i class="bi bi-bar-chart-line-fill"></i>
        Márgenes por Producto
    </h1>

    <div class="table-card">

        <% if(products && products.length > 0){ %>

            <div class="table-responsive">

                <table class="table table-hover table-custom">

                    <thead>

                        <tr>
                            <th>Producto</th>
                            <th>Vendidos</th>
                            <th>Ingresos</th>
                            <th>Costos</th>
                            <th>Ganancias</th>
                        </tr>

                    </thead>

                    <tbody>

                        <% products.forEach(product => { %>

                            <tr>

                                <td>

                                    <div class="product-box">

                                        <div class="product-icon">
                                            <i class="bi bi-box"></i>
                                        </div>

                                        <div class="product-name">
                                            <%= product.nombre %>
                                        </div>

                                    </div>

                                </td>

                                <td>
                                    <strong>
                                        <%= product.vendidos %>
                                    </strong>
                                </td>

                                <td>
                                    $
                                    <%= product.ingresos.toLocaleString() %>
                                </td>

                                <td>
                                    $
                                    <%= product.costos.toLocaleString() %>
                                </td>

                                <td>

                                    <span class="profit-badge">

                                        $
                                        <%= product.ganancias.toLocaleString() %>

                                    </span>

                                </td>

                            </tr>

                        <% }) %>

                    </tbody>

                </table>

            </div>

        <% } else { %>

            <div class="empty-state">

                <i class="bi bi-emoji-frown"></i>

                <h4 class="mt-3">
                    No existen datos de ganancias
                </h4>

            </div>

        <% } %>

    </div>

</div>

<%- include('../../include/_footerAdmin') %>