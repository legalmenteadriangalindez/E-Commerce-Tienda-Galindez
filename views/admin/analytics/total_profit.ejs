<%- include('../../include/_headerAdmin') %>

<link rel="stylesheet" href="/css/total_profit.css">


<div class="container-fluid analytics-container">

    <h1 class="page-title">
        <i class="bi bi-cash-stack"></i>
        Ganancias Totales
    </h1>

    <div class="row g-4">

        <!-- INGRESOS -->

        <div class="col-lg-4">

            <div class="card-profit">

                <div class="card-header-custom">
                    <i class="bi bi-graph-up-arrow"></i>
                </div>

                <div class="card-body-custom">

                    <div class="profit-value">
                        $ <%= profit.ingresosTotales.toLocaleString() %>
                    </div>

                    <div class="profit-label">
                        Ingresos Totales
                    </div>

                </div>

            </div>

        </div>

        <!-- COSTOS -->

        <div class="col-lg-4">

            <div class="card-profit">

                <div class="card-header-custom">
                    <i class="bi bi-wallet2"></i>
                </div>

                <div class="card-body-custom">

                    <div class="profit-value">
                        $ <%= profit.costosTotales.toLocaleString() %>
                    </div>

                    <div class="profit-label">
                        Costos Totales
                    </div>

                </div>

            </div>

        </div>

        <!-- GANANCIAS -->

        <div class="col-lg-4">

            <div class="card-profit">

                <div class="card-header-custom">
                    <i class="bi bi-currency-dollar"></i>
                </div>

                <div class="card-body-custom">

                    <div class="profit-value">
                        $ <%= profit.gananciasTotales.toLocaleString() %>
                    </div>

                    <div class="profit-label">
                        Ganancias Totales
                    </div>

                </div>

            </div>

        </div>

    </div>

    <!-- MARGEN -->

    <div class="row mt-5">

        <div class="col-lg-12">

            <div class="card-profit">

                <div class="card-body-custom text-center">

                    <h3 class="mb-4" style="color: var(--primary-dark)">
                        Margen de Ganancia
                    </h3>

                    <div class="margin-circle">

                        <h1>
                            <%= profit.margenPorcentaje %>%
                        </h1>

                        <span>
                            Margen
                        </span>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>

<%- include('../../include/_footerAdmin') %>
