<%- include('../../include/_headerAdmin') %>

<style>

    :root {
        --primary-dark: #311b14;
        --accent-orange: #d85c32;
        --warm-tan: #d58d51;
        --light: #ffffff;
        --soft-bg: #f6f3f1;
    }

    body{
        background: var(--soft-bg);
    }

    .analytics-container{
        padding: 2rem;
    }

    .page-title{
        color: var(--primary-dark);
        font-weight: 700;
        margin-bottom: 2rem;
    }

    .card-profit{
        border: none;
        border-radius: 20px;
        overflow: hidden;

        background: white;

        box-shadow: 0 10px 30px rgba(0,0,0,.08);

        height: 100%;
    }

    .card-header-custom{
        background: linear-gradient(
            135deg,
            var(--accent-orange),
            var(--warm-tan)
        );

        color: white;

        padding: 1.5rem;
    }

    .card-header-custom i{
        font-size: 2rem;
    }

    .card-body-custom{
        padding: 2rem;
    }

    .profit-value{
        font-size: 2rem;
        font-weight: bold;
        color: var(--primary-dark);
    }

    .profit-label{
        color: #777;
        margin-top: .5rem;
    }

    .margin-circle{
        width: 180px;
        height: 180px;

        border-radius: 50%;

        background: linear-gradient(
            135deg,
            var(--accent-orange),
            var(--warm-tan)
        );

        display: flex;
        align-items: center;
        justify-content: center;

        margin: auto;

        color: white;

        flex-direction: column;

        box-shadow: 0 10px 25px rgba(0,0,0,.15);
    }

    .margin-circle h1{
        margin: 0;
        font-size: 2.8rem;
        font-weight: bold;
    }

    @media(max-width:768px){

        .analytics-container{
            padding: 1rem;
        }

        .profit-value{
            font-size: 1.5rem;
        }

        .margin-circle{
            width: 140px;
            height: 140px;
            margin-top: 2rem;
        }

        .margin-circle h1{
            font-size: 2rem;
        }

    }

</style>

<div class="container-fluid analytics-container">

    <h1 class="page-title">
        <i class="bi bi-cash-stack"></i>
        Ganancias Totales
    </h1>

    <div class="row g-4">

        <!-- INGRESOS -->

        <div class="col-lg-4">

            <div class="card-profit">

                <div class="card-header-custom">
                    <i class="bi bi-graph-up-arrow"></i>
                </div>

                <div class="card-body-custom">

                    <div class="profit-value">
                        $ <%= profit.ingresosTotales.toLocaleString() %>
                    </div>

                    <div class="profit-label">
                        Ingresos Totales
                    </div>

                </div>

            </div>

        </div>

        <!-- COSTOS -->

        <div class="col-lg-4">

            <div class="card-profit">

                <div class="card-header-custom">
                    <i class="bi bi-wallet2"></i>
                </div>

                <div class="card-body-custom">

                    <div class="profit-value">
                        $ <%= profit.costosTotales.toLocaleString() %>
                    </div>

                    <div class="profit-label">
                        Costos Totales
                    </div>

                </div>

            </div>

        </div>

        <!-- GANANCIAS -->

        <div class="col-lg-4">

            <div class="card-profit">

                <div class="card-header-custom">
                    <i class="bi bi-currency-dollar"></i>
                </div>

                <div class="card-body-custom">

                    <div class="profit-value">
                        $ <%= profit.gananciasTotales.toLocaleString() %>
                    </div>

                    <div class="profit-label">
                        Ganancias Totales
                    </div>

                </div>

            </div>

        </div>

    </div>

    <!-- MARGEN -->

    <div class="row mt-5">

        <div class="col-lg-12">

            <div class="card-profit">

                <div class="card-body-custom text-center">

                    <h3 class="mb-4" style="color: var(--primary-dark)">
                        Margen de Ganancia
                    </h3>

                    <div class="margin-circle">

                        <h1>
                            <%= profit.margenPorcentaje %>%
                        </h1>

                        <span>
                            Margen
                        </span>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>

<%- include('../../include/_footerAdmin') %>