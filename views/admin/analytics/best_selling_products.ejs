<%- include('../../include/_headerAdmin') %>

<style>
    :root {
        --primary-dark: #311b14;
        --accent-orange: #d85c32;
        --warm-tan: #d58d51;
        --soft-bg: #f6f3f1;
    }

    body {
        background: var(--soft-bg);
    }

    .analytics-container {
        padding: 2rem;
    }

    .page-title {
        color: var(--primary-dark);
        font-weight: 700;
        margin-bottom: 2rem;
    }

    .product-card {
        background: white;
        border-radius: 20px;
        padding: 1.5rem;
        box-shadow: 0 10px 30px rgba(0,0,0,.08);
        height: 100%;
    }

    .product-image {
        width: 100%;
        height: 220px;
        object-fit: contain;
        border-radius: 15px;
        background: #f5f5f5;
        margin-bottom: 1rem;
    }

    .product-name {
        color: var(--primary-dark);
        font-weight: 700;
        font-size: 1.2rem;
    }

    .sales-number {
        color: var(--accent-orange);
        font-size: 1.8rem;
        font-weight: bold;
    }

    .sales-label {
        color: #777;
    }
</style>

<div class="container-fluid analytics-container">

    <h1 class="page-title">
        <i class="bi bi-trophy"></i>
        Productos Más Vendidos
    </h1>

    <div class="row g-4">

        <% if (!products || products.length === 0) { %>

            <div class="col-12">
                <div class="alert alert-info">
                    No hay información de ventas disponible.
                </div>
            </div>

        <% } else { %>

            <% products.forEach((product, index) => { %>

                <div class="col-lg-4 col-md-6">

                    <div class="product-card">

                        <% if (product.fotos && product.fotos.length > 0) { %>

                            <img
                                src="<%= product.fotos[0] %>"
                                class="product-image"
                                alt="<%= product.nombre %>"
                            >

                        <% } else { %>

                            <div class="product-image d-flex align-items-center justify-content-center">
                                <i class="bi bi-image fs-1 text-muted"></i>
                            </div>

                        <% } %>

                        <div class="product-name">
                            #<%= index + 1 %>
                            <%= product.nombre %>
                        </div>

                        <div class="mt-3">

                            <div class="sales-number">
                                <%= product.unidadesVendidas.toLocaleString() %>
                            </div>

                            <div class="sales-label">
                                Unidades vendidas
                            </div>

                        </div>

                        <div class="mt-3">

                            <strong>
                                $ <%= product.ingresosGenerados.toLocaleString() %>
                            </strong>

                            <div class="sales-label">
                                Ingresos generados
                            </div>

                        </div>

                    </div>

                </div>

            <% }); %>

        <% } %>

    </div>

</div>

<%- include('../../include/_footerAdmin') %>