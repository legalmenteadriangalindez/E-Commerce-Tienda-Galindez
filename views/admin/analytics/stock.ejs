<%- include('../../include/_headerAdmin') %>



<div class="container-fluid stock-container">

    <div class="d-flex justify-content-between align-items-center flex-wrap mb-4">

        <div>
            <h1 class="stock-title">
                <i class="bi bi-box-seam"></i>
                Control de Stock
            </h1>

            <p class="text-muted">
                Productos agotados o por debajo del mínimo configurado
            </p>
        </div>

        <div class="d-flex flex-wrap gap-2">
            <a class="btn btn-outline-primary" href="/inventory/replenishment">Reposición guiada</a>
            <a class="btn btn-outline-secondary" href="/inventory/movements">Historial y ajustes</a>
        </div>

    </div>

    <% if (inventoryValuation) { %>
        <%- include('./partials/inventory-valuation', { inventoryValuation }) %>
    <% } %>

    <!-- RESUMEN -->

    <div class="stock-summary">

        <div class="row align-items-center">

            <div class="col-md-8">

                <p>Total de alertas</p>

                <h2>
                    <%= totalAlertas %>
                </h2>

            </div>

            <div class="col-md-4 text-md-end mt-3 mt-md-0">

                <i class="bi bi-exclamation-triangle-fill stock-empty-icon"
                  >
                </i>

            </div>

        </div>

    </div>

    <!-- TABLA -->

    <div class="table-card">

        <% if(stockAlerts.length > 0){ %>

            <div class="table-responsive">

                <table class="table table-hover table-custom">

                    <thead>

                        <tr>
                            <th>Producto</th>
                            <th>Categoría</th>
                            <th>Stock</th>
                            <th>Mínimo</th>
                            <th>Estado</th>
                            <th>Historial</th>
                        </tr>

                    </thead>

                    <tbody>

                        <% stockAlerts.forEach(producto => { %>

                            <tr>

                                <td>

                                    <div class="d-flex align-items-center gap-3">

                                        <div class="stock-icon">
                                            <i class="bi bi-box"></i>
                                        </div>

                                        <div>

                                            <div class="product-name">
                                                <%= producto.nombre %>
                                            </div>

                                        </div>

                                    </div>

                                </td>

                                <td>
                                    <%= producto.categoria %>
                                </td>

                                <td>

                                    <strong>
                                        <%= producto.stock %>
                                    </strong>

                                </td>

                                <td><%= producto.stockMinimo %></td>

                                <td>

                                    <% if(producto.estado === 'CRITICO'){ %>

                                        <span class="stock-badge badge-critical">
                                            <i class="bi bi-exclamation-octagon-fill"></i>
                                            CRÍTICO
                                        </span>

                                    <% } else { %>

                                        <span class="stock-badge badge-low">
                                            <i class="bi bi-exclamation-circle-fill"></i>
                                            BAJO
                                        </span>

                                    <% } %>

                                </td>

                            <td><a href="/inventory/movements?producto=<%= producto.id %>">Ver movimientos</a></td>

                            </tr>

                        <% }) %>

                    </tbody>

                </table>

            </div>

        <% } else { %>

            <div class="empty-state">

                <i class="bi bi-check-circle-fill"></i>

                <h4>
                    Todo el stock está correcto
                </h4>

                <p class="text-muted">
                    No existen productos con alertas actualmente.
                </p>

            </div>

        <% } %>

    </div>

    <%- include('../../include/_adminPagination', { pagination, label: 'alertas de stock' }) %>

</div>

<%- include('../../include/_footerAdmin') %>
