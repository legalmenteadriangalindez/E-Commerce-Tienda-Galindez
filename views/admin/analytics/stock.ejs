<%- include('../../include/_headerAdmin') %>



<main class="admin-shell admin-list-page stock-container">

    <header class="admin-page-header admin-list-heading stock-heading">

        <div>
            <p class="admin-page-header__eyebrow admin-list-eyebrow">Inventario</p>
            <h1 class="stock-title">
                <i class="bi bi-box-seam" aria-hidden="true"></i>
                Control de Stock
            </h1>

            <p class="admin-page-header__description admin-list-description">
                Productos agotados o por debajo del mínimo configurado
            </p>
        </div>

        <div class="stock-actions d-flex flex-wrap gap-2">
            <a class="btn btn-outline-primary admin-button admin-button--secondary" href="/inventory/replenishment">Reposición guiada</a>
            <a class="btn btn-outline-secondary admin-button admin-button--secondary" href="/inventory/movements">Historial y ajustes</a>
        </div>

    </header>

    <% if (inventoryValuation) { %>
        <%- include('./partials/inventory-valuation', { inventoryValuation }) %>
        <%- include('./partials/stock-valuation-audit', { valuationAudit, inventoryValuation, canEditProductPrices }) %>
    <% } %>

    <!-- RESUMEN -->

    <div class="stock-summary">

        <div class="row align-items-center">

            <div class="col-md-8">

                <p>Total de alertas</p>

                <h2>
                    <%= totalAlertas %>
                </h2>

            </div>

            <div class="col-md-4 text-md-end mt-3 mt-md-0">

                <i class="bi bi-exclamation-triangle-fill stock-empty-icon" aria-hidden="true"></i>

            </div>

        </div>

    </div>

    <!-- TABLA -->

    <div class="table-card">

        <% if(stockAlerts.length > 0){ %>

            <div class="table-responsive">

                <table class="table table-hover table-custom admin-table">

                    <thead>

                        <tr>
                            <th scope="col">Producto</th>
                            <th scope="col">Categoría</th>
                            <th scope="col">Stock</th>
                            <th scope="col">Mínimo</th>
                            <th scope="col">Estado</th>
                            <th scope="col">Historial</th>
                        </tr>

                    </thead>

                    <tbody>

                        <% stockAlerts.forEach(producto => { %>

                            <tr>

                                <td>

                                    <div class="d-flex align-items-center gap-3">

                                        <div class="stock-icon">
                                            <i class="bi bi-box" aria-hidden="true"></i>
                                        </div>

                                        <div>

                                            <div class="product-name">
                                                <%= producto.nombre %>
                                            </div>

                                        </div>

                                    </div>

                                </td>

                                <td>
                                    <%= producto.categoria %>
                                </td>

                                <td>

                                    <strong>
                                        <%= producto.stock %>
                                    </strong>

                                </td>

                                <td><%= producto.stockMinimo %></td>

                                <td>

                                    <% if(producto.estado === 'CRITICO'){ %>

                                        <span class="stock-badge badge-critical">
                                            <i class="bi bi-exclamation-octagon-fill" aria-hidden="true"></i>
                                            CRÍTICO
                                        </span>

                                    <% } else { %>

                                        <span class="stock-badge badge-low">
                                            <i class="bi bi-exclamation-circle-fill" aria-hidden="true"></i>
                                            BAJO
                                        </span>

                                    <% } %>

                                </td>

                            <td><a href="/inventory/movements?producto=<%= producto.id %>" aria-label="Ver movimientos de <%= producto.nombre %>">Ver movimientos</a></td>

                            </tr>

                        <% }) %>

                    </tbody>

                </table>

            </div>

        <% } else { %>

            <div class="empty-state admin-empty-state">

                <i class="bi bi-check-circle-fill admin-empty-state__icon"></i>

                <h4 class="admin-empty-state__message">
                    Todo el stock está correcto
                </h4>

                <p class="text-muted admin-empty-state__description">
                    No existen productos con alertas actualmente.
                </p>

            </div>

        <% } %>

    </div>

    <%- include('../../include/_adminPagination', { pagination, label: 'alertas de stock' }) %>

</main>

<%- include('../../include/_footerAdmin') %>
