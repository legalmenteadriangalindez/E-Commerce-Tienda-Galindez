<!-- include header -->
<%- include('../../include/_headerAdmin') %>
<!-- /include header -->

<link rel="stylesheet" href="/assets/css/read_detailsSales.css">

<main>
<div>
<h1>Detalles de la venta</h1>
<p>Las ventas confirmadas se conservan como comprobante. Consulta los pedidos para gestionar su estado.</p>
<a href="/read-sales" class="btn btn-secondary">Volver a ventas</a>
</div>
  <table class="table">
    <thead>
      <tr>
        <th scope="col" hidden>#</th>
        <th scope="col">Venta</th>
        <th scope="col">Cliente</th>
        <th scope="col">Producto</th>
        <th scope="col">Cantidad</th>
        <th scope="col">Precio Unitario</th>
        <th scope="col">Total</th>
      </tr>
    </thead>
    <tbody>
      <% detalles.forEach(function(detail) { %>
      <tr>
        <th scope="row" hidden><%= detail._id %></th>

        <td>
          <%= detail.venta ? detail.venta._id : 'N/A' %>
        </td>

        <td>
          <%= venta.cliente?.nombre || 'N/A' %>
        </td>

        <td>
          <%= detail.producto ? detail.producto.nombre : 'N/A' %>
        </td>

        <td><%= detail.cantidad %></td>
        <td>$ <%= detail.precioUnitario %></td>
        <td>$ <%= detail.cantidad * detail.precioUnitario %></td>

      </tr>
      <% }); %>
    </tbody>
  </table>

</main>


<!-- include footer -->
<%- include('../../include/_footerAdmin') %>
<!-- /include footer -->
