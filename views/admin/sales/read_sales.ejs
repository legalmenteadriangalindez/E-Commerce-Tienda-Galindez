<!-- include header -->
<%- include('../../include/_headerAdmin') %>
<!-- /include header -->

<link rel="stylesheet" href="/css/admin/sales/read_sales.css">

<main class="admin-list-page">
  <header class="admin-list-heading">
    <div>
      <p class="admin-list-eyebrow">Resultados</p>
      <h1>Gestionar ventas</h1>
      <p class="admin-list-description">Consulta las ventas confirmadas y revisa el detalle de cada operación.</p>
    </div>
  </header>
  <div class="admin-table-wrap">
  <table class="table">
    <thead>
        <tr>
            <th hidden>#</th>
            <th>Fecha</th>
            <th>Producto</th>
            <th>Cantidad</th>
            <th>Cliente</th>
            <th>Total</th>
            <th>Detalles</th>

        </tr>
    </thead>

    <tbody>

        <% sales.forEach(function(sale) { %>
        <tr>
            <th hidden>
                <%= sale._id %>
            </th>

            <!-- FECHA -->
            <td>
                <%= sale.createdAt
                    ? new Date(sale.createdAt).toLocaleDateString('es-CO')
                    : sale.fechaOrden
                        ? new Date(sale.fechaOrden).toLocaleDateString('es-CO')
                        : 'Sin fecha'
                %>
            </td>

            <!-- PRODUCTO -->
            <td>
                <% if (sale.detalles && sale.detalles.length > 0) { %>

                    <% sale.detalles.forEach(function(detalle) { %>

                        <div>
                            <%= detalle.producto ? detalle.producto.nombre : 'Sin producto' %>
                        </div>

                    <% }); %>

                <% } else { %>

                    Sin productos

                <% } %>
            </td>

            <!-- CANTIDAD -->
            <td>
                <% if (sale.detalles && sale.detalles.length > 0) { %>

                    <% sale.detalles.forEach(function(detalle) { %>

                        <div>
                            <%= detalle.cantidad || 0 %>
                        </div>

                    <% }); %>

                <% } else { %>

                    0

                <% } %>
            </td>

            <!-- CLIENTE -->
            <td>
                <%= sale.cliente?.nombre || 'Consumidor Final' %>
            </td>


            <!-- TOTAL -->
            <td>
                $ <%= sale.total %>
            </td>

            <!-- DETALLES -->
            <td>
                <a href="/sale/<%= sale._id %>" class="btn btn-info">Detalles</a>
            </td>

        </tr>

        <% }); %>

    </tbody>
</table>
  </div>
  <% if (!sales.length) { %>
    <p class="admin-list-empty">No hay ventas confirmadas registradas.</p>
  <% } %>
  <%- include('../../include/_adminPagination', { pagination, label: 'ventas' }) %>
</main>


<!-- include footer -->
<%- include('../../include/_footerAdmin') %>
<!-- /include footer -->
