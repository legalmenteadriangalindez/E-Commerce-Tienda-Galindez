<%- include('../../include/_headerAdmin') %>

<main class="admin-shell admin-list-page admin-sales-page">
  <header class="admin-list-heading">
    <div>
      <p class="admin-list-eyebrow">Resultados</p>
      <h1>Gestionar ventas</h1>
      <p class="admin-list-description">Consulta las ventas y descarga los datos para analizarlos en Excel, Power BI, Python o R.</p>
    </div>
    <a class="admin-list-primary" href="<%= exportUrl %>">
      <i class="bi bi-filetype-csv me-1"></i> Exportar CSV
    </a>
  </header>

  <%- include('./partials/export-filters', { filters, paymentStatuses, channels }) %>
  <%- include('./partials/sales-table', { sales }) %>
  <%- include('../../include/_adminPagination', { pagination, label: 'ventas' }) %>
</main>

<%- include('../../include/_footerAdmin') %>
