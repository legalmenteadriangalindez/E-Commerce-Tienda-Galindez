<section class="sales-export-panel" aria-labelledby="sales-filter-title">
    <div class="sales-export-panel__heading">
      <div>
        <p class="admin-list-eyebrow">Análisis de datos</p>
        <h2 id="sales-filter-title">Filtrar ventas antes de exportar</h2>
      </div>
      <span class="sales-export-panel__hint">Cada fila del archivo representa un producto dentro de una venta.</span>
    </div>
    <form class="sales-filters" method="get" action="/read-sales">
      <label>
        Desde
        <input type="date" name="from" value="<%= filters.from %>">
      </label>
      <label>
        Hasta
        <input type="date" name="to" value="<%= filters.to %>">
      </label>
      <label>
        Estado del pago
        <select name="estadoPago">
          <option value="">Todos</option>
          <% const statusLabels = { PAGADO: 'Pagado', PENDIENTE: 'Pendiente', FALLIDO: 'Fallido', RECHAZADO: 'Rechazado', REEMBOLSADO: 'Reembolsado' }; %>
          <% paymentStatuses.forEach(status => { %>
            <option value="<%= status %>" <%= filters.estadoPago === status ? 'selected' : '' %>><%= statusLabels[status] || status %></option>
          <% }) %>
        </select>
      </label>
      <label>
        Canal
        <select name="canal">
          <option value="">Todos</option>
          <% channels.forEach(channel => { %>
            <option value="<%= channel %>" <%= filters.canal === channel ? 'selected' : '' %>><%= channel === 'WOMPI' ? 'Wompi' : 'Caja' %></option>
          <% }) %>
        </select>
      </label>
      <div class="sales-filters__actions">
        <button class="sales-filter-button" type="submit"><i class="bi bi-funnel me-1"></i>Aplicar filtros</button>
        <a class="sales-filter-reset" href="/read-sales">Limpiar</a>
      </div>
    </form>
  </section>
