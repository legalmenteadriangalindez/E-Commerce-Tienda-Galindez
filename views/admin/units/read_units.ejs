<!-- include header -->
<%- include('../../include/_headerAdmin') %>
<!-- /include header -->



<main>
<div>
<h1>Gestionar Unidades</h1>
</div>
  <table class="table">
    <thead>
      <tr>
        <th scope="col" hidden>#</th>
        <th scope="col">Nombre</th>
        <th scope="col">abreviatura</th>
        <th scope="col">factor</th>
        <th scope="col">Editar</th>
        <th scope="col">Eliminar</th>
      </tr>
    </thead>
    <tbody>
      <% units.forEach(function(unit) { %>
      <tr>
        <th scope="row" hidden><%= unit._id %></th>
        <td><%= unit.nombre %></td>
        <td><%= unit.abreviatura %></td>
        <td><%= unit.factor %></td>
        <td>
          <a href="/update-units/<%= unit._id %>" class="btn btn-success">Editar</a>
        </td>

        <td>
          <a href="/delete-unit/<%= unit._id %>" class="btn btn-danger delete">Eliminar</a>
        </td>
      </tr>
      <% }); %>
        <tr>
          <td colspan="6" >
          <a href="/create-unit" class="btn btn-primary">Crear Nueva Unidad</a>
        </td>
      </tr>
    </tbody>
  </table>

</main>

<!-- include footer -->
<%- include('../../include/_footerAdmin') %>
<!-- /include footer -->
