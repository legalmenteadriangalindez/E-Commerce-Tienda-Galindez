<%- include('../../include/_headerAdmin') %>

<div class="page-wrapper">

  <div class="page-header">
    <h1>Métodos de Pago</h1>
    <p>Configura los métodos de pago disponibles en tu tienda</p>
  </div>

  <div class="form-card">

    <% if (locals.error) { %>
      <div class="alert error"><%= error %></div>
    <% } %>

    <% if (locals.success) { %>
      <div class="alert success"><%= success %></div>
    <% } %>

    <form action="/create-payment-method" method="POST" class="category-form">

      <!-- NAME -->
      <div class="form-group">
        <label>Nombre</label>

        <input 
          type="text" 
          name="name"
          placeholder="Ej: Nequi"
          required
          autofocus
        >
      </div>

      <!-- CODE -->
      <div class="form-group">
        <label>Código</label>

        <input 
          type="text"
          name="code"
          placeholder="Ej: nequi"
          required
        >

        <small>
          Debe ser único y en minúsculas
        </small>
      </div>

      <!-- TYPE -->
      <div class="form-group">

        <label>Tipo</label>

        <select name="type" required>

          <option value="">
            Selecciona un tipo
          </option>

          <option value="wallet">
            Wallet
          </option>

          <option value="card">
            Tarjeta
          </option>

          <option value="bank_transfer">
            Transferencia bancaria
          </option>

          <option value="cash">
            Efectivo
          </option>

          <option value="gateway">
            Pasarela de pago
          </option>

        </select>

      </div>

      <!-- CONFIG API KEY -->
      <div class="form-group">

        <label>API Key</label>

        <input 
          type="text"
          name="config[apiKey]"
          placeholder="API KEY"
        >

      </div>

      <!-- CONFIG SECRET -->
      <div class="form-group">

        <label>Secret Key</label>

        <input 
          type="text"
          name="config[secretKey]"
          placeholder="SECRET KEY"
        >

      </div>

      <!-- CONFIG ACCOUNT -->
      <div class="form-group">

        <label>Número de cuenta</label>

        <input 
          type="text"
          name="config[accountNumber]"
          placeholder="3001234567"
        >

      </div>

      <!-- ACTIVE -->
      <div class="form-group checkbox-group">

        <label>

          <input 
            type="checkbox"
            name="isActive"
            value="true"
            checked
          >

          Método activo

        </label>

      </div>

      <div class="form-actions">

        <button type="submit">
          Guardar método de pago
        </button>

      </div>

    </form>

  </div>

</div>

<%- include('../../include/_footerAdmin') %>