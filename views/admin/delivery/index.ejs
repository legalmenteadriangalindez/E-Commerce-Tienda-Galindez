<%- include('../../include/_headerAdmin') %>

<main class="admin-shell admin-list-page delivery-page">
    <%- include('../../include/_adminPageHeader', {
        eyebrow: 'Operación logística',
        title: 'Reparto y seguimiento',
        description: 'Asigna pedidos confirmados o contra entrega a un repartidor y consulta el avance de cada entrega.',
        actionHref: '/read-order',
        actionLabel: 'Ver todos los pedidos'
    }) %>
    <% if (notice) { %><p class="admin-alert admin-alert--success delivery-notice" role="status"><span class="admin-alert__message"><%= notice %></span></p><% } %>
    <%- include('./partials/filters', { statuses, status, statusLabels, pagination }) %>
    <% if (!dealers.length) { %><div class="delivery-empty delivery-warning"><strong>No hay repartidores activos.</strong><span>Crea un usuario con el rol <code>dealer</code> desde Gestión → Usuarios para poder asignar pedidos.</span></div><% } %>
    <section class="delivery-grid" aria-label="Pedidos para reparto">
        <% orders.forEach(order => { %><%- include('./partials/order-card', { order, status, statusLabels, dealers, csrfToken, incidentLabels }) %><% }) %>
    </section>
    <% if (!orders.length) { %><p class="admin-list-empty admin-empty-state">No hay pedidos disponibles para este filtro.</p><% } %>
    <%- include('./partials/pagination', { pagination }) %>
</main>

<%- include('../../include/_footerAdmin') %>
