<%- include('../../include/_headerAdmin') %>

<main class="admin-shell admin-list-page delivery-page">
    <header class="admin-list-heading">
        <div><p class="admin-list-eyebrow">Operación logística</p><h1>Reparto y seguimiento</h1><p class="admin-list-description">Asigna pedidos confirmados o contra entrega a un repartidor y consulta el avance de cada entrega.</p></div>
        <a href="/read-order" class="admin-list-primary">Ver todos los pedidos</a>
    </header>
    <% if (notice) { %><p class="delivery-notice" role="status"><%= notice %></p><% } %>
    <%- include('./partials/filters', { statuses, status, statusLabels, pagination }) %>
    <% if (!dealers.length) { %><div class="delivery-empty delivery-warning"><strong>No hay repartidores activos.</strong><span>Crea un usuario con el rol <code>dealer</code> desde Gestión → Usuarios para poder asignar pedidos.</span></div><% } %>
    <section class="delivery-grid" aria-label="Pedidos para reparto">
        <% orders.forEach(order => { %><%- include('./partials/order-card', { order, status, statusLabels, dealers, csrfToken }) %><% }) %>
    </section>
    <% if (!orders.length) { %><p class="admin-list-empty">No hay pedidos disponibles para este filtro.</p><% } %>
    <%- include('./partials/pagination', { pagination }) %>
</main>

<%- include('../../include/_footerAdmin') %>
