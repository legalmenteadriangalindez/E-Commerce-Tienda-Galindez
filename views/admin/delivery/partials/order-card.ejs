<% const lastEvent = Array.isArray(order.seguimientoEntrega) && order.seguimientoEntrega.length ? order.seguimientoEntrega[order.seguimientoEntrega.length - 1] : null; %>
<% const paymentMethod = order.metodoPago || (order.canal === 'CAJA' ? 'CASH_AT_COUNTER' : 'WOMPI_CARD'); %>
<% const canAssign = order.metodoPago === 'CASH_ON_DELIVERY' ? order.estado === 'PENDIENTE' : ['PAGADA', 'PREPARANDO', 'ENVIADA'].includes(order.estado); %>
<% const openIncidents = Array.isArray(order.incidenciasEntrega)
    ? order.incidenciasEntrega.filter((incident) => incident.estado === 'ABIERTA')
    : []; %>
<article class="delivery-card">
    <%- include('./status', { order, statusLabels }) %>
    <div class="delivery-card__facts">
        <span><i class="bi bi-cash-coin"></i> $<%= Number(order.total || 0).toLocaleString('es-CO') %> COP</span>
        <span><i class="bi bi-wallet2"></i> <%= paymentMethod === 'CASH_ON_DELIVERY' ? 'Contra entrega' : paymentMethod === 'CASH_AT_COUNTER' ? 'Efectivo en caja' : paymentMethod === 'WOMPI_NEQUI' ? 'Nequi · Wompi' : 'Tarjeta · Wompi' %></span>
        <span><i class="bi bi-calendar3"></i> <%= new Date(order.createdAt).toLocaleDateString('es-CO') %></span>
        <span><i class="bi bi-geo-alt"></i> <%= order.direccionEnvio?.ciudad || 'Ciudad no indicada' %></span>
    </div>
    <p class="delivery-card__address"><strong>Entrega:</strong> <%= order.direccionEnvio?.direccion || 'Dirección no indicada' %><% if (order.direccionEnvio?.referencia) { %> · <%= order.direccionEnvio.referencia %><% } %></p>
    <% if (openIncidents.length) { %>
        <section class="delivery-card__incidents" aria-label="Incidencias abiertas del pedido">
            <div class="delivery-card__incidents-heading">
                <h3><i class="bi bi-exclamation-triangle"></i> Incidencias abiertas</h3>
                <span><%= openIncidents.length %></span>
            </div>
            <% openIncidents.forEach(incident => { %>
                <article class="delivery-card__incident">
                    <strong><%= incidentLabels[incident.tipo] || incident.tipo %></strong>
                    <p><%= incident.nota || 'Sin detalle adicional.' %></p>
                    <small>Reportada <%= new Date(incident.reportadoEn).toLocaleString('es-CO') %><% if (incident.reportadoPor?.nombre) { %> por <%= incident.reportadoPor.nombre %><% } %></small>
                    <form class="delivery-incident-resolve-form" action="/admin/delivery/<%= order._id %>/incidents/<%= incident._id %>/resolve" method="POST">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <input type="hidden" name="status" value="<%= status || '' %>">
                        <label class="visually-hidden" for="resolution-<%= incident._id %>">Resolución de la incidencia</label>
                        <input id="resolution-<%= incident._id %>" name="resolution" maxlength="500" required placeholder="Escribe cómo se atendió">
                        <button type="submit" class="delivery-button delivery-button--secondary">Marcar atendida</button>
                    </form>
                </article>
            <% }) %>
        </section>
    <% } %>
    <%- include('./actions', { order, status, dealers, csrfToken, canAssign }) %>
    <div class="delivery-card__footer"><span><strong>Última actualización:</strong> <%= lastEvent?.mensaje || 'Sin historial; el pedido es anterior al seguimiento.' %></span><a href="/order/<%= order._id %>" class="delivery-detail-link">Ver detalle</a></div>
</article>
