<!-- include header -->
<%- include('../../include/_headerAdmin') %>
<!-- /include header -->

<link rel="stylesheet" href="/assets/css/read_orders.css">


<main class="admin-list-page">
  <header class="admin-list-heading">
    <div>
      <p class="admin-list-eyebrow">Operación</p>
      <h1>Gestionar órdenes</h1>
      <p class="admin-list-description">Supervisa el estado de los pedidos y continúa su proceso de entrega.</p>
    </div>
    <a href="/create-order" class="admin-list-primary">Crear orden</a>
  </header>

<div class="admin-table-wrap">
<table class="table">

    <thead>

        <tr>

            <th scope="col" hidden>#</th>

            <th scope="col">Orden</th>

            <th scope="col">Usuario</th>

            <th scope="col">Total</th>

            <th scope="col">Estado</th>

            <th scope="col">Fecha</th>

            <th scope="col">Editar</th>

            <th scope="col">Eliminar</th>

            <th scope="col">Detalle</th>

        </tr>

    </thead>

    <tbody>

        <% orders.forEach(function(order) { %>

        <tr>

            <th scope="row" hidden>
                <%= order._id %>
            </th>

            <td>
                <%= order.numeroOrden %>
            </td>

            <td>
                <%= order.usuario?.nombre || 'Sin usuario' %>
            </td>

            <td>
                $ <%= order.total?.toLocaleString() %>
            </td>

            <td>

                <% if(order.estado === 'PENDIENTE') { %>

                    <span class="badge bg-warning text-dark">
                        <%= order.estado %>
                    </span>

                <% } %>

                <% if(order.estado === 'PAGADA') { %>

                    <span class="badge bg-success">
                        <%= order.estado %>
                    </span>

                <% } %>

                <% if(order.estado === 'ENVIADA') { %>

                    <span class="badge bg-info">
                        <%= order.estado %>
                    </span>

                <% } %>

                <% if(order.estado === 'ENTREGADA') { %>

                    <span class="badge bg-primary">
                        <%= order.estado %>
                    </span>

                <% } %>

                <% if(order.estado === 'CANCELADA') { %>

                    <span class="badge bg-danger">
                        <%= order.estado %>
                    </span>

                <% } %>

            </td>

            <td>

                <%= new Date(order.createdAt).toLocaleDateString() %>

            </td>

            <td>

                <a 
                    href="/update-order?id=<%= order._id %>"
                    class="btn btn-success"
                >
                    Editar
                </a>

            </td>

            <td>

                <form action="/delete-order/<%= order._id %>" method="POST" class="d-inline">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button type="submit" class="btn btn-danger">Eliminar</button>
                </form>

            </td>

            <td>

                <a 
                    href="/order/<%= order._id %>"
                    class="btn btn-info"
                >
                    Detalle
                </a>

            </td>

        </tr>

        <% }); %>

    </tbody>

</table>
</div>
<% if (!orders.length) { %>
    <p class="admin-list-empty">No hay órdenes registradas.</p>
<% } %>
<%- include('../../include/_adminPagination', { pagination, label: 'órdenes' }) %>

</main>


<!-- include footer -->
<%- include('../../include/_footerAdmin') %>
<!-- /include footer -->
