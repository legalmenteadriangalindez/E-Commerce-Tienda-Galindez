<form class="ar-filters" method="get" action="/admin/reviews" role="search" aria-label="Filtrar reseñas">
    <div class="ar-field ar-search">
        <label for="ar-search">Buscar opiniones</label>
        <input id="ar-search" name="q" type="search" value="<%= filters.q %>" maxlength="100" placeholder="Comentario, respuesta o cliente">
    </div>
    <div class="ar-field">
        <label for="ar-product">Producto</label>
        <input id="ar-product" name="producto" type="search" value="<%= filters.producto %>" maxlength="100" placeholder="Nombre del producto">
    </div>
    <div class="ar-field">
        <label for="ar-state">Visibilidad</label>
        <select id="ar-state" name="estado">
            <option value="todas" <%= filters.estado === 'todas' ? 'selected' : '' %>>Todas</option>
            <option value="publicadas" <%= filters.estado === 'publicadas' ? 'selected' : '' %>>Publicadas</option>
            <option value="ocultas" <%= filters.estado === 'ocultas' ? 'selected' : '' %>>Ocultas</option>
        </select>
    </div>
    <div class="ar-field">
        <label for="ar-rating">Calificación</label>
        <select id="ar-rating" name="calificacion">
            <option value="">Todas las estrellas</option>
            <% for (let rating = 5; rating >= 1; rating--) { %>
                <option value="<%= rating %>" <%= filters.calificacion === String(rating) ? 'selected' : '' %>><%= rating %> <%= rating === 1 ? 'estrella' : 'estrellas' %></option>
            <% } %>
        </select>
    </div>
    <div class="ar-field">
        <label for="ar-reply">Respuesta de la tienda</label>
        <select id="ar-reply" name="respuesta">
            <option value="todas" <%= filters.respuesta === 'todas' ? 'selected' : '' %>>Todas</option>
            <option value="sin_respuesta" <%= filters.respuesta === 'sin_respuesta' ? 'selected' : '' %>>Sin respuesta</option>
            <option value="con_respuesta" <%= filters.respuesta === 'con_respuesta' ? 'selected' : '' %>>Con respuesta</option>
        </select>
    </div>
    <div class="ar-filter-actions">
        <button class="ar-button" type="submit">Aplicar filtros</button>
        <a href="/admin/reviews">Limpiar</a>
    </div>
</form>
