<%- include('../../include/_headerAdmin') %>
<%
    const formatDate = value => {
        const date = new Date(value);
        return value && !Number.isNaN(date.getTime()) ? date.toLocaleString('es-CO', {
            dateStyle: 'medium', timeStyle: 'short', timeZone: 'America/Bogota'
        }) : 'Fecha no disponible';
    };
    const actionLabels = {
        OCULTAR: 'Reseña ocultada', PUBLICAR: 'Reseña publicada',
        RESPONDER: 'Respuesta creada', EDITAR_RESPUESTA: 'Respuesta editada',
        RETIRAR_RESPUESTA: 'Respuesta retirada'
    };
%>
<main class="admin-reviews">
    <header class="ar-heading">
        <div>
            <p class="ar-eyebrow">GESTIÓN DE LA TIENDA</p>
            <h1>Reseñas</h1>
            <p>Consulta las opiniones de tus clientes y responde en nombre de Tienda Galindez.</p>
        </div>
        <a class="ar-button ar-button--secondary" href="/read-producto">Ver productos</a>
    </header>

    <% if (feedback) { %>
        <p class="ar-notice <%= feedback.success ? 'ar-notice--success' : 'ar-notice--error' %>" role="status"><%= feedback.message %></p>
    <% } %>

    <div class="ar-stats" aria-label="Resumen de todas las reseñas">
        <div><span>Total de reseñas</span><strong><%= summary.total %></strong></div>
        <div><span>Publicadas</span><strong><%= summary.publicadas %></strong></div>
        <div><span>Ocultas</span><strong><%= summary.ocultas %></strong></div>
        <div><span>Sin respuesta</span><strong><%= summary.sinRespuesta %></strong></div>
    </div>

    <%- include('./partials/review-filters', { filters }) %>

    <div class="ar-results-heading">
        <h2><%= pagination.totalItems %> <%= pagination.totalItems === 1 ? 'reseña encontrada' : 'reseñas encontradas' %></h2>
        <span>Más recientes primero</span>
    </div>
    <p class="ar-policy">Las críticas sobre el producto también son válidas. Usa la opción de ocultar para contenido inapropiado, spam o datos personales e indica siempre el motivo.</p>

    <% if (!reviews.length) { %>
        <div class="ar-empty">
            <h3>No hay reseñas con estos filtros</h3>
            <p>Prueba otra búsqueda o consulta todas las opiniones.</p>
            <a href="/admin/reviews">Ver todas las reseñas</a>
        </div>
    <% } %>

    <div class="ar-list">
        <% reviews.forEach(r => { %>
            <%- include('./partials/review-card', { r, feedback, csrfToken, returnTo, formatDate, actionLabels }) %>
        <% }) %>
    </div>

    <% if (pagination.totalItems > 0) { %>
        <nav class="ar-pagination" aria-label="Páginas de reseñas">
            <span>Mostrando <%= pagination.from %>–<%= pagination.to %> de <%= pagination.totalItems %></span>
            <div>
                <% if (pagination.previousUrl) { %><a href="<%= pagination.previousUrl %>" rel="prev">Anterior</a><% } %>
                <% pagination.pages.forEach(p => { %>
                    <% if (p.current) { %><span aria-current="page"><%= p.number %></span><% } else { %><a href="<%= p.href %>" aria-label="Página <%= p.number %>"><%= p.number %></a><% } %>
                <% }) %>
                <% if (pagination.nextUrl) { %><a href="<%= pagination.nextUrl %>" rel="next">Siguiente</a><% } %>
            </div>
        </nav>
    <% } %>
</main>
<%- include('../../include/_footerAdmin') %>
