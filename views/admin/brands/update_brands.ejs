<h1>Editar Marca</h1>

<form 
    action="/update-marca/<%= brand._id %>" 
    method="POST" 
    enctype="multipart/form-data"
>

    <input 
        type="text" 
        name="nombre" 
        value="<%= brand.nombre %>"
        required
    />

    <br><br>

    <% if (brand.foto) { %>
        <img 
            src="<%= brand.foto %>" 
            width="100"
            alt="<%= brand.nombre %>"
        >
    <% } %>

    <br><br>

    <input 
        type="file" 
        name="foto"
        accept="image/*"
    />

    <br><br>

    <button type="submit">
        Actualizar Marca
    </button>

</form>

<%- include('../../include/_footerAdmin') %>