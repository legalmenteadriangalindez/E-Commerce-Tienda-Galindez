<%- include('../../include/_headerAdmin') %>

<h1>Editar Marca</h1>

<link rel="stylesheet" href="/assets/css/update_brands.css">


<h1>Editar Marca</h1>

<form
    action="/update-marca/<%= brand._id %>"
    method="POST"
    enctype="multipart/form-data"
>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

    <input
        type="text"
        name="nombre"
        value="<%= brand.nombre %>"
        required
    />

    <br><br>

    <% if (brand.foto) { %>
        <img
            src="<%= brand.foto %>"
            width="100"
            alt="<%= brand.nombre %>"
        >
    <% } %>

    <br><br>

    <input
        type="file"
        name="foto"
        accept="image/jpeg,image/png,image/webp"
    />
    <small class="text-muted">JPG, PNG o WEBP; máximo 2 MB.</small>

    <br><br>

    <button type="submit">
        Actualizar Marca
    </button>

</form>

<%- include('../../include/_footerAdmin') %>
