<%- include('../../include/_headerAdmin') %>

<div class="brand-page__header">
  <p class="brand-page__eyebrow">Catálogo de productos</p>
  <h1 id="create-brand-title">Crear nueva marca</h1>
  <p class="brand-page__description">Registra una marca para organizar tus productos y mostrar su identidad en la tienda.</p>
</div>

<form
  action="/api/marcas"
  method="POST"
  enctype="multipart/form-data"
  class="admin-brand-form brand-form"
  aria-labelledby="create-brand-title"
>
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">

  <div class="brand-form__field">
    <label for="brand-name">Nombre de la marca</label>
    <input
      id="brand-name"
      type="text"
      name="nombre"
      class="form-control brand-form__control"
      autocomplete="organization"
      required
    >
  </div>

  <div class="brand-form__field">
    <div class="brand-form__field-header">
      <label for="brand-photo">Imagen de la marca</label>
      <span class="brand-form__optional">Opcional</span>
    </div>

    <label class="brand-file-picker" for="brand-photo">
      <span class="brand-file-picker__title">Seleccionar imagen</span>
      <span class="brand-file-picker__hint">Añade un logotipo o una imagen representativa.</span>
    </label>

    <input
      id="brand-photo"
      type="file"
      name="foto"
      class="form-control brand-form__file-input"
      accept="image/jpeg,image/png,image/webp"
      aria-describedby="brand-photo-help"
    >
    <small id="brand-photo-help" class="brand-form__helper">JPG, PNG o WEBP; máximo 2 MB.</small>
  </div>

  <div class="brand-form__actions">
    <button type="submit" class="btn btn-primary brand-form__submit">Guardar marca</button>
  </div>
</form>

<%- include('../../include/_footerAdmin') %>
