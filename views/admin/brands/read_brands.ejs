<!-- include header -->
<%- include('../../include/_headerAdmin') %>
<!-- /include header -->


<main class="admin-list-page">
  <header class="admin-list-heading">
    <div>
      <p class="admin-list-eyebrow">Catálogo</p>
      <h1>Gestionar marcas</h1>
      <p class="admin-list-description">Mantén consistentes las marcas que aparecen en tus productos.</p>
    </div>
    <a href="/create-marca" class="admin-list-primary">Crear marca</a>
  </header>

  <div class="admin-table-wrap ui-table-wrap">
  <table class="table ui-table">
    <thead>
      <tr>
        <th scope="col" hidden>#</th>
        <th scope="col">Nombre</th>
        <th scope="col">Imagen</th>
        <th scope="col">Editar</th>
        <th scope="col">Eliminar</th>
      </tr>
    </thead>
    <tbody>
      <% brands.forEach(function(brand) { %>
      <tr>
        <th scope="row" hidden><%= brand._id %></th>
        <td><%= brand.nombre %></td>
        <td>
             <% if (brand.foto) { %>
                 <img src="<%= brand.foto %>" width="80" height="80" class="brand-thumbnail" alt="<%= brand.nombre %>">
             <% } else { %>
                 <span>Sin imagen</span>
             <% } %>
        </td>
        <td>
          <a href="/update-marca?id=<%= brand._id %>" class="btn btn-success">Editar</a>
        </td>

        <td>
          <form action="/delete-marca/<%= brand._id %>" method="POST" class="d-inline">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button type="submit" class="btn btn-danger">Eliminar</button>
          </form>
        </td>
      </tr>
      <% }); %>
    </tbody>
  </table>
  </div>
  <% if (!brands.length) { %>
    <p class="admin-list-empty">No hay marcas registradas.</p>
  <% } %>
  <%- include('../../include/_adminPagination', { pagination, label: 'marcas' }) %>

</main>



<!-- include footer -->
<%- include('../../include/_footerAdmin') %>
<!-- /include footer -->
