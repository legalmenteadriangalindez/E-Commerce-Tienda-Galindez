<!-- include header -->
<%- include('../../include/_headerAdmin') %>
<!-- /include header -->


<main class="admin-shell admin-list-page">
  <%- include('../../include/_adminPageHeader', {
    eyebrow: 'Catálogo',
    title: 'Gestionar marcas',
    description: 'Mantén consistentes las marcas que aparecen en tus productos.',
    actionHref: '/create-marca',
    actionLabel: 'Crear marca'
  }) %>

  <div class="admin-card admin-table-wrap ui-table-wrap">
  <table class="table ui-table admin-table">
    <thead>
      <tr>
        <th scope="col" hidden>#</th>
        <th scope="col">Nombre</th>
        <th scope="col">Imagen</th>
        <th scope="col">Editar</th>
        <th scope="col">Eliminar</th>
      </tr>
    </thead>
    <tbody>
      <% brands.forEach(function(brand) { %>
      <tr>
        <th scope="row" hidden><%= brand._id %></th>
        <td><%= brand.nombre %></td>
        <td>
             <% if (brand.foto) { %>
                 <img src="<%= brand.foto %>" width="80" height="80" class="brand-thumbnail" alt="<%= brand.nombre %>">
             <% } else { %>
                 <span>Sin imagen</span>
             <% } %>
        </td>
        <td>
          <a href="/update-marca?id=<%= brand._id %>" class="btn btn-success admin-button admin-button--primary">Editar</a>
        </td>

        <td>
          <form action="/delete-marca/<%= brand._id %>" method="POST" class="d-inline">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button type="submit" class="btn btn-danger admin-button admin-button--danger">Eliminar</button>
          </form>
        </td>
      </tr>
      <% }); %>
    </tbody>
  </table>
  </div>
  <%- include('../../include/_adminEmptyState', {
    show: !brands.length,
    message: 'No hay marcas registradas.'
  }) %>
  <%- include('../../include/_adminPagination', { pagination, label: 'marcas' }) %>

</main>



<!-- include footer -->
<%- include('../../include/_footerAdmin') %>
<!-- /include footer -->
