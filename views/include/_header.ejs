<!DOCTYPE html>
<html lang="es">

<head>
    <link rel="stylesheet" href="/css/theme.css">
    <link rel="stylesheet" href="/css/components/ui.css">

    <meta charset="UTF-8">
    <meta name="csrf-token" content="<%= csrfToken %>">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <!-- ==================== SEO ==================== -->

    <title>
        <%= typeof seoTitle !== 'undefined'
            ? seoTitle
            : 'Tienda Galindez'
        %>
    </title>

    <meta
        name="description"
        content="<%= typeof seoDescription !== 'undefined'
            ? seoDescription
            : 'Compra productos de alimentación, dulcería, lácteos, ropa y más en Tienda Galindez.'
        %>"
    >

    <% if (typeof seoCanonical !== 'undefined') { %>
        <link
            rel="canonical"
            href="<%= seoCanonical %>"
        >
    <% } %>

    <% if (typeof seoImage !== 'undefined') { %>
        <meta
            property="og:image"
            content="<%= seoImage %>"
        >
    <% } %>

    <meta
        property="og:title"
        content="<%= typeof seoTitle !== 'undefined'
            ? seoTitle
            : 'Tienda Galindez'
        %>"
    >

    <meta
        property="og:description"
        content="<%= typeof seoDescription !== 'undefined'
            ? seoDescription
            : 'Compra productos de alimentación, dulcería, lácteos, ropa y más en Tienda Galindez.'
        %>"
    >

    <meta property="og:type" content="website">

    <!-- FAVICON -->

    <link
        rel="icon"
        type="image/png"
        href="/img/favicon.png"
    >

    <!-- CSS -->

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
        rel="stylesheet"
    >

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
        rel="stylesheet"
        integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB"
        crossorigin="anonymous"
    >

    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.1/css/all.min.css"
        integrity="sha512-+4zCK9k+qNFUR5X+cKL9EIR+ZOhtIloNl9GIKS57V1MyNsYpYcUrUeQc9vNfzsWfV28IaLL3i96P9sdNyeRssA=="
        crossorigin="anonymous"
    >

    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/header.css">
    <link rel="stylesheet" href="/css/footer.css">
    <%
        const validPageResource = (value, prefix) => typeof value === 'string'
            && value.startsWith(prefix)
            && !value.includes('..')
            && !/[\r\n"'<>]/.test(value);
        const pageCssValues = typeof pageCss === 'undefined' ? [] : pageCss;
        const pageJsValues = typeof pageJs === 'undefined' ? [] : pageJs;
        const headerPageCss = [...new Set((Array.isArray(pageCssValues) ? pageCssValues : []).filter(value => validPageResource(value, '/css/')))];
        const headerPageJs = [...new Set((Array.isArray(pageJsValues) ? pageJsValues : []).filter(value => validPageResource(value, '/js/')))];
        if (typeof activeRaffle !== 'undefined' && activeRaffle && !headerPageCss.includes('/css/raffle.css')) headerPageCss.push('/css/raffle.css');
    %>
    <% headerPageCss.forEach(href => { %><link rel="stylesheet" href="<%= href %>"><% }) %>
    <% headerPageJs.forEach(src => { %><script nonce="<%= cspNonce %>" defer src="<%= src %>"></script><% }) %>
</head>

<body>

<header id="header">

<nav class="navbar navbar-expand-lg navbar-dark">

    <div class="container-fluid">

        <!-- BRAND -->

        <a
            class="navbar-brand d-flex align-items-center"
            href="/"
        >
            <span class="brand-text">
                Tienda Galindez
            </span>
        </a>


        <!-- TOGGLER -->

        <button
            class="navbar-toggler"
            type="button"
            data-bs-toggle="collapse"
            data-bs-target="#navbarContent"
        >
            <span class="navbar-toggler-icon"></span>
        </button>


        <!-- NAV -->

        <div
            class="collapse navbar-collapse"
            id="navbarContent"
        >

            <!-- LEFT -->

            <ul class="navbar-nav me-auto">

                <li class="nav-item dropdown">

                    <a
                        class="nav-link dropdown-toggle"
                        data-bs-toggle="dropdown"
                    >
                        <i class="bi bi-grid"></i>
                        Categorías
                    </a>

                    <ul class="dropdown-menu">

                        <% if (categorias && categorias.length > 0) { %>

                            <% categorias.forEach(cat => { %>

                                <li>

                                    <a
                                        class="dropdown-item"
                                        href="/categoria/<%= encodeURIComponent(cat.nombre) %>"
                                    >
                                        <i class="bi bi-tag"></i>
                                        <%= cat.nombre %>
                                    </a>

                                </li>

                            <% }) %>

                        <% } else { %>

                            <li>
                                <span class="dropdown-item text-danger">
                                    No hay categorías
                                </span>
                            </li>

                        <% } %>

                        <li>
                            <hr class="dropdown-divider">
                        </li>

                        <li>

                            <a
                                class="dropdown-item"
                                href="/"
                            >
                                <i class="bi bi-box"></i>
                                Ver todo el catálogo
                            </a>

                        </li>

                    </ul>

                </li>


                <li class="nav-item">

                    <a
                        class="nav-link"
                        href="/promociones"
                    >
                        <i class="bi bi-tag"></i>
                        Promociones
                    </a>

                </li>


                <li class="nav-item">

                    <a
                        class="nav-link"
                        href="/clothes"
                    >
                        <i class="bi bi-tag"></i>
                        Ropa
                    </a>

                </li>


                <li class="nav-item">

                    <a
                        class="nav-link"
                        href="/marcas"
                    >
                        <i class="bi bi-bookmark"></i>
                        Marcas
                    </a>

                </li>


                <li class="nav-item">

                    <a
                        class="nav-link position-relative"
                        href="/view_cart"
                    >

                        <i class="bi bi-cart"></i>
                        Carrito

                        <span
                            id="cart-count"
                            class="cart-badge"
                        >

                            <%= Array.isArray(cart)
                                ? cart.reduce(
                                    (acc, i) => acc + i.cantidad,
                                    0
                                )
                                : 0
                            %>

                        </span>

                    </a>

                </li>

            </ul>


            <!-- RIGHT -->

            <div class="nav-right">


                <!-- SEARCH -->

                <form
                    class="search-form"
                    action="/search"
                    method="GET"
                >

                    <input
                        type="search"
                        name="search"
                        placeholder="Buscar..."
                    >

                    <button type="submit">
                        <i class="bi bi-search"></i>
                    </button>

                </form>


                <!-- PERFIL -->

                <% const headerUser = (typeof authUser !== 'undefined' && authUser)
                    || (typeof sessionUser !== 'undefined' && sessionUser)
                    || null; %>

                <div class="dropdown">

                    <a
                        class="profile-btn"
                        data-bs-toggle="dropdown"
                    >
                        <i class="bi bi-person-circle"></i>
                    </a>


                    <ul class="dropdown-menu dropdown-menu-end">

                        <% if (headerUser && headerUser._id) { %>
                            <li>
                                <a class="dropdown-item" href="/perfil">
                                    <i class="bi bi-person"></i>
                                    Mi cuenta
                                </a>
                            </li>

                            <li>
                                <hr class="dropdown-divider">
                            </li>

                            <li>
                                <a class="dropdown-item" href="/mis-pedidos">Mis pedidos</a>
                                <form action="/logout" method="POST">
                                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                    <button type="submit" class="dropdown-item text-danger">
                                        <i class="bi bi-box-arrow-right"></i>
                                        Cerrar sesión
                                    </button>
                                </form>
                            </li>
                        <% } else { %>
                            <li>
                                <a class="dropdown-item" href="/login">
                                    <i class="bi bi-box-arrow-in-right"></i>
                                    Iniciar sesión
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item" href="/register">
                                    <i class="bi bi-person-plus"></i>
                                    Crear cuenta
                                </a>
                            </li>
                        <% } %>

                    </ul>

                </div>

            </div>

        </div>

    </div>

</nav>

</header>

<% if (typeof activeRaffle !== 'undefined' && activeRaffle) { %>
    <a class="raffle-floating-card" href="/sorteo" aria-label="Ver sorteo de regalos">
        <% if (activeRaffle.imagenUrl) { %>
            <img src="<%= activeRaffle.imagenUrl %>" alt="">
        <% } %>
        <span class="raffle-floating-copy">
            <strong><%= activeRaffle.titulo %></strong>
            <span>Compra desde $<%= Number(activeRaffle.montoMinimo).toLocaleString('es-CO') %></span>
        </span>
    </a>
<% } %>
