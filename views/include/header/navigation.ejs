<body>

<header id="header">

<nav class="navbar navbar-expand-lg navbar-dark app-navbar">

    <div class="container-fluid">

        <!-- BRAND -->

        <a
            class="navbar-brand d-flex align-items-center"
            href="/"
        >
            <span class="app-brand-text">
                Tienda Galindez
            </span>
        </a>


        <!-- TOGGLER -->

        <button
            class="navbar-toggler"
            type="button"
            data-bs-toggle="collapse"
            data-bs-target="#navbarContent"
        >
            <span class="navbar-toggler-icon"></span>
        </button>


        <!-- NAV -->

        <div
            class="collapse navbar-collapse"
            id="navbarContent"
        >

            <!-- LEFT -->

            <ul class="navbar-nav me-auto">

                <li class="nav-item dropdown">

                    <a
                        class="nav-link app-nav-link dropdown-toggle"
                        data-bs-toggle="dropdown"
                    >
                        <i class="bi bi-grid"></i>
                        Categorías
                    </a>

                    <ul class="dropdown-menu">

                        <% if (categorias && categorias.length > 0) { %>

                            <% categorias.forEach(cat => { %>

                                <li>

                                    <a
                                        class="dropdown-item"
                                        href="/categoria/<%= encodeURIComponent(cat.nombre) %>"
                                    >
                                        <i class="bi bi-tag"></i>
                                        <%= cat.nombre %>
                                    </a>

                                </li>

                            <% }) %>

                        <% } else { %>

                            <li>
                                <span class="dropdown-item text-danger">
                                    No hay categorías
                                </span>
                            </li>

                        <% } %>

                        <li>
                            <hr class="dropdown-divider">
                        </li>

                        <li>

                            <a
                                class="dropdown-item"
                                href="/"
                            >
                                <i class="bi bi-box"></i>
                                Ver todo el catálogo
                            </a>

                        </li>

                    </ul>

                </li>


                <li class="nav-item">

                    <a
                        class="nav-link app-nav-link"
                        href="/promociones"
                    >
                        <i class="bi bi-tag"></i>
                        Promociones
                    </a>

                </li>


                <li class="nav-item">

                    <a
                        class="nav-link app-nav-link"
                        href="/clothes"
                    >
                        <i class="bi bi-tag"></i>
                        Ropa
                    </a>

                </li>


                <li class="nav-item">

                    <a
                        class="nav-link app-nav-link"
                        href="/marcas"
                    >
                        <i class="bi bi-bookmark"></i>
                        Marcas
                    </a>

                </li>


                <li class="nav-item">

                    <a
                        class="nav-link app-nav-link position-relative"
                        href="/view_cart"
                    >

                        <i class="bi bi-cart"></i>
                        Carrito

                        <span
                            id="cart-count"
                            class="app-cart-badge"
                        >

                            <%= Array.isArray(cart)
                                ? cart.reduce(
                                    (acc, i) => acc + i.cantidad,
                                    0
                                )
                                : 0
                            %>

                        </span>

                    </a>

                </li>

            </ul>


            <!-- RIGHT -->

            <div class="app-nav-right">


                <!-- SEARCH -->

                <form
                    class="app-search-form"
                    action="/search"
                    method="GET"
                    role="search"
                    aria-label="Buscar productos en el catálogo"
                >

                    <input
                        type="search"
                        name="search"
                        value="<%= typeof search !== 'undefined' ? search : '' %>"
                        placeholder="Buscar..."
                        aria-label="Nombre, descripción, marca o categoría"
                        list="catalog-search-suggestions"
                        autocomplete="off"
                        minlength="2"
                        maxlength="100"
                    >
                    <datalist id="catalog-search-suggestions"></datalist>

                    <button type="submit">
                        <i class="bi bi-search"></i>
                    </button>

                </form>


                <!-- PERFIL -->

                <% const headerUser = (typeof authUser !== 'undefined' && authUser)
                    || (typeof sessionUser !== 'undefined' && sessionUser)
                    || null; %>

                <div class="dropdown">

                    <a
                        class="app-profile-btn"
                        data-bs-toggle="dropdown"
                    >
                        <i class="bi bi-person-circle"></i>
                    </a>


                    <ul class="dropdown-menu dropdown-menu-end">

                        <% if (headerUser && headerUser._id) { %>
                            <li>
                                <a class="dropdown-item" href="/perfil">
                                    <i class="bi bi-person"></i>
                                    Mi cuenta
                                </a>
                            </li>

                            <li>
                                <hr class="dropdown-divider">
                            </li>

                            <li>
                                <a class="dropdown-item" href="/mis-pedidos">Mis pedidos</a>
                                <form action="/logout" method="POST">
                                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                    <button type="submit" class="dropdown-item text-danger">
                                        <i class="bi bi-box-arrow-right"></i>
                                        Cerrar sesión
                                    </button>
                                </form>
                            </li>
                        <% } else { %>
                            <li>
                                <a class="dropdown-item" href="/login">
                                    <i class="bi bi-box-arrow-in-right"></i>
                                    Iniciar sesión
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item" href="/register">
                                    <i class="bi bi-person-plus"></i>
                                    Crear cuenta
                                </a>
                            </li>
                        <% } %>

                    </ul>

                </div>

            </div>

        </div>

    </div>

</nav>

</header>
