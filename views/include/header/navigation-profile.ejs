<!-- PERFIL -->

<% const headerUser = (typeof authUser !== 'undefined' && authUser)
    || (typeof sessionUser !== 'undefined' && sessionUser)
    || null; %>
<% const headerRole = String(headerUser?.rol?.nombre || '').trim().toLowerCase(); %>
<% const headerIsDealer = headerRole === 'dealer'; %>
<% const headerPermissions = Array.isArray(headerUser?.rol?.permisos) ? headerUser.rol.permisos : []; %>
<% const headerIsAdmin = headerRole === 'admin' || headerPermissions.includes('admin:access'); %>
<% const headerCanManageProfile = !headerIsAdmin || headerRole === 'admin' || headerPermissions.includes('profile:manage'); %>

<div class="dropdown">

    <a
        class="app-profile-btn"
        data-bs-toggle="dropdown"
    >
        <i class="bi bi-person-circle"></i>
    </a>


    <ul class="dropdown-menu dropdown-menu-end">

        <% if (headerUser && headerUser._id) { %>
            <% if (headerCanManageProfile) { %>
                <li>
                    <a class="dropdown-item" href="<%= headerIsDealer ? '/dealer/perfil' : headerIsAdmin ? '/admin/perfil' : '/perfil' %>">
                        <i class="bi bi-person"></i>
                        Mi cuenta
                    </a>
                </li>
            <% } %>

            <li>
                <hr class="dropdown-divider">
            </li>

            <li>
                <% if (headerIsDealer) { %>
                    <a class="dropdown-item" href="/dealer/orders/read">Mis entregas</a>
                <% } else if (!headerIsAdmin) { %>
                    <a class="dropdown-item" href="/mis-pedidos">Mis pedidos</a>
                <% } %>
                <a class="dropdown-item" href="/change-password">Cambiar contraseña</a>
                <form action="/logout" method="POST">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button type="submit" class="dropdown-item text-danger">
                        <i class="bi bi-box-arrow-right"></i>
                        Cerrar sesión
                    </button>
                </form>
            </li>
        <% } else { %>
            <li>
                <a class="dropdown-item" href="/login">
                    <i class="bi bi-box-arrow-in-right"></i>
                    Iniciar sesión
                </a>
            </li>
            <li>
                <a class="dropdown-item" href="/register">
                    <i class="bi bi-person-plus"></i>
                    Crear cuenta
                </a>
            </li>
        <% } %>

    </ul>

</div>
