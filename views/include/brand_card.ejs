
<link rel="stylesheet" href="/assets/css/brand-cards.css">

<div class="brand-card">
    <img
        class="brand-card-img"
        src="<%= brand.foto ? brand.foto : '/assets/img/default.jpg' %>"
        alt="<%= brand.nombre %>"
    >

    <div class="brand-card-body">
        <h5 class="brand-card-title"><%= brand.nombre %></h5>
        <p class="brand-card-text">Marca registrada en el sistema</p>
    </div>

    <div class="brand-card-actions">
        <a href="/brand/<%= brand.nombre %>" class="btn-secondary-action">
            Ver productos
        </a>
    </div>
</div>
