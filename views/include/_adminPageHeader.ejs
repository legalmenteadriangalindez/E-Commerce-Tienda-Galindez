<%
    const pageEyebrow = typeof eyebrow === 'string' ? eyebrow : '';
    const pageTitle = typeof title === 'string' ? title : '';
    const pageDescription = typeof description === 'string' ? description : '';
    const pageActionHref = typeof actionHref === 'string' ? actionHref : '';
    const pageActionLabel = typeof actionLabel === 'string' ? actionLabel : '';
    const pageActionIcon = typeof actionIcon === 'string' ? actionIcon : '';
    const requestedActionVariant = typeof actionVariant === 'string' ? actionVariant : 'primary';
    const pageActionVariant = ['primary', 'secondary', 'danger', 'dark'].includes(requestedActionVariant)
        ? requestedActionVariant
        : 'primary';
    const pageActionClass = typeof actionClass === 'string' ? actionClass : '';
    const pageHeaderClass = typeof additionalClass === 'string' ? additionalClass : '';
    const pageActionVisible = typeof showAction === 'undefined' || showAction !== false;
    const pageActionClasses = [
        'admin-button',
        `admin-button--${pageActionVariant}`,
        'admin-page-header__action',
        pageActionVariant === 'primary' ? 'admin-list-primary' : '',
        pageActionClass,
    ]
        .filter(Boolean)
        .join(' ');
%>
<header class="admin-page-header admin-list-heading <%= pageHeaderClass %>">
    <div class="admin-page-header__content">
        <% if (pageEyebrow) { %>
            <p class="admin-page-header__eyebrow admin-list-eyebrow"><%= pageEyebrow %></p>
        <% } %>
        <h1><%= pageTitle %></h1>
        <% if (pageDescription) { %>
            <p class="admin-page-header__description admin-list-description"><%= pageDescription %></p>
        <% } %>
    </div>

    <% if (pageActionVisible && pageActionHref && pageActionLabel) { %>
        <a
            href="<%= pageActionHref %>"
            class="<%= pageActionClasses %>"
        >
            <% if (pageActionIcon) { %><i class="<%= pageActionIcon %>" aria-hidden="true"></i><% } %>
            <span><%= pageActionLabel %></span>
        </a>
    <% } %>
</header>
