<% if (isDealer) { %><div class="table-responsive"><% } %>
<table class="table table-bordered <%= isDealer ? 'product-table' : '' %>">
    <thead>
        <tr>
            <th>Producto</th>
            <th>Cantidad</th>
            <th>Precio</th>
            <th>Subtotal</th>
        </tr>
    </thead>
    <tbody>
        <% order.productos.forEach(function(item) { %>
            <tr>
                <td<%= isDealer ? ' data-label="Producto"' : '' %>><%= item.nombre %></td>
                <td<%= isDealer ? ' data-label="Cantidad"' : '' %>><%= item.cantidad %></td>
                <td<%= isDealer ? ' data-label="Precio"' : '' %>><%= formatCOP(item.precioUnitarioCents, item.precioUnitario) %></td>
                <td<%= isDealer ? ' data-label="Subtotal"' : '' %>><%= formatCOP(item.subtotalCents, item.subtotal) %></td>
            </tr>
        <% }) %>
    </tbody>
</table>
<% if (isDealer) { %></div><% } %>
