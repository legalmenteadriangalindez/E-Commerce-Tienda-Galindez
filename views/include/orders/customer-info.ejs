<div class="card order-card">
    <div class="card-header">Datos del Cliente</div>
    <div class="card-body">
        <div class="row">
            <div class="col-md-4 mb-3">
                <h5>Nombre</h5>
                <p><%= order.cliente?.nombre || 'No definido' %></p>
            </div>
            <div class="col-md-4 mb-3">
                <h5>Email</h5>
                <p><%= order.cliente?.email || 'No definido' %></p>
            </div>
            <div class="col-md-4 mb-3">
                <h5>Teléfono</h5>
                <p><%= order.cliente?.telefono || 'No definido' %></p>
            </div>
        </div>
    </div>
</div>

<div class="card order-card">
    <div class="card-header">Dirección de Envío</div>
    <div class="card-body">
        <div class="row">
            <div class="col-md-6 mb-3">
                <h5>Nombre</h5>
                <p><%= order.direccionEnvio?.nombreRecibe || 'No definido' %></p>
            </div>
            <div class="col-md-6 mb-3">
                <h5>Teléfono</h5>
                <p><%= order.direccionEnvio?.telefono || 'No definido' %></p>
            </div>
            <div class="col-md-6 mb-3">
                <h5>Departamento</h5>
                <p><%= order.direccionEnvio?.departamento || 'No definido' %></p>
            </div>
            <div class="col-md-6 mb-3">
                <h5>Ciudad</h5>
                <p><%= order.direccionEnvio?.ciudad || 'No definido' %></p>
            </div>
            <div class="col-md-6 mb-3">
                <h5>Código Postal</h5>
                <p><%= order.direccionEnvio?.codigoPostal || 'No definido' %></p>
            </div>
            <div class="col-md-12 mb-3">
                <h5>Dirección</h5>
                <p><%= order.direccionEnvio?.direccion || 'No definido' %></p>
            </div>
            <div class="col-md-12 mb-3">
                <h5>Referencia</h5>
                <p><%= order.direccionEnvio?.referencia || 'Sin referencia' %></p>
            </div>
        </div>
    </div>
</div>

<div class="card order-card">
    <div class="card-header">Notas del Cliente</div>
    <div class="card-body">
        <p><%= order.notasCliente || 'Sin notas adicionales' %></p>
    </div>
</div>
