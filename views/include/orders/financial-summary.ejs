<div class="card order-card total-card">
    <div class="card-header">Resumen Financiero</div>
    <div class="card-body">
        <div class="summary-item">
            <span>Subtotal:</span>
            <strong><%= formatCOP(order.subtotalCents, order.subtotal) %></strong>
        </div>
        <div class="summary-item">
            <span>Impuestos:</span>
            <strong><%= formatCOP(order.impuestosCents, order.impuestos) %></strong>
        </div>
        <div class="summary-item">
            <span>Envío:</span>
            <strong><%= formatCOP(order.costoEnvioCents, order.costoEnvio) %></strong>
        </div>
        <div class="summary-item">
            <span>Descuento:</span>
            <strong><%= formatCOP(order.descuentoCents, order.descuento) %></strong>
        </div>
        <hr>
        <div class="summary-item total">
            <span>Total:</span>
            <strong><%= formatCOP(order.totalCents, order.total) %></strong>
        </div>
    </div>
</div>
