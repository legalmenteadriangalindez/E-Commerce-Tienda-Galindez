<div class="form-section">
    <h3>Totales</h3>
    <div class="form-group"><label>Subtotal</label><input type="text" value="<%= formatCOP(order.subtotalCents, order.subtotal) %>" disabled></div>
    <div class="form-group"><label>Impuestos</label><input type="text" value="<%= formatCOP(order.impuestosCents, order.impuestos) %>" disabled></div>
    <div class="form-group"><label>Costo Envío</label><input type="text" value="<%= formatCOP(order.costoEnvioCents, order.costoEnvio) %>" disabled></div>
    <div class="form-group"><label>Total</label><input type="text" value="<%= formatCOP(order.totalCents, order.total) %>" disabled></div>
</div>
