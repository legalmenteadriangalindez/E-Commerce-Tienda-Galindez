<div class="form-section">
    <h3>Totales</h3>
    <div class="form-group"><label for="order-subtotal">Subtotal</label><input id="order-subtotal" type="text" value="<%= formatCOP(order.subtotalCents, order.subtotal) %>" disabled></div>
    <div class="form-group"><label for="order-taxes">Impuestos</label><input id="order-taxes" type="text" value="<%= formatCOP(order.impuestosCents, order.impuestos) %>" disabled></div>
    <div class="form-group"><label for="order-shipping-cost">Costo Envío</label><input id="order-shipping-cost" type="text" value="<%= formatCOP(order.costoEnvioCents, order.costoEnvio) %>" disabled></div>
    <div class="form-group"><label for="order-total">Total</label><input id="order-total" type="text" value="<%= formatCOP(order.totalCents, order.total) %>" disabled></div>
</div>
