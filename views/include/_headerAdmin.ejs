<!DOCTYPE html>
<html lang="es">
<head>

    <meta charset="UTF-8">
    <meta name="csrf-token" content="<%= csrfToken %>">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin - Tienda Galindez</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.1/css/all.min.css">
    <link rel="stylesheet" href="/assets/css/header.css">
    <link rel="stylesheet" href="/assets/css/style.css">
    <link rel="stylesheet" href="/assets/css/footer.css">
    <link rel="stylesheet" href="/assets/css/analytics.css">
    <!-- <link rel="stylesheet" href="/assets/css/products.css"> -->
     <!-- <link rel="stylesheet" href="/assets/css/rols.css"> -->
    <!-- <link rel="stylesheet" href="/assets/css/users.css"> -->
    
<!-- ICONO DE LA PESTAÑA -->
    <link rel="icon" type="image/png" href="/assets/img/favicon.png">
    

<link rel="stylesheet" href="/assets/css/commerce.css">
<link rel="stylesheet" href="/assets/css/raffle.css">
<link rel="stylesheet" href="/assets/css/admin-pagination.css">
<script nonce="<%= cspNonce %>" defer src="/assets/js/commerce-ui.js"></script>
</head>
<body>

<% const canAccess = typeof can === 'function' ? can : () => true; %>
<% const adminHome = canAccess('payments:manage') ? '/billing-point' : canAccess('analytics:read') ? '/admin-analytics' : canAccess('catalog:read') ? '/read-producto' : canAccess('orders:read') ? '/read-order' : canAccess('payments:read') ? '/admin/payments' : canAccess('sales:read') ? '/read-sales' : canAccess('delivery:manage') ? '/admin/delivery' : canAccess('store-settings:manage') ? '/admin/settings/shipping' : canAccess('roles:manage') ? '/read-rol' : canAccess('users:manage') ? '/read-user' : '/'; %>
<% const showManagement = ['payments:read', 'delivery:manage', 'catalog:read', 'providers:manage', 'roles:manage', 'reviews:moderate', 'users:manage', 'store-settings:manage'].some(canAccess); %>
<% const showAnalytics = ['analytics:read', 'orders:read', 'inventory:read', 'sales:read', 'raffle:manage'].some(canAccess); %>

<header id="header">
<nav class="navbar navbar-expand-lg navbar-dark">
  <div class="container-fluid">
    <!-- BRAND -->
    <a class="navbar-brand d-flex align-items-center" href="<%= adminHome %>">
        <i class="bi bi-shield-lock me-2"></i>
        <span class="brand-text">Admin Galindez</span>
    </a>
    <!-- TOGGLER -->
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
        data-bs-target="#navbarAdmin">
        <span class="navbar-toggler-icon"></span>
    </button>
    <!-- NAV -->
    <div class="collapse navbar-collapse" id="navbarAdmin">
      <!-- LEFT -->
      <ul class="navbar-nav me-auto">
        <% if (showManagement) { %><li class="nav-item dropdown">
          <a class="nav-link dropdown-toggle" data-bs-toggle="dropdown">
            <i class="bi bi-gear"></i> Gestión
          </a>
          <ul class="dropdown-menu">
            <% if (canAccess('payments:read')) { %><li><a class="dropdown-item" href="/admin/payments">Pagos y conciliación</a></li><% } %>
            <% if (canAccess('store-settings:manage')) { %><li><a class="dropdown-item" href="/admin/settings/shipping"><i class="bi bi-truck"></i> Envíos y tarifas</a></li><% } %>
            <% if (canAccess('delivery:manage')) { %><li><a class="dropdown-item" href="/admin/delivery"><i class="bi bi-bicycle"></i> Reparto y seguimiento</a></li><% } %>
            <% if (canAccess('catalog:read')) { %><li><a class="dropdown-item" href="/read-producto"><i class="bi bi-box-seam"></i> Productos</a></li><% } %>
            <% if (canAccess('catalog:read')) { %><li><a class="dropdown-item" href="/read-categoria"><i class="bi bi-tags"></i> Categorías</a></li><% } %>
            <% if (canAccess('catalog:read')) { %><li><a class="dropdown-item" href="/admin/brands/read-brands"><i class="bi bi-bookmark-star"></i> Marcas</a></li><% } %>
            <% if (canAccess('providers:manage')) { %><li><a class="dropdown-item" href="/read-proveedor"><i class="bi bi-truck"></i> Proveedores</a></li><% } %>
            <% if (canAccess('roles:manage')) { %><li><a class="dropdown-item" href="/read-rol"><i class="bi bi-person-badge"></i> Roles</a></li><% } %>
            <% if (canAccess('reviews:moderate')) { %><li><a class="dropdown-item" href="/admin/reviews"><i class="bi bi-chat-left-text"></i> Reseñas</a></li><% } %>
            <% if (canAccess('users:manage')) { %><li><a class="dropdown-item" href="/read-user"><i class="bi bi-person-plus"></i> Usuarios</a></li><% } %>

          </ul>
        </li><% } %>
             <% if (showAnalytics) { %><li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle" data-bs-toggle="dropdown">
              <i class="bi bi-graph-up-arrow"></i> Analitics
            </a>
          <ul class="dropdown-menu">
            <% if (canAccess('analytics:read')) { %><li><a class="dropdown-item" href="/admin-analytics"><i class="bi bi-speedometer2"></i> Informe de ventas</a></li><% } %>
            <% if (canAccess('orders:read')) { %><li><a class="dropdown-item" href="/read-order"><i class="bi bi-receipt-cutoff"></i> Ordenes </a></li><% } %>
            <% if (canAccess('inventory:read')) { %><li><a class="dropdown-item" href="/read-Stock"><i class="bi bi-box-seam"></i> Stock </a></li><% } %>
            <% if (canAccess('sales:read')) { %><li><a class="dropdown-item" href="/admin-best_selling_products"><i class="bi bi-box-seam"></i> Productos mas vendidos </a></li><% } %>
            <% if (canAccess('raffle:manage')) { %><li><a class="dropdown-item" href="/admin/raffle"><i class="bi bi-gift"></i> Sorteo de regalos</a></li><% } %>
            <% if (canAccess('sales:read')) { %><li><hr class="dropdown-divider"></li><li><a class="dropdown-item" href="/read-sales"><i class="bi bi-cart-check"></i> Ventas</a></li><% } %>
          </ul>
        </li><% } %>
      </ul>

      <!-- RIGHT -->
      <div class="nav-right">
        <!-- PERFIL ADMIN -->
        <div class="dropdown">
          <a class="profile-btn d-flex align-items-center" data-bs-toggle="dropdown">
            <i class="bi bi-person-circle"></i>
          </a>
          <ul class="dropdown-menu dropdown-menu-end">
            <% if (canAccess('profile:manage')) { %><li><a class="dropdown-item" href="/admin/perfil"><i class="bi bi-person"></i> Perfil</a></li><% } %>
            <% if (canAccess('payments:manage')) { %><li><a class="dropdown-item" href="/billing-point"><i class="bi bi-grid"></i> Panel</a></li><% } %>
            <li><hr class="dropdown-divider"></li>
            <li>
              <form action="/logout" method="POST">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button type="submit" class="dropdown-item text-danger"><i class="bi bi-box-arrow-right"></i> Cerrar sesión</button>
              </form>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</nav>
</header>

