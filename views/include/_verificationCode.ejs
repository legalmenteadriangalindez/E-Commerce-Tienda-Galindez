<!DOCTYPE html>

<html lang="es">
<head>
    <link rel="stylesheet" href="/css/core/theme.css">
    <link rel="stylesheet" href="/css/core/reset.css">
    <link rel="stylesheet" href="/css/core/layout.css">
    <link rel="stylesheet" href="/css/components/ui.css">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Verificación de correo</title>
<link rel="stylesheet" href="/css/pages/_verificationCode.css">
</head>

<body>

<div class="verification-container">

    <div class="verification-card">

        <div class="icon-container">
            ✉
        </div>

        <h1>
            Verifica tu correo
        </h1>

        <% if (deliveryFailed) { %>
            <p class="description" role="alert">Tu cuenta se creó, pero no pudimos enviar el código. Espera un minuto y usa «Reenviar código». No necesitas registrarte otra vez.</p>
        <% } else { %>
            <p class="description">Ingresa el código enviado a tu correo electrónico para continuar. Si aún no lo recibes, puedes solicitar otro abajo.</p>
        <% } %>

        <form action="/verify-email" method="POST">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">

            <input
                type="hidden"
                name="email"
                value="<%= email %>"
            >

            <label
                class="input-label"
                for="code"
            >
                Código de verificación
            </label>

            <input
                type="text"
                id="code"
                name="code"
                class="code-input"
                placeholder="000000"
                maxlength="6"
                autocomplete="one-time-code"
                required
            >

            <button
                type="submit"
                class="verify-btn"
            >
                Verificar código
            </button>

        </form>

        <div class="divider">
            ¿No recibiste el código?
        </div>

        <p class="resend-text">
            Puedes solicitar un nuevo código de verificación.
        </p>

        <form
            action="/resend-verification-code"
            method="POST"
        >
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">

            <input
                type="hidden"
                name="email"
                value="<%= email %>"
            >

            <button
                type="submit"
                class="resend-btn"
            >
                Reenviar código
            </button>

        </form>

        <div class="security-message">
            Por seguridad, no compartas tu código de verificación
            con otras personas.
        </div>

    </div>

</div>
</body>
</html>
