<!DOCTYPE html>
<html lang="es">
<head>
    <link rel="stylesheet" href="/css/core/theme.css">
    <link rel="stylesheet" href="/css/core/reset.css">
    <link rel="stylesheet" href="/css/core/layout.css">
    <link rel="stylesheet" href="/css/components/ui.css">
    <meta charset="UTF-8">
    <meta name="csrf-token" content="<%= csrfToken %>">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dealer - Tienda Galindez</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.1/css/all.min.css">
    <link rel="stylesheet" href="/css/core/header.css">
    <link rel="stylesheet" href="/css/core/footer.css">
    <%
        const validPageResource = (value, prefix) => typeof value === 'string'
            && value.startsWith(prefix)
            && !value.includes('..')
            && !/[\r\n"'<>]/.test(value);
        const pageCssValues = typeof pageCss === 'undefined' ? [] : pageCss;
        const pageJsValues = typeof pageJs === 'undefined' ? [] : pageJs;
        const headerPageCss = [...new Set((Array.isArray(pageCssValues) ? pageCssValues : []).filter(value => validPageResource(value, '/css/')))];
        const headerPageJs = [...new Set((Array.isArray(pageJsValues) ? pageJsValues : []).filter(value => validPageResource(value, '/js/')))]; 
    %>
    <% headerPageCss.forEach(href => { %><link rel="stylesheet" href="<%= href %>"><% }) %>
    <% headerPageJs.forEach(src => { %><script nonce="<%= cspNonce %>" defer src="<%= src %>"></script><% }) %>
    <!-- ICONO DE LA PESTAÑA -->
    <link rel="icon" type="image/png" href="/img/favicon.png">
    <!-- Los estilos de cada pantalla llegan mediante pageCss. -->
</head>
<body class="dealer-app">

<header id="header" class="dealer-header">
<nav class="navbar navbar-dark app-navbar dealer-navbar" aria-label="Navegación del repartidor">
  <div class="container-fluid dealer-navbar__inner">
    <!-- BRAND -->
    <a class="navbar-brand d-flex align-items-center" href="/dealer/orders/read" aria-label="Ir a Mis entregas">
        <span class="dealer-brand-icon" aria-hidden="true"><i class="bi bi-truck"></i></span>
        <span class="app-brand-text">Dealer Tienda Galindez</span>
    </a>

      <!-- CUENTA -->
      <div class="app-nav-right">
        <div class="dropdown">
          <button class="app-profile-btn dealer-profile-btn d-flex align-items-center" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-haspopup="true" aria-label="Abrir menú de cuenta">
            <i class="bi bi-person-circle" aria-hidden="true"></i>
            <span class="dealer-profile-label">Mi cuenta</span>
          </button>
          <ul class="dropdown-menu dropdown-menu-end" aria-label="Opciones de cuenta">
            <li><a class="dropdown-item" href="/dealer/perfil"><i class="bi bi-person"></i> Perfil</a></li>
            <li><a class="dropdown-item" href="/dealer/perfil/editar"><i class="bi bi-pencil-square"></i> Editar perfil</a></li>
            <li><a class="dropdown-item" href="/dealer/orders/read"><i class="bi bi-bicycle"></i> Mis entregas</a></li>
            <li><a class="dropdown-item" href="/dealer/orders/history"><i class="bi bi-clock-history"></i> Historial de entregas</a></li>
            <li><a class="dropdown-item" href="/change-password"><i class="bi bi-key"></i> Cambiar contraseña</a></li>
            <li><hr class="dropdown-divider"></li>
            <li>
              <form action="/logout" method="POST">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button type="submit" class="dropdown-item text-danger"><i class="bi bi-box-arrow-right"></i> Cerrar sesión</button>
              </form>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</nav>
</header>
