<!DOCTYPE html>
<html lang="en">
<head>
    <link rel="stylesheet" href="/css/theme.css">
    <link rel="stylesheet" href="/css/components/ui.css">
    <meta charset="UTF-8">
    <meta name="csrf-token" content="<%= csrfToken %>">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dealer - Tienda Galindez</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.1/css/all.min.css">
    <link rel="stylesheet" href="/css/header.css">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/footer.css">
    <%
        const validPageResource = (value, prefix) => typeof value === 'string'
            && value.startsWith(prefix)
            && !value.includes('..')
            && !/[\r\n"'<>]/.test(value);
        const pageCssValues = typeof pageCss === 'undefined' ? [] : pageCss;
        const pageJsValues = typeof pageJs === 'undefined' ? [] : pageJs;
        const headerPageCss = [...new Set((Array.isArray(pageCssValues) ? pageCssValues : []).filter(value => validPageResource(value, '/css/')))];
        const headerPageJs = [...new Set((Array.isArray(pageJsValues) ? pageJsValues : []).filter(value => validPageResource(value, '/js/')))];
    %>
    <% headerPageCss.forEach(href => { %><link rel="stylesheet" href="<%= href %>"><% }) %>
    <% headerPageJs.forEach(src => { %><script nonce="<%= cspNonce %>" defer src="<%= src %>"></script><% }) %>
    <!-- ICONO DE LA PESTAÑA -->
    <link rel="icon" type="image/png" href="/img/favicon.png">
    <!-- Los estilos de cada pantalla llegan mediante pageCss. -->





</head>
<body>

<header id="header">
<nav class="navbar navbar-expand-lg navbar-dark">
  <div class="container-fluid">
    <!-- BRAND -->
    <a class="navbar-brand d-flex align-items-center" href="/dealer/orders/read">
        <i class="bi bi-shield-lock me-2"></i>
        <span class="brand-text">Dealer Tienda Galindez</span>
    </a>
    <!-- TOGGLER -->
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
        data-bs-target="#navbarAdmin">
        <span class="navbar-toggler-icon"></span>
    </button>
    <!-- NAV -->

      <!-- RIGHT -->
      <div class="nav-right">
        <!-- PERFIL ADMIN -->
        <div class="dropdown">
          <a class="profile-btn d-flex align-items-center" data-bs-toggle="dropdown">
            <i class="bi bi-person-circle"></i>
          </a>
          <ul class="dropdown-menu dropdown-menu-end">
            <li><a class="dropdown-item" href="/dealer/perfil/editar"><i class="bi bi-person"></i> Perfil</a></li>
            <li><a class="dropdown-item" href="/dealer/orders/read"><i class="bi bi-bicycle"></i> Mis entregas</a></li>
            <li><hr class="dropdown-divider"></li>
            <li>
              <form action="/logout" method="POST">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button type="submit" class="dropdown-item text-danger"><i class="bi bi-box-arrow-right"></i> Cerrar sesión</button>
              </form>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</nav>
</header>
