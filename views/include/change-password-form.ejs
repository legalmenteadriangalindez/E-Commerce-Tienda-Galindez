<section class="commerce-card">
    <h1>Cambiar contraseña</h1>
    <p>Escribe tu contraseña actual y elige una nueva de al menos 12 caracteres. Después tendrás que iniciar sesión de nuevo.</p>
    <% if (error) { %><p role="alert"><%= error %></p><% } %>
    <form method="post" action="/change-password">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <% [
            { name: 'currentPassword', label: 'Contraseña actual', autocomplete: 'current-password', min: 1 },
            { name: 'password', label: 'Nueva contraseña', autocomplete: 'new-password', min: 12 },
            { name: 'confirmPassword', label: 'Confirmar nueva contraseña', autocomplete: 'new-password', min: 12 }
        ].forEach(field => { %>
            <label for="change-<%= field.name %>"><%= field.label %></label>
            <div class="password-field">
                <input id="change-<%= field.name %>" type="password" name="<%= field.name %>" required minlength="<%= field.min %>" maxlength="72" autocomplete="<%= field.autocomplete %>" data-password-input>
                <button class="password-toggle" type="button" data-password-toggle aria-controls="change-<%= field.name %>" aria-label="Visibilidad de la contraseña" aria-pressed="false" hidden><span data-password-toggle-label aria-hidden="true">Mostrar</span></button>
            </div>
        <% }) %>
        <button type="submit">Guardar contraseña</button>
    </form>
    <p><a href="/forgot-password">No recuerdo mi contraseña actual</a></p>
</section>
