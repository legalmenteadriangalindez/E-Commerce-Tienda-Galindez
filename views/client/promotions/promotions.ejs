<!-- include header -->
<%- include('../../include/_header') %>

<header class="promotions-heading">
    <h1>Promociones</h1>
    <p>Productos seleccionados por la tienda para esta sección.</p>
</header>

<!-- cards -->
<div class="container-cards">
    <% if (productos.length === 0) { %>
        <p class="text-center">No hay productos en promoción por el momento.</p>
    <% } else { %>
        <% productos.forEach(p => { %>
            <%- include('../../include/card', { p }) %>
        <% }) %>
    <% } %>
</div>
<%- include('../../include/_pagination', { pagination }) %>

<%- include('../../include/_footer') %>
