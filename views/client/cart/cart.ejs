<!-- include header -->
<%- include('../../include/_header') %>
<!-- /include header -->

<link rel="stylesheet" href="/assets/css/car.css">

<div class="container">
    <h1>Carrito de Compras</h1>
</div>

<p>
    Revisa los productos que has agregado a tu carrito
    de compras y realiza el checkout cuando estés listo.
</p>

<main
  class="main-cart"
  data-shipping-price-cents="<%= shippingPriceCents %>"
  data-free-shipping-from-cents="<%= freeShippingFromCents %>"
>

  <div class="cart-wrapper">

    <!-- Productos -->
    <section class="items-section">

      <header class="cart-header">

        <h1>Tu Despensa</h1>

        <span class="badge">
          <%= productosCarrito.length %> Articulo(s)
        </span>

      </header>

      <!-- FORMULARIO -->
      <form
        id="cartForm"
        action="/carrito/payment_point"
        method="POST"
      >
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <div class="product-list">

          <% if(productosCarrito.length === 0){ %>

              <p>Tu carrito está vacío.</p>

          <% } %>

          <% productosCarrito.forEach((producto, index) => { %>

          <article
            class="product-card"
            data-price="<%= producto.precio %>"
            data-price-cents="<%= producto.precioCents || Math.round(Number(producto.precio) * 100) %>"
          >

            <!-- Imagen -->
            <div class="img-container">

              <img
                src="<%= producto.foto || '/assets/img/default.jpg' %>"
                alt="<%= producto.nombre %>"
              >

            </div>

            <!-- Info -->
            <div class="product-info">

              <h3><%= producto.nombre %></h3>

              <p class="category">
                <%= producto.categoria || 'Sin categoría' %>
              </p>

            </div>

            <!-- Producto ID -->
            <input
              type="hidden"
              name="productos[<%= index %>][productoId]"
              value="<%= producto.productoId %>"
            >

            <!-- Cantidad -->

<div class="quantity-picker">

  <input
    type="number"
    name="productos[<%= index %>][cantidad]"
    value="<%= producto.cantidad %>"
    min="1"
    max="99"
    class="form-control text-center fw-bold"
  >

</div>
            <!-- Precio -->
          <p class="price item-total">

          $<%= Number(producto.precio * producto.cantidad).toLocaleString('es-CO') %>

          </p>

          </article>

          <% }) %>

        </div>

      </form>

    </section>

    <!-- Resumen -->
    <aside class="summary-section">

      <div class="summary-card">

        <h2 class="text-sumary">
          Resumen
        </h2>

        <div class="divider"></div>

        <div class="summary-line">

          <span class="text-sumary">
            Subtotal
          </span>

          <span
            class="text-sumary"
            id="subtotal"
          >
            $<%= subtotal.toFixed(2) %>
          </span>

        </div>

        <div class="summary-line">

          <span class="text-sumary">
            Envío
          </span>

          <span class="text-sumary free" id="shipping">
            <%= costoEnvio === 0 ? 'Gratis' : '$' + Number(costoEnvio).toLocaleString('es-CO') %>
          </span>

        </div>

        <div class="divider"></div>

        <div class="summary-line total">

          <span class="text-sumary">
            Total
          </span>

        <span
          class="text-sumary total-amount"
          id="total"
        >
          $<%= Number(total).toLocaleString('es-CO') %>
        </span>

        <small class="shipping-hint" id="shippingHint">
          Envío gratis desde $<%= Number(freeShippingFromCents / 100).toLocaleString('es-CO') %>.
        </small>

        </div>

        <!-- BOTÓN -->
        <button
          type="submit"
          form="cartForm"
          class="pay-btn"
        >

          <i class="fas fa-lock"></i>
          Proceder al pago

        </button>

      </div>

    </aside>

  </div>

</main>

<script nonce="<%= cspNonce %>" src="/assets/js/client_cart.js"></script>

<!-- include footer -->
<%- include('../../include/_footer') %>
<!-- /include footer -->
