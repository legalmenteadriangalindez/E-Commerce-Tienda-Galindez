<!-- include header -->
<%- include('../../include/_header') %>
<!-- /include header -->

<link rel="stylesheet" href="/assets/css/car.css">

<div class="container">
    <h1>Carrito de Compras</h1>
</div>

<p>
    Revisa los productos que has agregado a tu carrito
    de compras y realiza el checkout cuando estés listo.
</p>

<main
  class="main-cart"
  data-shipping-price-cents="<%= shippingPriceCents %>"
  data-free-shipping-from-cents="<%= freeShippingFromCents %>"
>

  <div class="cart-wrapper">

    <!-- Productos -->
    <section class="items-section">

      <header class="cart-header">

        <div>
          <p class="cart-eyebrow">Tu compra</p>
          <h1>Tu Despensa</h1>
        </div>

        <div class="cart-header-actions">
          <span class="badge" id="cartCount">
            <%= productosCarrito.length %> <%= productosCarrito.length === 1 ? 'artículo' : 'artículos' %>
          </span>
          <a href="/" class="continue-shopping">
            <i class="fas fa-plus" aria-hidden="true"></i>
            Agregar productos
          </a>
        </div>

      </header>

      <p class="cart-status" id="cartStatus" role="status" aria-live="polite"></p>

      <!-- FORMULARIO -->
      <form
        id="cartForm"
        action="/carrito/payment_point"
        method="POST"
      >
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <div class="product-list">

          <% if (productosCarrito.length === 0) { %>

              <div class="empty-cart">
                <span class="empty-cart-icon" aria-hidden="true"><i class="fas fa-basket-shopping"></i></span>
                <h2>Tu despensa está vacía</h2>
                <p>Agrega productos para comenzar tu compra.</p>
                <a href="/" class="continue-shopping continue-shopping--primary">Ver productos</a>
              </div>

          <% } %>

          <% productosCarrito.forEach((producto, index) => { %>

          <article
            class="product-card"
            data-price="<%= producto.precio %>"
            data-price-cents="<%= producto.precioCents || Math.round(Number(producto.precio) * 100) %>"
          >

            <!-- Imagen -->
            <div class="img-container">

              <img
                src="<%= producto.foto || '/assets/img/default.jpg' %>"
                alt="<%= producto.nombre %>"
              >

            </div>

            <!-- Info -->
            <div class="product-info">

              <h3><%= producto.nombre %></h3>

              <p class="category">
                <%= producto.categoria || 'Sin categoría' %>
              </p>

            </div>

            <!-- Producto ID -->
            <input
              type="hidden"
              name="productos[<%= index %>][productoId]"
              value="<%= producto.productoId %>"
            >

            <div class="quantity-picker" aria-label="Cantidad de <%= producto.nombre %>">
              <button
                type="button"
                class="quantity-btn quantity-btn--minus"
                data-cart-action="decrease"
                aria-label="Disminuir cantidad de <%= producto.nombre %>"
              >−</button>
              <input
                type="number"
                name="productos[<%= index %>][cantidad]"
                value="<%= producto.cantidad %>"
                min="1"
                max="999"
                inputmode="numeric"
                class="quantity-input"
                aria-label="Cantidad de <%= producto.nombre %>"
              >
              <button
                type="button"
                class="quantity-btn quantity-btn--plus"
                data-cart-action="increase"
                aria-label="Aumentar cantidad de <%= producto.nombre %>"
              >+</button>
            </div>

            <p class="price item-total">
              $<%= Number(producto.precio * producto.cantidad).toLocaleString('es-CO') %>
            </p>

            <button
              type="button"
              class="remove-btn"
              data-cart-action="remove"
              aria-label="Eliminar <%= producto.nombre %> de la despensa"
              title="Eliminar producto"
            >
              <i class="fas fa-trash-can" aria-hidden="true"></i>
            </button>

          </article>

          <% }) %>

        </div>

      </form>

    </section>

    <!-- Resumen -->
    <aside class="summary-section">

      <div class="summary-card">

        <h2 class="text-sumary">
          Resumen
        </h2>

        <div class="divider"></div>

        <div class="summary-line">

          <span class="text-sumary">
            Subtotal
          </span>

          <span
            class="text-sumary"
            id="subtotal"
          >
            $<%= subtotal.toFixed(2) %>
          </span>

        </div>

        <div class="summary-line">

          <span class="text-sumary">
            Envío
          </span>

          <span class="text-sumary free" id="shipping">
            <%= costoEnvio === 0 ? 'Gratis' : '$' + Number(costoEnvio).toLocaleString('es-CO') %>
          </span>

        </div>

        <div class="divider"></div>

        <div class="summary-line total">

          <span class="text-sumary">
            Total
          </span>

        <span
          class="text-sumary total-amount"
          id="total"
        >
          $<%= Number(total).toLocaleString('es-CO') %>
        </span>

        <small class="shipping-hint" id="shippingHint">
          Envío gratis desde $<%= Number(freeShippingFromCents / 100).toLocaleString('es-CO') %>.
        </small>

        </div>

        <% if (productosCarrito.length > 0) { %>
          <button
            type="button"
            class="update-cart-btn"
            data-cart-action="save"
          >
            <i class="fas fa-rotate" aria-hidden="true"></i>
            Actualizar despensa
          </button>
        <% } %>

        <!-- BOTÓN -->
        <button
          type="submit"
          form="cartForm"
          class="pay-btn"
          <%= productosCarrito.length === 0 ? 'disabled' : '' %>
        >

          <i class="fas fa-lock"></i>
          Proceder al pago

        </button>

      </div>

    </aside>

  </div>

</main>

<script nonce="<%= cspNonce %>" src="/assets/js/client_cart.js"></script>

<!-- include footer -->
<%- include('../../include/_footer') %>
<!-- /include footer -->
