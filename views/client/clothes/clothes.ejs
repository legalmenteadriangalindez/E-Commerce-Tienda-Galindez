<!-- include header -->
<%- include('../../include/_header') %>
<!-- /include header -->
<link rel="stylesheet" href="/css/clothes.css">

<main class="home">

    <!-- CARAS FLOTANTES -->
    <div class="anime-faces">
    <img src="assets/img/faces/Kurama.png"
         class="anime-face face-1"
         alt="kurama">

    <img src="assets/img/faces/Kuromi.png"
         class="anime-face face-2"
         alt="Kuromi">

    <img src="assets/img/faces/Goku.png"
         class="anime-face face-3"
         alt="Goku">
    </div>
    <!-- HERO -->

    <section class="hero">

        <div class="hero-content">

            <span class="jp-text">
                アニメ・ストリートウェア
            </span>
            
            <h1>
                CAIFU'
                <span>Love</span>
            </h1>

            <p>
                Ropa inspirada en tus animes favoritos.
            </p>

        </div>

        <div class="hero-image">

            <img
                src="/img/hero-shirt.png"
            alt="">

        </div>

    </section>

    <!-- BENEFICIOS -->

    <section class="benefits">

        <div class="benefit">
            <!-- ICONO ENVÍO -->
            📦
            <h3>Envío Gratis</h3>
        </div>

        <div class="benefit">
            <!-- ICONO DEVOLUCIONES -->
            🔄
            <h3>Devoluciones</h3>
        </div>

        <div class="benefit">
            <!-- ICONO ESCUDO -->
            🛡️
            <h3>Pago Seguro</h3>
        </div>

        <div class="benefit">
            <!-- ICONO SOPORTE -->
            🎧
            <h3>Soporte 24/7</h3>
        </div>

    </section>

    <!-- CATEGORIAS -->

    <section class="categories">

        <h2>Categorías</h2>

        <div class="category-grid">

            <div class="category-card">
                Camisetas
            </div>

            <div class="category-card">
                Sudaderas
            </div>

            <div class="category-card">
                Chaquetas
            </div>

            <div class="category-card">
                Pantalones
            </div>

            <div class="category-card">
                Accesorios
            </div>

        </div>

    </section>


    <!-- PRODUCTOS -->
<section class="products">

    <h2>Más Vendidos</h2>

    <div class="products-cards">

        <% products.forEach(p => { %>

            <%- include('../../include/_cardClothes',{p}) %>

        <% }) %>

    </div>

</section>


</main>
<!-- include footer -->
<%- include('../../include/_footer') %>
<!-- /include footer -->
<script src="../../../assets/js/clothes.js"></script>