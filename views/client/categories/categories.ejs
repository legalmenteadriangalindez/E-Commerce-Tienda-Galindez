
<!-- include header -->
    <%- include('../../include/_header') %>
<!-- /include header -->


    <!-- Main Site -->
<main id="site-main">
    <h1>Categoria: <%= categoria.nombre %></h1>

    <div class="container-cards">
        <% if (productos.length === 0) { %>
            <p class="text-center">No hay productos disponibles en esta categoría.</p>
        <% } else { %>
            <% productos.forEach(p => { %>
                <%- include('../../include/card', { p }) %>
            <% }) %>
        <% } %>
    </div>
    <%- include('../../include/_pagination', { pagination }) %>

</main>
<!-- /Main Site -->


<!-- include footer -->
<%- include('../../include/_footer') %>
<!-- /include footer -->
