<section class="reviews-section" id="resenas" aria-labelledby="reviews-heading">
    <header class="reviews-heading">
        <div>
            <p class="reviews-eyebrow">OPINIONES DE LA TIENDA</p>
            <h2 id="reviews-heading">Reseñas de este producto</h2>
        </div>
        <% if (reviewSummary.total > 0) { %>
            <div class="reviews-score" aria-label="<%= reviewSummary.average %> de 5 estrellas">
                <span class="reviews-score__number"><%= reviewSummary.average.toLocaleString('es-CO', { minimumFractionDigits: 1, maximumFractionDigits: 1 }) %></span>
                <span>/ 5 <span aria-hidden="true">★</span><br><%= reviewSummary.total %> <%= reviewSummary.total === 1 ? 'reseña' : 'reseñas' %></span>
            </div>
        <% } %>
    </header>

    <% const canModerateReviews = reviewUser?.rol?.nombre === 'Admin' || reviewUser?.rol?.permisos?.includes('reviews:moderate'); %>
    <% if (canModerateReviews) { %>
        <p><a href="/admin/reviews?producto=<%= encodeURIComponent(product.nombre) %>">Administrar reseñas de este producto</a></p>
    <% } %>

    <% if (reviewFeedback) { %>
        <p class="review-notice <%= reviewFeedback.success ? 'review-notice--success' : 'review-notice--error' %>" role="status"><%= reviewFeedback.message %></p>
    <% } %>

    <div class="reviews-layout">
        <%- include('./review-list', {
            reviews,
            reviewUser,
            ownReview,
            canModerateReviews,
            csrfToken,
            reviewPagination
        }) %>
        <%- include('./review-editor', {
            reviewUser,
            ownReview,
            csrfToken,
            product,
            reviewValues
        }) %>
    </div>
</section>
