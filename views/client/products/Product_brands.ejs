
<!-- include header -->
    <%- include('../../include/_header') %>
<!-- /include header -->


<main id="site-main">
<h1 class="mb-3">Productos de la marca: <%= marca %></h1>

<p class="mb-4">Descubre los productos de esta marca.</p>

<div class="container-cards">
    <% if (products.length === 0) { %>
        <p class="text-center">Esta marca aún no tiene productos publicados.</p>
    <% } else { %>
        <% products.forEach(p => { %>
            <%- include('../../include/card', { p }) %>
        <% }) %>
    <% } %>

</div>
<%- include('../../include/_pagination', { pagination }) %>

</main>


<!-- include footer -->
<%- include('../../include/_footer') %>
<!-- /include footer -->
