<%- include('../../include/_header') %>

<main class="password-recovery">
    <div class="password-recovery__layout">
        <section class="password-recovery__card" aria-labelledby="recovery-title">
            <div class="password-recovery__icon" aria-hidden="true">
                <i class="bi bi-key"></i>
            </div>
            <p class="password-recovery__eyebrow">Seguridad de tu cuenta</p>
            <% if (token) { %>
                <h1 id="recovery-title">Crea una nueva contraseña</h1>
                <p class="password-recovery__description">
                    Elige una contraseña segura para volver a entrar en Tienda Galindez.
                </p>
                <form class="password-recovery__form" method="post" action="/reset-password">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <input type="hidden" name="token" value="<%= token %>">
                    <label class="password-recovery__label" for="reset-password">Nueva contraseña</label>
                    <div class="password-field password-recovery__password-field">
                        <input
                            class="ui-input password-recovery__input"
                            id="reset-password"
                            type="password"
                            name="password"
                            autocomplete="new-password"
                            aria-describedby="password-requirements"
                            minlength="12"
                            maxlength="72"
                            data-password-input
                            required
                        >
                        <button class="password-toggle" type="button" data-password-toggle aria-controls="reset-password" aria-label="Visibilidad de la contraseña" aria-pressed="false" hidden>
                            <span data-password-toggle-label aria-hidden="true">Mostrar</span>
                        </button>
                    </div>
                    <p class="password-recovery__hint" id="password-requirements">
                        Utiliza al menos 12 caracteres y un máximo de 72 bytes. El enlace solo funciona una vez.
                    </p>
                    <button class="ui-button ui-button--primary password-recovery__action" type="submit">
                        <i class="bi bi-check2-circle" aria-hidden="true"></i>
                        Guardar nueva contraseña
                    </button>
                </form>
            <% } else { %>
                <h1 id="recovery-title">Enlace no válido</h1>
                <p class="password-recovery__description">
                    Este enlace no es válido. Solicita otro para cambiar tu contraseña de forma segura.
                </p>
                <a class="ui-button ui-button--primary password-recovery__action" href="/forgot-password">
                    Solicitar nuevo enlace
                </a>
            <% } %>

            <a class="password-recovery__back" href="/login">
                <i class="bi bi-arrow-left" aria-hidden="true"></i>
                Volver a iniciar sesión
            </a>
        </section>

        <aside class="password-recovery__aside" aria-label="Consejos para proteger tu cuenta">
            <p class="password-recovery__brand">TIENDA GALINDEZ</p>
            <div class="password-recovery__shield" aria-hidden="true"><i class="bi bi-shield-check"></i></div>
            <h2>Un nuevo comienzo, con la misma seguridad.</h2>
            <p>Al guardar tu nueva contraseña, las sesiones anteriores se cerrarán para proteger tu cuenta.</p>
            <div class="password-recovery__security-note">
                <i class="bi bi-check-circle" aria-hidden="true"></i>
                El enlace vence en una hora y solo se puede utilizar una vez.
            </div>
        </aside>
    </div>
</main>

<%- include('../../include/_footer') %>
