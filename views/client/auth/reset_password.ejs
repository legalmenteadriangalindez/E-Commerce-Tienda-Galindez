<%- include('../../include/_header') %>
<main class="commerce-panel"><section class="commerce-card"><h1>Nueva contraseña</h1>
<% if (token) { %><p>Usa una frase de al menos 12 caracteres. El enlace solo puede utilizarse una vez.</p>
<form method="post" action="/reset-password"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="token" value="<%= token %>"><label for="reset-password">Nueva contraseña</label><div class="password-field"><input id="reset-password" type="password" name="password" required minlength="12" maxlength="72" autocomplete="new-password" data-password-input><button class="password-toggle" type="button" data-password-toggle aria-controls="reset-password" aria-label="Visibilidad de la contraseña" aria-pressed="false" hidden><span data-password-toggle-label aria-hidden="true">Mostrar</span></button></div><button type="submit">Guardar contraseña</button></form>
<% } else { %><p>El enlace no es válido.</p><a href="/forgot-password">Solicitar otro enlace</a><% } %>
</section></main><%- include('../../include/_footer') %>
