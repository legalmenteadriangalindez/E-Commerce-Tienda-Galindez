<!DOCTYPE html>
<html lang="es">
<head>
    <link rel="stylesheet" href="/css/core/theme.css">
    <link rel="stylesheet" href="/css/core/reset.css">
    <link rel="stylesheet" href="/css/core/layout.css">
    <link rel="stylesheet" href="/css/components/ui.css">
    <meta charset="UTF-8">
    <meta name="csrf-token" content="<%= csrfToken %>">
    <title>Registro</title>
    <link rel="stylesheet" href="/css/pages/register.css">
    <link rel="stylesheet" href="/css/components/password-visibility.css">
        <!-- ICONO DE LA PESTAÑA -->
    <link rel="icon" type="image/png" href="/img/favicon.png">
</head>
<body>

<div class="auth-shell">

    <!-- LADO IZQUIERDO -->
    <div class="left">
        <div class="form-box">

            <h3>Crear Cuenta</h3>

            <form action="/register" method="POST">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                <div class="input-group">
                    <span class="icon">👤</span>
                    <input type="text" name="nombre" placeholder="Nombre completo" required>
                </div>

                <div class="input-group">
                    <span class="icon">📧</span>
                    <input type="email" name="email" placeholder="Correo electrónico" required>
                </div>

                <div class="input-group">
                    <span class="icon">🔒</span>
                    <input id="register-password" type="password" name="password" minlength="12" maxlength="72" autocomplete="new-password" placeholder="Contraseña" data-password-input required>
                    <button class="password-toggle" type="button" data-password-toggle aria-controls="register-password" aria-label="Visibilidad de la contraseña" aria-pressed="false" hidden><span data-password-toggle-label aria-hidden="true">Mostrar</span></button>
                </div>

                <div class="input-group">
                    <span class="icon">📱</span>
                    <input type="text" name="telefono" placeholder="Teléfono" required>
                </div>

                <div class="input-group">
                    <span class="icon">🏠</span>
                    <input type="text" name="direccion" placeholder="Dirección" required>
                </div>

                <div class="input-group">
                    <span class="icon">📍</span>
                    <input type="text" name="barrio" placeholder="Barrio">
                </div>

                <div class="input-group">
                    <span class="icon">🗺️</span>
                    <input type="text" name="ubicacion" placeholder="Ubicación">
                </div>

                <div class="input-group">
                    <span class="icon">🏙️</span>
                    <input type="text" name="ciudad" placeholder="Ciudad">
                </div>

                <div class="input-group">
                    <span class="icon">📌</span>
                    <input type="text" name="puntoReferencia" placeholder="Punto de referencia">
                </div>

                <div class="input-group">
                    <span class="icon">⚧</span>
                    <select name="genero">
                        <option value="">Género</option>
                        <option value="Masculino">Masculino</option>
                        <option value="Femenino">Femenino</option>
                    </select>
                </div>

                <button type="submit" class="btn">Registrarse</button>

            </form>

            <p class="register">
                ¿Ya tienes cuenta?
                <a href="/login">Inicia sesión</a>
            </p>

        </div>
    </div>

    <!-- LADO DERECHO -->
    <div class="right">
        <h1>TIENDA<br>GALINDEZ</h1>

        <div class="illustration">
            <img src="/img/store.png" alt="store">
        </div>
    </div>

</div>

    <script nonce="<%= cspNonce %>" src="/js/password-visibility.js" defer></script>
</body>
</html>
