<!DOCTYPE html>
<html lang="es">
<head>
    <link rel="stylesheet" href="/css/core/theme.css">
    <link rel="stylesheet" href="/css/core/reset.css">
    <link rel="stylesheet" href="/css/core/layout.css">
    <link rel="stylesheet" href="/css/components/ui.css">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="csrf-token" content="<%= csrfToken %>">
    <title>Registro</title>
    <link rel="stylesheet" href="/css/pages/register.css">
    <link rel="stylesheet" href="/css/components/password-visibility.css">
    <link rel="stylesheet" href="/css/pages/auth-layout.css">
        <!-- ICONO DE LA PESTAÑA -->
    <link rel="icon" type="image/png" href="/img/favicon.png">
</head>
<body>

<div class="auth-shell">

    <!-- LADO IZQUIERDO -->
    <div class="left">
        <div class="form-box">

            <h3>Crear Cuenta</h3>

            <form action="/register" method="POST">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                <div class="input-group">
                    <span class="icon">👤</span>
                    <label class="auth-visually-hidden" for="register-name">Nombre completo</label>
                    <input id="register-name" type="text" name="nombre" autocomplete="name" placeholder="Nombre completo" required>
                </div>

                <div class="input-group">
                    <span class="icon">📧</span>
                    <label class="auth-visually-hidden" for="register-email">Correo electrónico</label>
                    <input id="register-email" type="email" name="email" autocomplete="email" placeholder="Correo electrónico" required>
                </div>

                <div class="input-group">
                    <span class="icon">🔒</span>
                    <label class="auth-visually-hidden" for="register-password">Contraseña</label>
                    <input id="register-password" type="password" name="password" minlength="12" maxlength="72" autocomplete="new-password" placeholder="Contraseña" data-password-input required>
                    <button class="password-toggle" type="button" data-password-toggle aria-controls="register-password" aria-label="Visibilidad de la contraseña" aria-pressed="false" hidden><span data-password-toggle-label aria-hidden="true">Mostrar</span></button>
                </div>

                <div class="input-group">
                    <span class="icon">📱</span>
                    <label class="auth-visually-hidden" for="register-phone">Teléfono</label>
                    <input id="register-phone" type="text" name="telefono" autocomplete="tel" placeholder="Teléfono" required>
                </div>

                <div class="input-group">
                    <span class="icon">🪪</span>
                    <label class="auth-visually-hidden" for="register-cedula">Cédula opcional para localizar tus compras</label>
                    <input id="register-cedula" type="text" name="cedula" placeholder="Cédula (opcional)" inputmode="numeric" pattern="[0-9]{5,15}" maxlength="15" autocomplete="off">
                </div>

                <div class="input-group">
                    <span class="icon">🏠</span>
                    <label class="auth-visually-hidden" for="register-address">Dirección</label>
                    <input id="register-address" type="text" name="direccion" autocomplete="street-address" placeholder="Dirección" required>
                </div>

                <div class="input-group">
                    <span class="icon">📍</span>
                    <label class="auth-visually-hidden" for="register-neighborhood">Barrio</label>
                    <input id="register-neighborhood" type="text" name="barrio" placeholder="Barrio">
                </div>

                <div class="input-group">
                    <span class="icon">🏙️</span>
                    <label class="auth-visually-hidden" for="register-city">Ciudad</label>
                    <input id="register-city" type="text" name="ciudad" autocomplete="address-level2" placeholder="Ciudad">
                </div>

                <div class="input-group">
                    <span class="icon">📌</span>
                    <label class="auth-visually-hidden" for="register-reference">Punto de referencia</label>
                    <input id="register-reference" type="text" name="puntoReferencia" placeholder="Punto de referencia">
                </div>

                <div class="input-group input-group--select">
                    <span class="icon">⚧</span>
                    <label class="auth-visually-hidden" for="register-gender">Género (opcional)</label>
                    <select id="register-gender" class="register-select" name="genero">
                        <option value="">Selecciona tu género (opcional)</option>
                        <option value="Masculino">Masculino</option>
                        <option value="Femenino">Femenino</option>
                        <option value="Otro">Otro</option>
                        <option value="Prefiero no decir">Prefiero no decir</option>
                    </select>
                </div>

                <button type="submit" class="btn">Registrarse</button>

            </form>

            <p class="register">
                ¿Ya tienes cuenta?
                <a href="/login">Inicia sesión</a>
            </p>

        </div>
    </div>

    <!-- LADO DERECHO -->
    <div class="right">
        <h1>TIENDA <br> GALINDEZ</h1>

        <div class="illustration">
            <img src="/img/store.png" alt="store">
        </div>
    </div>

</div>

    <script nonce="<%= cspNonce %>" src="/js/password-visibility.js" defer></script>
</body>
</html>
