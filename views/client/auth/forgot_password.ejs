<%- include('../../include/_header') %>
<main class="commerce-panel"><section class="commerce-card"><h1>Recuperar contraseña</h1>
<% if (submitted) { %><p role="status">Si el correo corresponde a una cuenta verificada y activa, recibirás un enlace. Revisa también la carpeta de correo no deseado.</p><% } else { %>
<form method="post" action="/forgot-password"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Correo electrónico<input type="email" name="email" required maxlength="254" autocomplete="email"></label><button type="submit">Enviar enlace</button></form><% } %>
<a href="/login">Volver al inicio de sesión</a></section></main><%- include('../../include/_footer') %>
