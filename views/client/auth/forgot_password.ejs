<%- include('../../include/_header') %>

<main class="password-recovery">
    <div class="password-recovery__layout">
        <section class="password-recovery__card" aria-labelledby="recovery-title">
            <div class="password-recovery__icon" aria-hidden="true">
                <i class="bi bi-envelope-lock"></i>
            </div>
            <p class="password-recovery__eyebrow">Seguridad de tu cuenta</p>
            <h1 id="recovery-title">Recupera tu contraseña</h1>
            <p class="password-recovery__description">
                Te ayudamos a recuperar el acceso a tu cuenta de Tienda Galindez.
            </p>

            <% if (submitted) { %>
                <div class="password-recovery__notice" role="status">
                    <i class="bi bi-envelope-check" aria-hidden="true"></i>
                    <div>
                        <strong>Revisa tu correo electrónico</strong>
                        <p>Si el correo corresponde a una cuenta verificada y activa, recibirás un enlace para crear una nueva contraseña.</p>
                    </div>
                </div>
                <p class="password-recovery__hint">
                    Revisa también la carpeta de correo no deseado. El enlace, cuando se envía, vence en una hora.
                </p>
                <a class="ui-button ui-button--secondary password-recovery__action" href="/forgot-password">
                    Solicitar otro enlace
                </a>
            <% } else { %>
                <form class="password-recovery__form" method="post" action="/forgot-password">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <label for="recovery-email" class="password-recovery__label">Correo electrónico</label>
                    <input
                        class="ui-input password-recovery__input"
                        id="recovery-email"
                        type="email"
                        name="email"
                        placeholder="tucorreo@ejemplo.com"
                        autocomplete="email"
                        aria-describedby="recovery-email-help"
                        maxlength="254"
                        required
                    >
                    <p class="password-recovery__hint" id="recovery-email-help">
                        Escribe el correo que utilizaste al registrarte.
                    </p>
                    <button class="ui-button ui-button--primary password-recovery__action" type="submit">
                        <i class="bi bi-send" aria-hidden="true"></i>
                        Enviar enlace de recuperación
                    </button>
                </form>
            <% } %>

            <a class="password-recovery__back" href="/login">
                <i class="bi bi-arrow-left" aria-hidden="true"></i>
                Volver a iniciar sesión
            </a>
        </section>

        <aside class="password-recovery__aside" aria-label="Consejos para proteger tu cuenta">
            <p class="password-recovery__brand">TIENDA GALINDEZ</p>
            <div class="password-recovery__shield" aria-hidden="true"><i class="bi bi-shield-lock"></i></div>
            <h2>Tu cuenta, siempre protegida.</h2>
            <p>Solo tú puedes utilizar el enlace enviado a tu correo. Nunca compartas tu enlace ni tu nueva contraseña.</p>
            <div class="password-recovery__security-note">
                <i class="bi bi-check-circle" aria-hidden="true"></i>
                Enlace de un solo uso, válido por una hora.
            </div>
        </aside>
    </div>
</main>

<%- include('../../include/_footer') %>
