<!DOCTYPE html>
<html lang="es">
<head>
    <link rel="stylesheet" href="/css/core/theme.css">
    <link rel="stylesheet" href="/css/core/reset.css">
    <link rel="stylesheet" href="/css/core/layout.css">
    <link rel="stylesheet" href="/css/components/ui.css">
    <meta charset="UTF-8">
    <meta name="csrf-token" content="<%= csrfToken %>">
    <title>Login</title>
    <link rel="stylesheet" href="/css/pages/login.css">
    <!-- ICONO DE LA PESTAÑA -->
    <link rel="icon" type="image/png" href="/img/favicon.png">
</head>
<body>

<div class="auth-shell">

    <!-- LADO IZQUIERDO -->
    <div class="left">
        <div class="form-box">

            <p class="description">
                Bienvenido a la Tienda Galindez,<br>
                aquí puedes iniciar sesión para acceder a tu cuenta y disfrutar de una experiencia de compra personalizada.
            </p>

            <h3>Iniciar Sesión</h3>

            <form action="/login" method="POST">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                <div class="input-group">
                    <span class="icon">👤</span>
                    <input type="email" name="email" placeholder="Tu Correo Electrónico" required>
                </div>

                <div class="input-group">
                    <span class="icon">🔒</span>
                    <input type="password" name="password" placeholder="Tu Contraseña" required>
                </div>

                <div class="options">
                    <label>
                        <input type="checkbox"> Recordarme
                    </label>
                    <a href="/forgot-password">¿Olvidaste tu contraseña?</a>
                </div>

                <button type="submit" class="btn">Iniciar Sesión</button>
            </form>
            <p class="register">
                ¿No tienes una cuenta?
                <a href="/register">Regístrate aquí</a>
            </p>

        </div>
    </div>

    <!-- LADO DERECHO -->
    <div class="right">
        <h1>TIENDA<br>GALINDEZ</h1>

        <div class="illustration">
            <img src="/img/store.png" alt="store">
        </div>
    </div>

</div>

<script nonce="<%= cspNonce %>" src="/js/login.js"></script>
</body>
</html>
