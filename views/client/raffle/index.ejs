<%- include('../../include/_header') %>
<link rel="stylesheet" href="/assets/css/raffle.css">

<main class="raffle-public-page">
    <% if (raffle) { %>
        <section class="raffle-public-card">
            <% if (raffle.imagenUrl) { %>
                <img src="<%= raffle.imagenUrl %>" alt="Imagen de la promoción">
            <% } %>
            <div class="raffle-public-copy">
                <p class="raffle-eyebrow"><%= raffle.activo ? 'Promoción activa' : 'Sorteo finalizado' %></p>
                <h1><%= raffle.titulo %></h1>
                <p><%= raffle.descripcion %></p>
                <p class="raffle-public-note">Ronda #<%= raffle.numeroRonda %></p>
                <strong>Compra mínima: $ <%= Number(raffle.montoMinimo).toLocaleString('es-CO') %> COP</strong>
                <% if (raffle.activo) { %>
                    <p class="raffle-public-note">Cada pedido pagado que cumpla el monto recibe una participación única.</p>
                <% } else { %>
                    <p class="raffle-public-note">Esta edición ya terminó. Consulta abajo el resultado público.</p>
                <% } %>
                <p class="raffle-transparency-stat">Participaciones registradas: <strong><%= totalEntries %></strong></p>
            </div>
        </section>

        <% if (raffle.ganador?.numero) { %>
            <section class="raffle-public-result" aria-labelledby="raffle-result-title">
                <p class="raffle-eyebrow">Resultado público</p>
                <h2 id="raffle-result-title">Número ganador: <strong>#<%= raffle.ganador.numero %></strong></h2>
                <% if (raffle.ganador.seleccionadoEn) { %>
                    <p>Seleccionado el <%= new Date(raffle.ganador.seleccionadoEn).toLocaleString('es-CO') %>.</p>
                <% } %>
                <p class="raffle-public-note">El ganador se eligió al azar entre las participaciones registradas. Para proteger la privacidad, no se publican nombres, correos ni datos del pedido.</p>
            </section>
        <% } %>

        <% if (raffle.ultimoGanador?.numero) { %>
            <section class="raffle-public-result" aria-labelledby="raffle-last-result-title">
                <p class="raffle-eyebrow">Resultado anterior</p>
                <h2 id="raffle-last-result-title">Ronda #<%= raffle.ultimoGanador.numeroRonda %>: número ganador <strong>#<%= raffle.ultimoGanador.numero %></strong></h2>
                <% if (raffle.ultimoGanador.seleccionadoEn) { %>
                    <p>Seleccionado el <%= new Date(raffle.ultimoGanador.seleccionadoEn).toLocaleString('es-CO') %>.</p>
                <% } %>
                <p class="raffle-public-note">El resultado se conserva como referencia pública aunque ya haya comenzado una nueva ronda.</p>
            </section>
        <% } %>

        <% if (user && entries.length) { %>
            <section class="commerce-card raffle-my-entries" aria-labelledby="raffle-my-entries-title">
                <div class="raffle-section-heading">
                    <div>
                        <p class="raffle-eyebrow">Tus participaciones</p>
                        <h2 id="raffle-my-entries-title">Números asignados</h2>
                    </div>
                    <span class="raffle-entry-count"><%= entries.length %></span>
                </div>

                <% if (entries.length) { %>
                    <div class="raffle-entry-grid">
                        <% entries.forEach(entry => { %>
                            <article class="raffle-entry-card <%= entry.ganador ? 'is-winner' : '' %>">
                                <div>
                                    <p class="raffle-entry-label"><%= entry.ganador ? 'Número ganador' : 'Número de participación' %> · Ronda #<%= entry.raffle?.numeroRonda || raffle.numeroRonda %></p>
                                    <strong class="raffle-entry-number">#<%= entry.numero %></strong>
                                </div>
                                <p class="raffle-entry-order">
                                    Pedido <%= entry.order?.numeroOrden || 'histórico' %><br>
                                    <%= new Date(entry.createdAt).toLocaleDateString('es-CO') %>
                                </p>
                            </article>
                        <% }) %>
                    </div>
                    <p class="raffle-public-note">Conserva estos números. Cada pedido pagado elegible recibe una sola participación.</p>
                <% } else { %>
                    <p class="raffle-public-note">Aún no tienes participaciones. Realiza un pedido pagado por el monto mínimo para recibir tu número.</p>
                <% } %>
            </section>
        <% } else if (user && raffle.activo) { %>
            <section class="commerce-card raffle-my-entries" aria-labelledby="raffle-my-entries-title">
                <div class="raffle-section-heading">
                    <div>
                        <p class="raffle-eyebrow">Tus participaciones</p>
                        <h2 id="raffle-my-entries-title">Aún no tienes números</h2>
                    </div>
                </div>
                <p class="raffle-public-note">Realiza un pedido pagado por el monto mínimo para recibir tu número de participación.</p>
            </section>
        <% } else if (!user && raffle.activo) { %>
            <p class="raffle-login-note">Inicia sesión para consultar tus números de participación.</p>
        <% } %>
    <% } else { %>
        <section class="commerce-card">
            <h1>No hay una rifa activa</h1>
            <p>Vuelve pronto para conocer la próxima promoción.</p>
        </section>
    <% } %>
</main>
<%- include('../../include/_footer') %>
