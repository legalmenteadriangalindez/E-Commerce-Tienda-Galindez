<%- include('../../include/_header') %>


<div class="checkout-wrapper">
    <div class="checkout-header">
        <h1><i class="fas fa-store"></i> Finaliza tu pedido</h1>
        <div class="badge-secure"><i class="fas fa-lock"></i> Wompi o efectivo contra entrega</div>
    </div>

    <form action="/carrito/checkout" method="POST">
        <input type="hidden" name="claveCheckout" value="<%= claveCheckout %>">
        <input type="hidden" name="totalCotizado" value="<%= total %>">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="cliente" value="<%= user._id %>">

        <div class="checkout-grid">
            <div class="form-card ui-card">
                <div class="section-title"><i class="fas fa-user-pen"></i><span>Información de facturación</span></div>

                <div class="input-group">
                    <label>Nombre completo</label>
                    <input type="text" id="fullName" name="fullName" value="<%= locals.user?.nombre || '' %>" required>
                </div>

                <div class="input-row">
                    <div class="input-group">
                        <label>Correo electrónico</label>
                        <input type="email" id="email" name="email" value="<%= locals.user?.email || '' %>" required>
                    </div>
                    <div class="input-group">
                        <label>Teléfono</label>
                        <input type="tel" id="phone" name="phone" value="<%= locals.user?.telefono || '' %>" required>
                    </div>
                </div>

                <div class="input-group">
                    <label>Dirección</label>
                    <input type="text" id="address" name="address" value="<%= locals.user?.direccion || '' %>" required>
                </div>

                <div class="input-row">
                    <div class="input-group">
                        <label>Departamento</label>
                        <input type="text" id="department" name="department" placeholder="Departamento" value="cauca" required>
                    </div>
                    <div class="input-group">
                        <label>Ciudad</label>
                        <input type="text" id="city" name="city" value="<%= locals.user?.ciudad || '' %>" required>
                    </div>
                </div>

                <div class="input-row">
                    <div class="input-group">
                        <label>Referencia</label>
                        <input type="text" id="reference" name="reference" placeholder="Apartamento, torre, referencia...">
                    </div>
                </div>

                <div class="input-group">
                    <label>Notas</label>
                    <textarea id="notes" name="notes" rows="4" placeholder="Notas adicionales para la entrega..."></textarea>
                </div>

                <div class="payment-methods">
                    <div class="section-title section-title-spaced"><i class="fas fa-credit-card"></i><span>Método de pago</span></div>
                    <fieldset class="payment-options">
                        <legend>Elige cómo pagar</legend>
                        <% paymentMethods.forEach((method, index) => { %>
                            <label class="payment-option">
                                <input type="radio" name="metodoPago" value="<%= method.value %>" <%= index === 0 ? 'checked' : '' %> required>
                                <span><strong><%= method.label %></strong><small><%= method.description %></small></span>
                            </label>
                        <% }) %>
                    </fieldset>
                    <div class="payment-wompi-info payment-security">
                        <i class="fas fa-shield-halved payment-security-icon"></i>
                        <h3>Tarjetas y Nequi con Wompi</h3>
                        <p>Al confirmar tu pedido serás redirigido a la plataforma segura de Wompi para completar tu pago.</p>
                        <p>La disponibilidad final de tarjeta o Nequi depende de los medios habilitados en tu cuenta Wompi.</p>
                        <p>Si eliges efectivo contra entrega, no serás enviado a Wompi: pagarás al recibir y el repartidor confirmará la entrega.</p>
                    </div>
                </div>

                <div class="trust-badge">
                    <span><i class="fas fa-shield-alt"></i> Pago seguro</span>
                    <span><i class="fas fa-lock"></i> Datos protegidos</span>
                    <span><i class="fas fa-check-circle"></i> Wompi</span>
                </div>
            </div>

            <%- include('./partials/order-summary', {
                productosCarrito,
                subtotal,
                costoEnvio,
                total,
                subtotalCents,
                shippingPriceCents,
                freeShippingFromCents
            }) %>
        </div>
    </form>
</div>

<%- include('../../include/_footer') %>
