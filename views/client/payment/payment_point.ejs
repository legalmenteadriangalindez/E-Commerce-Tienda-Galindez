<%- include('../../include/_header') %>

<div class="checkout-wrapper">
    <div class="checkout-header">
        <h1>
            <i class="fas fa-store"></i>
            Punto de Pago Seguro
        </h1>

        <div class="badge-secure">
            <i class="fas fa-lock"></i>
            Pago seguro y protegido por Wompi
        </div>
    </div>

    <form action="/carrito/checkout" method="POST">
        <input type="hidden" name="cliente" value="<%= user._id %>">

        <div class="checkout-grid">
            <div class="form-card">
                <div class="section-title">
                    <i class="fas fa-user-pen"></i>
                    <span>Información de facturación</span>
                </div>

                <div class="input-group">
                    <label>Nombre completo</label>
                    <input
                        type="text"
                        id="fullName"
                        name="fullName"
                        value="<%= locals.user?.nombre || '' %>"
                        required
                    >
                </div>

                <div class="input-row">
                    <div class="input-group">
                        <label>Correo electrónico</label>
                        <input
                            type="email"
                            id="email"
                            name="email"
                            value="<%= locals.user?.email || '' %>"
                            required
                        >
                    </div>

                    <div class="input-group">
                        <label>Teléfono</label>
                        <input
                            type="tel"
                            id="phone"
                            name="phone"
                            value="<%= locals.user?.telefono || '' %>"
                            required
                        >
                    </div>
                </div>

                <div class="input-group">
                    <label>Dirección</label>
                    <input
                        type="text"
                        id="address"
                        name="address"
                        value="<%= locals.user?.direccion || '' %>"
                        required
                    >
                </div>

                <div class="input-row">
                    <div class="input-group">
                        <label>Departamento</label>
                        <input
                            type="text"
                            id="department"
                            name="department"
                            placeholder="Departamento"
                            value="cauca"
                            required
                        >
                    </div>

                    <div class="input-group">
                        <label>Ciudad</label>
                        <input
                            type="text"
                            id="city"
                            name="city"
                            value="<%= locals.user?.ciudad || '' %>"
                            required
                        >
                    </div>
                </div>

                <div class="input-row">
                    <div class="input-group">
                        <label>Referencia</label>
                        <input
                            type="text"
                            id="reference"
                            name="reference"
                            placeholder="Apartamento, torre, referencia..."
                        >
                    </div>
                </div>

                <div class="input-group">
                    <label>Notas</label>
                    <textarea
                        id="notes"
                        name="notes"
                        rows="4"
                        placeholder="Notas adicionales para la entrega..."
                    ></textarea>
                </div>

                <div class="payment-methods">
                    <div class="section-title" style="margin-bottom: 1rem;">
                        <i class="fas fa-credit-card"></i>
                        <span>Método de pago</span>
                    </div>

                    <div
                        class="payment-wompi-info"
                        style="padding: 20px; border-radius: 12px; background: #f8fafc; text-align: center;"
                    >
                        <i class="fas fa-shield-halved" style="font-size: 2.5rem;"></i>

                        <h3>Pago seguro con Wompi</h3>

                        <p>
                            Al confirmar tu pedido serás redirigido a la plataforma
                            segura de Wompi para completar tu pago.
                        </p>

                        <p>
                            Allí podrás seleccionar el método de pago disponible
                            para tu compra.
                        </p>
                    </div>
                </div>

                <div class="trust-badge">
                    <span>
                        <i class="fas fa-shield-alt"></i>
                        Pago seguro
                    </span>

                    <span>
                        <i class="fas fa-lock"></i>
                        Datos protegidos
                    </span>

                    <span>
                        <i class="fas fa-check-circle"></i>
                        Wompi
                    </span>
                </div>
            </div>

            <div class="summary-card">
                <div class="section-title">
                    <i class="fas fa-bag-shopping"></i>
                    <span>Tu pedido</span>
                </div>

                <div class="order-items-list text-sumary">
                    <% productosCarrito.forEach(item => { %>
                        <div class="order-item">
                            <div class="item-icon">
                                <i class="fas fa-box"></i>
                            </div>

                            <div class="item-details">
                                <div class="item-title">
                                    <%= item.nombre %>
                                </div>

                                <div class="item-price">
                                    $<%= Number(item.precio).toLocaleString('es-CO') %>
                                </div>

                                <div class="item-quantity">
                                    Cantidad: <%= item.cantidad %>
                                </div>
                            </div>

                            <div class="item-line-price">
                                $<%= Number(
                                    item.precio * item.cantidad
                                ).toLocaleString('es-CO') %>
                            </div>
                        </div>
                    <% }) %>
                </div>

                <div class="divider"></div>

                <div class="summary-line text-sumary">
                    <span>Subtotal</span>
                    <span>
                        $<%= Number(subtotal).toLocaleString('es-CO') %>
                    </span>
                </div>

                <div class="summary-line text-sumary">
                    <span>Envío</span>
                    <span>
                        $<%= (subtotal >= 30000 ? 0 : 5000).toLocaleString('es-CO') %>
                    </span>
                </div>

                <div class="summary-line text-sumary">
                    <span>Impuestos</span>
                    <span>
                        $<%= Number(subtotal).toLocaleString('es-CO') %>
                    </span>
                </div>

                <div class="summary-line total text-sumary">
                    <span>Total a pagar</span>
                    <span>
                        $<%= Number(
                            subtotal >= 30000
                                ? subtotal
                                : subtotal + 5000
                        ).toLocaleString('es-CO') %>
                    </span>
                </div>

                <button type="submit" class="pay-btn">
                    <i class="fas fa-lock"></i>
                    Continuar al pago con Wompi
                </button>

                <div
                    class="trust-badge"
                    style="justify-content: space-between; margin-top: 18px;"
                >
                    <span>
                        <i class="fas fa-shield-alt"></i>
                        Pago seguro
                    </span>

                    <span>
                        <i class="fas fa-lock"></i>
                        Encriptado
                    </span>

                    <span>
                        <i class="fas fa-credit-card"></i>
                        Wompi
                    </span>
                </div>
            </div>
        </div>
    </form>
</div>

<%- include('../../include/_footer') %>