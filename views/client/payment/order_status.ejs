<%- include('../../include/_header') %>
<main class="commerce-panel">
  <a href="/mis-pedidos">← Mis pedidos</a>
  <h1>Estado de tu pedido</h1>
  <p><%= order.numeroOrden %></p>
  <% if (notice) { %><p role="status" class="commerce-notice"><%= notice %></p><% } %>
  <article class="commerce-card">
    <p>Pago: <strong><%= order.estadoPago %></strong></p>
    <p>Pedido: <strong><%= order.estado %></strong></p>
    <% if (order.estado === 'REQUIERE_REVISION') { %>
      <p>Recibimos la confirmación del pago y estamos revisando la disponibilidad. Contacta con la tienda indicando tu número de pedido. No vuelvas a pagar.</p>
    <% } else if (order.estadoPago === 'PAGADO') { %><p>Tu pago está confirmado. Aquí podrás consultar el avance de la entrega.</p>
    <% } else if (order.estado === 'CANCELADA') { %><p>Este intento de compra terminó. Si tu banco muestra un cobro, contacta con la tienda antes de repetirlo.</p>
    <% } else { %><p>El pedido todavía no tiene un pago confirmado. Si acabas de pagar, espera la confirmación antes de reintentar.</p><% } %>
    <a href="">Actualizar estado</a>
    <% if (!hasPaymentPending && order.canal === 'WOMPI' && order.estadoPago === 'PENDIENTE' && order.inventario === 'RESERVADO' && order.reservaHasta > new Date()) { %>
      <form method="post" action="/carrito/pay/<%= order._id %>">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button type="submit">Continuar al pago</button>
      </form>
    <% } %>
  </article>
  <article class="commerce-card">
    <h2>Resumen</h2>
    <% order.productos.forEach(item => { %><p><%= item.nombre %> × <%= item.cantidad %> — $<%= item.subtotal.toLocaleString('es-CO') %></p><% }) %>
    <p>Envío: $<%= order.costoEnvio.toLocaleString('es-CO') %></p>
    <p><strong>Total: $<%= order.total.toLocaleString('es-CO') %> COP</strong></p>
    <p>Entrega: <%= order.direccionEnvio?.direccion || '' %>, <%= order.direccionEnvio?.ciudad || '' %></p>
  </article>
</main>
<%- include('../../include/_footer') %>
